---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// `image.aspect: 'auto'` shows the picture whole (transparent illustrations);
// the default crops it to the hero frame.
const { aspect: imageAspect, ...imageProps } =
  typeof image === 'object' && image ? image : { src: '', alt: '' };
const imageWhole = imageAspect === 'auto';
---

<section class="not-prose relative md:-mt-[76px]" {...id ? { id } : {}}>
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="pointer-events-none pt-0 md:pt-[76px]"></div>
    <div
      class="py-12 md:py-20 lg:flex lg:min-h-[calc(100vh-5rem)] lg:items-center lg:gap-8 lg:py-16"
    >
      <div class="mx-auto basis-1/2 pb-10 text-center md:pb-16 lg:text-left">
        {
          badge && (
            <span class="border-primary/30 bg-primary/10 text-primary dark:bg-primary/25 intersect-once intersect-quarter motion-safe:md:intersect:animate-fade mb-4 inline-block rounded-full border px-3 py-1 text-xs font-semibold tracking-wide uppercase motion-safe:md:opacity-0 dark:text-blue-200">
              {badge}
            </span>
          )
        }
        {
          tagline && (
            <p
              class="text-secondary intersect-once motion-safe:md:intersect:animate-fade intersect-quarter text-base font-bold tracking-wide uppercase motion-safe:md:opacity-0 dark:text-blue-200"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="leading-tighter font-heading text-heading intersect-once motion-safe:md:intersect:animate-fade intersect-quarter mb-4 text-5xl font-bold tracking-tighter md:text-6xl motion-safe:md:opacity-0"
              set:html={title}
            />
          )
        }
        <div class="mx-auto max-w-3xl lg:max-w-none">
          {
            subtitle && (
              <p
                class="text-muted intersect-once motion-safe:md:intersect:animate-fade intersect-quarter mb-6 text-xl motion-safe:md:opacity-0 dark:text-slate-300"
                set:html={subtitle}
              />
            )
          }

          {
            actions && (
              <div class="intersect-once motion-safe:md:intersect:animate-fade intersect-quarter m-auto flex max-w-xs flex-col flex-nowrap gap-4 sm:max-w-md sm:flex-row sm:justify-center motion-safe:md:opacity-0 lg:m-0 lg:max-w-7xl lg:justify-start">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      <div class="basis-1/2">
        {
          image && (
            <div class="intersect-once intersect-no-queue motion-safe:md:intersect:animate-fade intersect-quarter relative m-auto max-w-5xl motion-safe:md:opacity-0">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class:list={[
                    'mx-auto',
                    imageWhole
                      ? 'max-h-[32rem] w-auto object-contain md:max-h-[44rem]'
                      : 'w-full rounded-md',
                  ]}
                  widths={[400, 768, 1024, 2040]}
                  sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                  loading="eager"
                  fetchpriority="high"
                  {...(imageWhole
                    ? { inferSize: true, layout: 'none' }
                    : { width: 600, height: 600 })}
                  format="webp"
                  {...imageProps}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
