---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses SiteHeader + SiteFooter with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '~/components/layout/SiteHeader.astro';
import SiteFooter from '~/components/layout/SiteFooter.astro';
import EnquiryDialog from '~/components/patterns/EnquiryDialog.astro';
import type { ImagePreload } from '~/components/ui/overlay/Carousel/posters';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Article metadata for OG/Twitter card output on blog posts */
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  /** Preload hint for the page's LCP image; see BaseLayout. */
  lcpPreload?: ImagePreload;
  /**
   * Render the popup enquiry form, so any CTA on the page can open it. Pages
   * that already embed the inline enquiry form set this to `false`: their
   * triggers fall back to their `href` and navigate to the form instead.
   */
  enquiryDialog?: boolean;
  /**
   * Let the dialog open itself once the visitor is engaged (`minDwell` +
   * scroll depth or desktop exit intent, suppressed after a dismissal and never
   * after an enquiry). Pages where an interruption would be inappropriate — the
   * privacy policy, the 404 — set this to `false` and keep the CTA triggers.
   */
  enquiryDialogAutoOpen?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex,
  nofollow,
  lcpPreload,
  enquiryDialog = true,
  enquiryDialogAutoOpen = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  article={article}
  noindex={noindex}
  nofollow={nofollow}
  lcpPreload={lcpPreload}
>
  <SiteHeader slot="header" />

  <!-- BaseLayout owns the single <main> landmark and the skip-link target.
       `min-h-dvh` rather than `min-h-screen`: on iOS Safari `vh` is the
       viewport with its chrome retracted, so a full-height page grows a dead
       band under the browser UI and the page bounces on load. `dvh` tracks the
       real visible height. -->
  <div class="min-h-dvh">
    <slot />
  </div>

  {enquiryDialog && <EnquiryDialog autoOpen={enquiryDialogAutoOpen} />}

  <SiteFooter slot="footer" />
</BaseLayout>
