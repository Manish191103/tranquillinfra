---
/**
 * Project page — one route per `projects` entry (`/projects/<slug>/`)
 *
 * The page assembles the section components from the `projects` content
 * entry (editorial copy, images, FAQ) and `project.config.ts` (the published
 * statics: plot sizes, total plots, site area, approval references).
 * Structured data: BreadcrumbList (from Breadcrumbs), the project listing
 * graph (RealEstateListing, its Offer, the GatedResidenceCommunity Place and
 * the RERA/HMDA identifiers), a VideoObject per testimonial clip, and FAQPage.
 *
 * The FAQPage node is kept for machine understanding and AI answer extraction,
 * not for a rich result — Google withdrew the FAQ rich result for all
 * publishers, so it buys nothing in the SERP. Its answers are disclosure-first
 * ("what is not published", "how do I verify this") and must stay that way:
 * FAQPage must never carry promotional copy. The same node states the
 * approved-layout / renders-not-photographs / no-possession-date disclosure
 * through the listing's `disambiguatingDescription` and the Place's "Current
 * development stage" entry, so a summary of the graph cannot imply otherwise.
 *
 * Hero: the illustrative aerial of the planned layout opens the page in the
 * shared ImageHero frame — breadcrumbs on the frame's top row, the copy and
 * the two intent actions over a bottom-weighted scrim, the background clip
 * over the frame-0 still, and the stats belt as the scroll cue's target
 * (docs/project-imagery-plan.md, docs/hero-swap-plan.md). The layout section
 * carries the delivered plotting plan.
 *
 * Testimonials: buyer video clips and quotes render between the location and
 * facts sections, and only when the entry carries consented items (see
 * ProjectTestimonials and docs/project-testimonials-plan.md).
 */
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/seo/Breadcrumbs.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import ProjectHero from '~/components/projects/ProjectHero.astro';
import ProjectStats from '~/components/projects/ProjectStats.astro';
import ProjectStory from '~/components/projects/ProjectStory.astro';
import ProjectPlan from '~/components/projects/ProjectPlan.astro';
import ProjectAmenities from '~/components/projects/ProjectAmenities.astro';
import ProjectLocation from '~/components/projects/ProjectLocation.astro';
import ProjectTestimonials from '~/components/projects/ProjectTestimonials.astro';
import FactsSection from '~/components/patterns/FactsSection.astro';
import FaqSection from '~/components/patterns/FaqSection.astro';
import ProjectEnquiry from '~/components/projects/ProjectEnquiry.astro';
import projectConfig, { projectFacts, projectStats } from '~/config/project.config';
import { canonicalUrl } from '~/lib/canonical';
import siteConfig from '~/config/site.config';
import { createFAQSchema, createProjectSchema, createVideoSchema } from '~/lib/schema';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const data = project.data;

// Two levels only: Breadcrumbs.astro keeps one URL per trail level, and the
// /projects/ root is a redirect to this page (docs/project-slug-routes-plan.md).
const breadcrumbs = [{ label: 'Home', href: '/' }, { label: data.displayTitle }];

const stats = projectStats();

// Statutory and price rows come from config; the editorial rows from the entry.
const facts = projectFacts({
  location: data.location,
  layout: data.layout,
  verificationNote: data.verificationNote,
});

// `projectStats()` publishes the total parcel count, which on its own reads as
// "82 plots for sale". Both halves of the inventory belong on the page, so the
// saleable figure is stated here from the same config the Offer node uses.
const { availability } = projectConfig;
const saleableFact = {
  label: 'Plots available',
  value: `${availability.saleable} saleable of ${availability.total} (${availability.mortgageHeld} held under HMDA Mortgage conditions)`,
};

const siteUrl = Astro.site ?? new URL('https://www.tranquillinfra.com');
const projectUrl = canonicalUrl(`/projects/${project.id}/`, siteConfig.url);

const projectSchema = createProjectSchema({
  name: data.displayTitle,
  description: data.description,
  url: projectUrl,
  // The advertised features are published in the entry; the listing carries the
  // same names so the two cannot drift.
  amenities: data.amenities.groups.flatMap((group) => group.items.map((item) => item.name)),
  // The published total, from the same config the facts table renders, so the
  // graph can state the layout's area without the copy restating it.
  siteArea: projectConfig.siteArea,
  // First publication, not last review: a copy edit must not re-date the
  // listing. `publishedAt` is optional on the entry, and an entry without it
  // emits no date at all rather than a wrong one.
  datePosted: data.publishedAt,
  dateModified: data.updatedAt,
});

// VideoObject nodes for the buyer testimonial clips only.
//
// The hero background clip is deliberately not marked up: it is a muted loop
// behind a scrim, not the page's main content video, and it carries no
// duration, so a VideoObject would describe something the visitor cannot watch
// as a video. The testimonial clips are real, consent-recorded footage a
// buyer can play, so they stay.
const videoSchemas = (data.testimonials?.items ?? [])
  .filter((item) => item.video)
  .map((item) =>
    createVideoSchema({
      name: item.quote
        ? `${data.displayTitle} buyer testimonial`
        : `${data.displayTitle} buyer testimonial (${item.id})`,
      description:
        item.quote ??
        item.context ??
        `A buyer describes their experience with ${data.displayTitle}, recorded at the site.`,
      contentUrl: new URL(item.video!.src, siteUrl).toString(),
      thumbnailUrl: new URL(item.video!.poster.src, siteUrl).toString(),
      // The date the signed release was filed, which is the only real answer
      // for when a clip went up. No release record means no `uploadDate`: an
      // omitted field is honest, a fallback to `updatedAt` is not.
      uploadDate: item.consentRecordedAt,
      durationClock: item.video!.duration,
    })
  );
---

<PageLayout title={data.title} description={data.description} enquiryDialog={false}>
  <ProjectHero
    eyebrow={data.projectType}
    title={data.title}
    location={data.location}
    intro={data.intro}
    hero={data.hero}
  >
    <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} tone="invert" />
  </ProjectHero>

  <ProjectStats stats={stats} />

  <ProjectStory
    eyebrow={data.story.eyebrow}
    title={data.story.title}
    intro={data.story.intro}
    note={data.story.note}
    images={data.story.images}
    Content={Content}
  />

  <ProjectPlan
    eyebrow={data.plan.eyebrow}
    title={data.plan.title}
    intro={data.plan.intro}
    plan={data.plan}
  />

  <ProjectAmenities
    eyebrow={data.amenities.eyebrow}
    title={data.amenities.title}
    intro={data.amenities.intro}
    note={data.amenities.note}
    groups={data.amenities.groups}
  />

  <ProjectLocation
    eyebrow={data.locationSection.eyebrow}
    title={data.locationSection.title}
    intro={data.locationSection.intro}
    note={data.locationSection.note}
    groups={data.locationSection.groups}
    directionsUrl={data.directionsUrl}
    coordinates={data.coordinates}
  />

  {data.testimonials && data.testimonials.items.length > 0 && (
    <ProjectTestimonials
      eyebrow={data.testimonials.eyebrow}
      title={data.testimonials.title}
      intro={data.testimonials.intro}
      note={data.testimonials.note}
      items={data.testimonials.items}
    />
  )}

  <FactsSection
    id="project-facts"
    eyebrow={data.facts.eyebrow}
    title={data.facts.title}
    intro={data.facts.intro}
    facts={[...facts, saleableFact]}
  />

  <FaqSection
    id="project-faq"
    eyebrow={data.faq.eyebrow}
    title={data.faq.title}
    intro={data.faq.intro}
    items={data.faq.items}
  />

  <ProjectEnquiry
    eyebrow={data.enquiry.eyebrow}
    title={data.enquiry.title}
    intro={data.enquiry.intro}
  />

  <JsonLd schema={projectSchema} />
  {videoSchemas.length > 0 && <JsonLd schema={videoSchemas} />}
  <JsonLd schema={createFAQSchema(data.faq.items)} />
</PageLayout>
