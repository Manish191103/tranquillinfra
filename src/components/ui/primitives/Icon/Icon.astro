const brandIcons = [
  'brand-astro',
  'brand-tailwind',
  'brand-typescript',
  'brand-react',
  'brand-whatsapp',
  'brand-instagram',
];

const iconPath = icons[name as keyof typeof icons] || icons['x'];
const isBrand = brandIcons.includes(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? 'none' : 'currentColor'}
  stroke-width={isBrand ? 0 : resolvedStrokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cn(sizes[size], 'shrink-0', className)}
  aria-hidden="true"
>
  {isBrand ? (
    <path d={iconPath} />
  ) : (
    iconPath
      .split('M')
      .filter(Boolean)
      .map((d) => <path d={`M${d}`} />)
  )}
</svg>
