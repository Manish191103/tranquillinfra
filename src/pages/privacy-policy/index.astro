---
/**
 * Privacy policy
 *
 * Rendered from `src/content/pages/privacy-policy.md` so the copy can be
 * reviewed as content. Update the `updatedAt` field and the "Last updated" line
 * together when the policy changes.
 */
import { getEntry, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/seo/Breadcrumbs.astro';
import Prose from '~/components/patterns/Prose.astro';

const entry = await getEntry('pages', 'privacy-policy');
if (!entry) {
  throw new Error('Missing required pages entry "privacy-policy".');
}

const { Content } = await render(entry);
const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Privacy policy' }];
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  enquiryDialogAutoOpen={false}
>
  <div class="mx-auto max-w-6xl px-6 pt-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <article class="mx-auto max-w-3xl px-6 py-12 md:py-20">
    <Prose>
      <Content />
    </Prose>
  </article>
</PageLayout>
