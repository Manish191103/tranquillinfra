---
/**
 * EnquiryDialog
 *
 * The popup enquiry form: the same submission pipeline as the inline contact
 * form (`bindLeadForm` → Formspree → the customer mail), opened from any CTA
 * carrying `data-dialog-trigger="<id>"`. Rendered once per page; every id is
 * derived from `id`, so a page can hold other lead forms without the two
 * wiring each other's fields.
 *
 * The markup stays a plain `action` + `method="POST"` form: without JavaScript
 * the dialog never appears and a trigger navigates to the contact form instead.
 * The element itself is a native `<dialog>` — Escape, focus containment and
 * the backdrop click come from the platform; this component adds the scroll
 * lock (`html[data-scroll-lock]`, shared with the mobile menu), the trigger
 * delegation, the visit-date sync and the view-transition re-init.
 */
import {
  ENQUIRY_SUCCESS_MESSAGE,
  PHONE_CTA_LABEL,
  PHONE_INPUT_PATTERN,
  PHONE_INPUT_TITLE,
  REQUEST_TYPE_OPTIONS,
  SITE_VISIT_CTA_LABEL,
  WHATSAPP_CTA_LABEL,
  type EnquiryRequestType,
} from '~/lib/enquiry-cta';
import { contact } from '~/contact';
import { Icon } from 'astro-icon/components';

interface Props {
  /** Element id; the form, button and status line ids derive from it. */
  id?: string;
  title?: string;
  description?: string;
  /** Overrides the env-configured Formspree form (one form per surface). */
  action?: string;
  /** Formspree discriminator: which surface the lead arrived from. */
  formType?: string;
  /** Request type the select starts on; triggers can override it per click. */
  defaultRequestType?: EnquiryRequestType;
  submitLabel?: string;
  successMessage?: string;
  class?: string;
}

const {
  id = 'enquiry-dialog',
  title = SITE_VISIT_CTA_LABEL,
  description = 'Pick the day you want to see the layout — we confirm the slot by phone within business hours.',
  action = `https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_FORM_ID}`,
  formType = 'Enquiry dialog',
  defaultRequestType = 'site_visit',
  submitLabel = SITE_VISIT_CTA_LABEL,
  successMessage = ENQUIRY_SUCCESS_MESSAGE,
  class: className,
} = Astro.props;

// The failure state has to reach the team without this form: a visitor whose
// message never left the browser still has a phone.
const telHref = contact.phoneE164 ? `tel:${contact.phoneE164}` : undefined;
---

<dialog
  id={id}
  class:list={[
    // Above any fixed chrome (header, mobile contact bar). `open` styling is
    // not needed: `showModal()` alone makes the element visible.
    'z-70 m-auto w-[min(40rem,calc(100%-2rem))] rounded-xl border border-border bg-card p-0 text-default shadow-xl backdrop:bg-black/50 backdrop:backdrop-blur-sm',
    className,
  ]}
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-description`}
>
  <div class="p-6 sm:p-8">
    <!-- Close button. Escape works natively; this is the pointer route. -->
    <button
      type="button"
      class="text-muted hover:text-heading absolute top-4 right-4 rounded-md p-1 transition-colors focus-visible:ring-2 focus-visible:outline-none"
      data-dialog-close
      aria-label="Close dialog"
    >
      <Icon name="tabler:x" class="h-5 w-5" aria-hidden="true" />
    </button>

    <header class="mb-6 pr-8">
      <h2 id={`${id}-title`} class="font-display text-heading text-2xl font-semibold">
        {title}
      </h2>
      <p id={`${id}-description`} class="text-muted mt-1 text-sm">
        {description}
      </p>
    </header>

    <form
      id={`${id}-form`}
      action={action}
      method="POST"
      class="stack gap-5"
      data-success-message={successMessage}
      data-enquiry-dialog={id}
      data-default-request-type={defaultRequestType}
    >
      <label class="block">
        <span class="text-sm font-medium">Name</span>
        <input
          type="text"
          name="name"
          required
          maxlength="100"
          autocomplete="name"
          class="border-border bg-page mt-1 w-full rounded-md border px-3 py-2 text-sm focus-visible:ring-2 focus-visible:outline-none"
          autofocus
        />
      </label>

      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Phone</span>
          <input
            type="tel"
            name="phone"
            required
            maxlength="20"
            inputmode="tel"
            pattern={PHONE_INPUT_PATTERN}
            title={PHONE_INPUT_TITLE}
            autocomplete="tel"
            class="border-border bg-page mt-1 w-full rounded-md border px-3 py-2 text-sm focus-visible:ring-2 focus-visible:outline-none"
          />
          <span class="text-muted mt-1 block text-xs">We call back during business hours.</span>
        </label>

        <label class="block">
          <span class="text-sm font-medium">Email</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="border-border bg-page mt-1 w-full rounded-md border px-3 py-2 text-sm focus-visible:ring-2 focus-visible:outline-none"
          />
        </label>
      </div>

      <label class="block">
        <span class="text-sm font-medium">I would like to</span>
        <select
          name="request_type"
          class="border-border bg-page mt-1 w-full rounded-md border px-3 py-2 text-sm focus-visible:ring-2 focus-visible:outline-none"
        >
          {REQUEST_TYPE_OPTIONS.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
        <span class="text-muted mt-1 block text-xs">
          Pick the brochure instead and we will only send the PDF — no date needed.
        </span>
      </label>

      <!-- The visit date is the promise the CTA makes, so it is required for a
           site visit. The script shows, requires and clears it with the request
           type, and sets `min` to today: the pages are static, so a build-time
           "today" would freeze the earliest bookable day on the build day. -->
      <div data-visit-date-field>
        <label class="block">
          <span class="text-sm font-medium">Preferred visit date</span>
          <input
            type="date"
            name="visit_date"
            required
            class="border-border bg-page mt-1 w-full rounded-md border px-3 py-2 text-sm focus-visible:ring-2 focus-visible:outline-none"
          />
          <span class="text-muted mt-1 block text-xs">
            We confirm the slot by phone; weekends are usually the busiest.
          </span>
        </label>
      </div>

      <label class="block">
        <span class="text-sm font-medium">Anything we should know?</span>
        <textarea
          name="message"
          maxlength="5000"
          rows="4"
          class="border-border bg-page mt-1 w-full rounded-md border px-3 py-2 text-sm focus-visible:ring-2 focus-visible:outline-none"
        ></textarea>
        <span class="text-muted mt-1 block text-xs">
          Optional — plot size, budget, or a time that suits you.
        </span>
      </label>

      <!-- Formspree reads `subject` as the notification subject; the script
           composes it from the request type (the static value covers a submission
           without JS). -->
      <input type="hidden" name="subject" value="New website enquiry" />
      <input type="hidden" name="form_type" value={formType} />

      <!-- Honeypot field for spam protection -->
      <div class="hidden" aria-hidden="true">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </div>

      <p id={`${id}-message`} class="text-sm" role="status" aria-live="polite" tabindex="-1"></p>

      <!-- The status line says what went wrong; this says where to go instead. A
           rejected POST is the one failure the visitor cannot retry their way out
           of, so the two channels that do not depend on this form are one tap away. -->
      <div data-lead-fallback hidden class="space-y-2 rounded-md border border-border p-3 text-sm">
        <p class="text-heading font-semibold">That did not reach us. Reach the sales desk directly:</p>
        <ul class="space-y-1">
          {telHref && (
            <li>
              <a href={telHref} data-track="phone" class="underline underline-offset-2">
                {PHONE_CTA_LABEL}: {contact.phone}
              </a>
            </li>
          )}
          <li>
            <a
              href={contact.whatsapp}
              data-track="whatsapp"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2"
            >
              {WHATSAPP_CTA_LABEL}
            </a>
          </li>
        </ul>
      </div>

      <div class="space-y-3">
        <button
          type="submit"
          id={`${id}-submit`}
          class="cta cta-primary w-full justify-center"
        >
          <span class="cta-label">{submitLabel}</span>
        </button>

        <p class="text-muted text-xs">
          We only use your details to answer this enquiry. See our{' '}
          <a
            class="underline underline-offset-2"
            href={String(import.meta.env.PUBLIC_PRIVACY_POLICY_URL ?? '/privacy-policy/')}
          >
            privacy policy
          </a>.
        </p>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { initAnalytics } from '~/lib/analytics';
  import { bindLeadForm, enquirySubject } from '~/lib/leads';

  /**
   * Measurement self-initialises from this script: it is the one component
   * script the lead pipeline ships, so the delegated `data-track` listener,
   * the first-touch capture and the pixel load all arm here. (If the dialog is
   * ever rendered on fewer than all pages, move this call to the layout.)
   */
  initAnalytics();

  /** Today's date in the visitor's own zone, as the `min` of the date input. */
  function todayIso(): string {
    const now = new Date();
    return new Date(now.getTime() - now.getTimezoneOffset() * 60_000).toISOString().slice(0, 10);
  }

  let submitted = false;

  function initEnquiryDialogForms() {
    // The dialog element's own behavior (close routes, scroll lock release) is
    // wired once per element, before the per-form guard below — a re-init pass
    // after a view-transition swap must still wire a freshly swapped dialog.
    document
      .querySelectorAll<HTMLDialogElement>('dialog:has(form[data-enquiry-dialog])')
      .forEach(wireDialog);

    document.querySelectorAll<HTMLFormElement>('form[data-enquiry-dialog]').forEach((form) => {
      // The binder marks the form it owns; a second pass changes nothing.
      if (form.dataset.leadFormInit === 'true') return;

      const id = form.dataset.enquiryDialog as string;
      const button = document.getElementById(`${id}-submit`) as HTMLButtonElement | null;
      const message = document.getElementById(`${id}-message`) as HTMLElement | null;
      if (!button || !message) return;

      // The default is server-rendered as a data attribute (a `<select>` value
      // cannot be), and a trigger's `data-dialog-request-type` overrides it when
      // the dialog opens.
      const select = form.querySelector<HTMLSelectElement>('select[name="request_type"]');
      if (select && form.dataset.defaultRequestType) select.value = form.dataset.defaultRequestType;

      const visitDateField = form.querySelector<HTMLElement>('[data-visit-date-field]');
      const visitDate = form.querySelector<HTMLInputElement>('input[name="visit_date"]');
      const fallback = form.querySelector<HTMLElement>('[data-lead-fallback]');

      // The date is required for a visit and irrelevant for anything else: a
      // brochure request must not be blocked on a date nobody wants to give.
      // A date already in the field wins over the control, because a visitor
      // who has picked a day has asked for a visit whatever they last selected.
      const syncVisitDate = () => {
        if (!visitDateField || !visitDate) return;
        const isVisit = select?.value === 'site_visit';
        visitDateField.hidden = !isVisit;
        visitDate.required = Boolean(isVisit);
        visitDate.min = todayIso();
        if (!isVisit) visitDate.value = '';
      };

      select?.addEventListener('change', syncVisitDate);
      visitDate?.addEventListener('input', () => {
        if (!visitDate.value || !select || select.value === 'site_visit') return;
        select.value = 'site_visit';
        syncVisitDate();
      });
      syncVisitDate();

      bindLeadForm({
        form,
        button,
        message,
        kind: 'contact',
        submitLabel: button.textContent?.trim() || 'Send request',
        composeSubject: ({ name, requestType, visitDate: date }) =>
          enquirySubject({ name, requestType, visitDate: date }),
        // The status line is inside the dialog, so a screen reader has to be
        // taken to it; the visible text is already in view.
        onSuccess: () => {
          submitted = true;
          if (fallback) fallback.hidden = true;
          // `form.reset()` cleared the control: put the rendered default back
          // so a second visit to the dialog still offers the promised date.
          if (select && form.dataset.defaultRequestType) {
            select.value = form.dataset.defaultRequestType;
          }
          syncVisitDate();
          message.focus();
        },
        onFailure: () => {
          if (fallback) fallback.hidden = false;
        },
      });
    });
  }

  /** The visitor closed the dialog without submitting: reset the form state. */
  function resetOnClose(dialog: HTMLDialogElement): void {
    document.documentElement.removeAttribute('data-scroll-lock');
    if (submitted) return; // a completed enquiry keeps its success state

    const form = dialog.querySelector<HTMLFormElement>('form[data-enquiry-dialog]');
    form?.reset();
    const message = dialog.querySelector<HTMLElement>('[role="status"]');
    if (message) message.textContent = '';
  }

  function wireDialog(dialog: HTMLDialogElement): void {
    if (dialog.dataset.dialogInit === 'true') return;
    dialog.dataset.dialogInit = 'true';

    // Native `cancel` (Escape) already closes the element; the lock release and
    // the form reset ride the `close` event, which both routes reach.
    dialog.addEventListener('close', () => resetOnClose(dialog));

    // Backdrop click: a click on the `<dialog>` element itself can only land
    // outside the panel, because the panel covers the rest of the element.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog.close());
  }

  /**
   * One delegated listener for every dialog trigger on the page. It runs in the
   * capture phase: the view-transition router listens for the same clicks on
   * `document` and only skips a link it sees already cancelled, so the
   * `preventDefault` has to land before its listener runs. A trigger whose
   * dialog is not rendered (the contact page keeps the inline form) is left
   * alone, so its `href` navigates instead.
   */
  function bindDialogTriggers() {
    const scope = window as Window & { __tqDialogTriggers?: boolean };
    if (scope.__tqDialogTriggers) return;
    scope.__tqDialogTriggers = true;

    document.addEventListener(
      'click',
      (event) => {
        const trigger =
          event.target instanceof Element
            ? event.target.closest<HTMLElement>('[data-dialog-trigger]')
            : null;
        const dialogId = trigger?.dataset.dialogTrigger;
        if (!trigger || !dialogId) return;

        const dialog = document.getElementById(dialogId);
        if (!(dialog instanceof HTMLDialogElement)) return;

        event.preventDefault();

        // A trigger that declares what it is asking for (every site-visit and
        // brochure CTA does) opens the dialog on that request. The `change`
        // event is dispatched so the form re-syncs its visit-date field: a
        // brochure trigger must not land on a required date.
        const requestType = trigger.dataset.dialogRequestType;
        const select = dialog.querySelector<HTMLSelectElement>('select[name="request_type"]');
        if (requestType && select) {
          select.value = requestType;
          select.dispatchEvent(new Event('change'));
        }

        document.documentElement.setAttribute('data-scroll-lock', '');
        dialog.showModal();
      },
      { capture: true }
    );
  }

  bindDialogTriggers();
  initEnquiryDialogForms();

  // View transitions: re-wire whatever the swap brought in, and close + reset
  // what is still open — a dialog surviving a navigation would own the new
  // page's viewport and scroll.
  document.addEventListener('astro:page-load', () => {
    submitted = false;
    initEnquiryDialogForms();
  });
  document.addEventListener('astro:before-swap', () => {
    document.querySelectorAll<HTMLDialogElement>('dialog[data-dialog-init]').forEach((dialog) => {
      if (dialog.open) dialog.close();
      resetOnClose(dialog);
    });
  });
</script>
