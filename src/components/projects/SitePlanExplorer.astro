              }
              io.disconnect();
            }
          });
        },
        { threshold: 0.25 }
      );
      io.observe(frame);
      new IntersectionObserver(([entry]) => {
        if (entry && !entry.isIntersecting) closeSheet();
      }).observe(root);

      root.classList.add('is-enhanced');
    });
  }

