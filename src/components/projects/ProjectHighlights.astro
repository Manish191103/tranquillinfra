---
/**
 * ProjectHighlights
 *
 * The brochure's project pages, redrawn: the headline figures, the HMDA
 * scrutiny plan's land-use split as one proportional bar, and the ten layout
 * features from the brochure's "Layout Features" spread. Data lives in
 * `~/config/highlights.config.ts`, so the homepage, the project page and the
 * compact strip on the inner pages print the same numbers.
 *
 * `variant="compact"` renders only the figures, as a band with a link to the
 * project page — for pages whose subject is not the project.
 */
import Icon from '~/components/ui/primitives/Icon/Icon.astro';
import SectionHeading from '~/components/patterns/SectionHeading.astro';
import {
  highlightFigures,
  landUse,
  layoutFeatures,
  roadFrontage,
} from '~/config/highlights.config';

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  variant?: 'full' | 'compact';
  id?: string;
  /** Link the compact band (and the full section's footer) to the project page */
  projectHref?: string;
  /** The ten brochure feature tiles; off where the page lists amenities itself */
  showFeatures?: boolean;
  /** The headline figure cards; off where the page already prints the figures */
  showFigures?: boolean;
}

const {
  eyebrow = 'Project highlights',
  title = 'Tranquill City at a glance.',
  intro = 'Premium villa plots at Mamidipally, near Rudraram on the Mumbai Highway. The figures below are taken from the HMDA scrutiny plan and the project brochure.',
  variant = 'full',
  id = 'project-highlights',
  projectHref = '/projects/tranquill-city/',
  showFeatures = true,
  showFigures = true,
} = Astro.props;

const headingId = `${id}-title`;
---

{
  variant === 'compact' ? (
    <section
      id={id}
      class="highlights-compact border-border bg-card border-y"
      aria-labelledby={headingId}
    >
      <div class="mx-auto max-w-6xl px-6 py-10 md:py-12">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id={headingId} class="display-xs">
            Tranquill City highlights
          </h2>
          <a
            class="text-accent-ink hover:text-foreground inline-flex items-center gap-1.5 text-sm font-semibold transition-colors"
            href={projectHref}
            data-track="project"
          >
            Villa plots in Mamidipally, near Rudraram
            <Icon name="arrow-up-right" size="xs" />
          </a>
        </div>
        <dl class="figure-grid figure-grid-compact mt-6">
          {highlightFigures.map((figure) => (
            <div class="figure">
              <dt class="figure-label">{figure.label}</dt>
              <dd class="figure-value">
                {figure.value}
                {figure.unit && <span class="figure-unit">{figure.unit}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  ) : (
    <section id={id} class="section bg-background scroll-mt-24" aria-labelledby={headingId}>
      <div class="mx-auto max-w-6xl px-6">
        <SectionHeading eyebrow={eyebrow} title={title} intro={intro} id={headingId} />

        {showFigures && (
          <dl class="figure-grid mt-12">
            {highlightFigures.map((figure, index) => (
              <div class:list={['figure figure-card', index === 0 && 'figure-card-lead']}>
                <dt class="figure-label">{figure.label}</dt>
                <dd>
                  <span class="figure-value">
                    {figure.value}
                    {figure.unit && <span class="figure-unit">{figure.unit}</span>}
                  </span>
                  <span class="figure-detail">{figure.detail}</span>
                </dd>
              </div>
            ))}
          </dl>
        )}

        {/* Land use: one bar, each segment as wide as its share of the layout. */}
        <div class="shell mt-14">
          <div class="shell-core p-6 md:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <h3 class="display-xs">How the 4.8 acres are planned</h3>
              <p class="text-foreground-subtle text-xs">
                Area statement, HMDA draft layout scrutiny plan · % of 19,410 sq.m
              </p>
            </div>
            <div
              class="landuse-bar mt-6"
              role="img"
              aria-label={landUse.map((share) => `${share.label} ${share.percent}%`).join(', ')}
            >
              {landUse.map((share) => (
                <span style={`flex-basis:${share.percent}%;background:${share.tone}`} />
              ))}
            </div>
            <ul class="mt-5 grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2 lg:grid-cols-3">
              {landUse.map((share) => (
                <li class="flex items-center gap-3">
                  <span class="swatch" style={`background:${share.tone}`} aria-hidden="true" />
                  <span class="text-foreground font-semibold tabular-nums">{share.percent}%</span>
                  <span class="text-foreground-muted">
                    {share.label} · {share.sqM.toLocaleString('en-IN')} sq.m
                  </span>
                </li>
              ))}
            </ul>
            <ul class="border-border text-foreground-muted mt-6 flex flex-wrap gap-x-6 gap-y-2 border-t pt-5 text-sm">
              {roadFrontage.map((line) => (
                <li class="flex items-center gap-2">
                  <Icon name="route" size="xs" class="text-accent-ink" />
                  {line}
                </li>
              ))}
            </ul>
          </div>
        </div>

        {showFeatures && (
          <div class="mt-16">
            <h3 class="display-sm">Layout features</h3>
            <ul class="feature-grid mt-8">
              {layoutFeatures.map((feature) => (
                <li class="feature">
                  <span class="feature-icon" aria-hidden="true">
                    <Icon name={feature.icon} size="md" />
                  </span>
                  <span class="feature-name">{feature.name}</span>
                  <span class="feature-detail">{feature.detail}</span>
                </li>
              ))}
            </ul>
            <p class="text-foreground-subtle mt-6 text-sm">
              Features as advertised for the planned layout; confirm the current stage of works with
              the team during your{' '}
              <a class="underline underline-offset-2" href="/contact-us/">
                site visit
              </a>
              .
            </p>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .figure-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .figure-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .figure-grid-compact {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .figure {
    display: flex;
    min-width: 0;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .figure-card {
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    border-radius: var(--radius-core);
    background-color: var(--color-card);
    box-shadow: var(--hairline);
  }

  .figure-card {
    flex-direction: column;
    justify-content: flex-start;
  }

  .figure-card dd {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* The lead figure carries the brand forest so the grid has one anchor. */
  .figure-card-lead {
    background-color: var(--surface-invert);
    color: var(--on-invert);
  }

  .figure-card-lead .figure-label,
  .figure-card-lead .figure-detail {
    color: var(--on-invert-muted);
  }

  .figure-card-lead .figure-unit {
    color: var(--accent);
  }

  .figure-label {
    color: var(--color-foreground-muted);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .figure-value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  .figure-grid-compact .figure-value {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .figure-unit {
    margin-left: 0.35rem;
    color: var(--color-accent-ink);
    font-family: var(--font-sans, inherit);
    font-size: 0.42em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .figure-detail {
    color: var(--color-foreground-muted);
    font-size: 0.875rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .landuse-bar {
    display: flex;
    overflow: hidden;
    height: 1.25rem;
    gap: 2px;
    border-radius: var(--radius-full);
  }

  .landuse-bar span {
    min-width: 4px;
  }

  .swatch {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 0.2rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .feature-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .feature-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border-radius: var(--radius-core);
    background-color: var(--color-card);
    box-shadow: var(--hairline);
    transition:
      transform var(--site-transition-spring),
      box-shadow var(--site-transition);
  }

  .feature:hover {
    transform: translateY(-2px);
    box-shadow: var(--site-shadow-md);
  }

  .feature-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.5rem;
    place-items: center;
    border-radius: var(--radius-full);
    background-color: var(--surface-invert);
    color: var(--accent);
  }

  .feature-name {
    color: var(--color-foreground);
    font-weight: 700;
    line-height: 1.3;
  }

  .feature-detail {
    color: var(--color-foreground-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }
</style>
