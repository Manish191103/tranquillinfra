---
/**
 * Blog article
 *
 * One post per route, rendered from the `blog` collection. The reviewed answers
 * in frontmatter render as an Accordion and are emitted as FAQPage structured
 * data alongside the article; sources are listed under the article.
 *
 * The article is emitted as a two-node graph — the `WebPage` at the post's own
 * URL and the `BlogPosting` at `<url>#article` — so `mainEntityOfPage` points at
 * a node the page actually defines. Both name the same company, so the byline
 * and the publisher can never disagree.
 *
 * The FAQPage node is kept for machine understanding and AI answer extraction,
 * not for a rich result: Google withdrew the FAQ rich result for all publishers.
 * Its answers are disclosure-first — "how do I verify this", "what is not
 * published" — and must stay that way, because FAQPage must never be used for
 * promotional copy.
 */
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/seo/Breadcrumbs.astro';
import JsonLd from '~/components/seo/JsonLd.astro';
import Prose from '~/components/patterns/Prose.astro';
import Accordion from '~/components/ui/overlay/Accordion/Accordion.astro';
import Button from '~/components/ui/form/Button/Button.astro';
import { canonicalUrl } from '~/lib/canonical';
import siteConfig from '~/config/site.config';
import { getPublishedPosts, getReadingMinutes, getRelatedPosts } from '~/lib/blog';
import { createBlogPostSchema, createFAQSchema } from '~/lib/schema';
import { enquiryCtaTarget, SITE_VISIT_CTA_LABEL } from '~/lib/enquiry-cta';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: getRelatedPosts(posts, post) },
  }));
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat('en', { dateStyle: 'long' });
const canonical = canonicalUrl(`/blog/${post.id}/`, siteConfig.url);
const faq = post.data.faq;
const wordCount = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
// The page renders the enquiry dialog, so the next step opens it rather than
// navigating to the contact page: the reader has already read the argument.
const enquiryCta = enquiryCtaTarget(Astro.url.pathname);

const postSchema = createBlogPostSchema({
  title: post.data.title,
  description: post.data.description,
  url: canonical,
  image: new URL(`/og/blog/${post.id}.png`, Astro.site).toString(),
  datePublished: post.data.publishedAt,
  dateModified: post.data.updatedAt,
  author: { name: post.data.author },
  section: post.data.category,
  wordCount,
});

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/blog/' },
  { label: post.data.title },
];
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  article={{
    publishedTime: post.data.publishedAt,
    modifiedTime: post.data.updatedAt,
    authors: [post.data.author],
    tags: post.data.tags,
  }}
>
  <div class="mx-auto max-w-6xl px-6 pt-8">
    <Breadcrumbs items={breadcrumbs} />
  </div>

  <article class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <header>
      <p class="eyebrow">{post.data.category}</p>
      <h1 class="display-xl">{post.data.title}</h1>
      <p class="text-foreground-muted mt-4 text-lg">{post.data.description}</p>
      <p class="text-foreground-subtle mt-5 text-sm">
        <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>
          {dateFormatter.format(post.data.publishedAt)}
        </time>
        <span aria-hidden="true"> · </span>
        {getReadingMinutes(post)} min read
        <span aria-hidden="true"> · </span>
        {post.data.author}
        {post.data.updatedAt && (
          <>
            <span aria-hidden="true"> · </span>
            Updated{' '}
            <time datetime={post.data.updatedAt.toISOString().slice(0, 10)}>
              {dateFormatter.format(post.data.updatedAt)}
            </time>
          </>
        )}
      </p>
    </header>

    <div class="mt-10">
      <Prose>
        <Content />
      </Prose>
    </div>

    {faq.length > 0 && (
      <section class="mt-16" aria-labelledby="post-faq-title">
        <h2 id="post-faq-title" class="display-sm">
          Frequently asked questions
        </h2>
        <Accordion
          class="mt-6"
          items={faq.map((item) => ({ title: item.question, content: item.answer }))}
        />
      </section>
    )}

    {post.data.sources.length > 0 && (
      <section class="mt-16" aria-labelledby="post-sources-title">
        <h2 id="post-sources-title" class="display-sm">
          Sources
        </h2>
        <ul class="mt-4 grid gap-2 text-sm">
          {post.data.sources.map((source) => (
            <li>
              <a
                class="text-foreground hover:text-accent-ink underline underline-offset-2 transition-colors"
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {source.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16" aria-labelledby="post-related-title">
        <h2 id="post-related-title" class="display-sm">
          More from Insights
        </h2>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {related.map((entry) => (
            <li>
              <article class="border-border bg-card flex h-full flex-col rounded-md border p-5 shadow-sm">
                <p class="eyebrow">{entry.data.category}</p>
                <h3 class="display-xs">
                  <a class="hover:text-accent-ink transition-colors" href={`/blog/${entry.id}/`}>
                    {entry.data.title}
                  </a>
                </h3>
                <div class="border-border text-foreground-muted mt-auto flex items-center gap-2 border-t pt-3 text-sm">
                  <time datetime={entry.data.publishedAt.toISOString().slice(0, 10)}>
                    {dateFormatter.format(entry.data.publishedAt)}
                  </time>
                  <span aria-hidden="true">·</span>
                  <span>{getReadingMinutes(entry)} min read</span>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </section>
    )}

    <aside class="border-border mt-16 border-t pt-8">
      <h2 class="display-sm">Next step</h2>
      <p class="text-foreground-muted mt-3 max-w-[42rem]">
        See the Tranquill City project page for the layout, amenities and location context, or ask
        the team for the documents relevant to the plot you are considering.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <Button href="/projects/tranquill-city/" data-track="project_view">
          Explore Tranquill City
        </Button>
        <Button
          href={enquiryCta.href}
          variant="secondary"
          data-track="site_visit"
          data-dialog-trigger={enquiryCta.dialog}
          data-dialog-request-type="site_visit"
        >
          {SITE_VISIT_CTA_LABEL}
        </Button>
      </div>
    </aside>
  </article>

  <JsonLd schema={postSchema} />
  {faq.length > 0 && <JsonLd schema={createFAQSchema(faq)} />}
</PageLayout>
