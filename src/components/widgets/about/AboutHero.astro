---
/**
 * AboutHero
 *
 * The About page opener: the entry's `heroTitle` is the page's single H1 and
 * `heroIntro` its lede, sitting over the illustrative golden-hour view of the
 * planned Tranquill City entrance, with the premium-project note as a muted
 * line under the copy and an anchor cue jumping to the story section.
 *
 * Only the heading and the lede are here. The entry's remaining paragraphs
 * render in the page below the fold: a hero plate is a scrim-sized object, and
 * a four-paragraph article inside it ran off the bottom of the frame — the last
 * sentence was clipped at the fold on both desktop and mobile (measured
 * 2026-09-30). The hero carries the promise; the body carries the argument.
 */
import { Picture } from 'astro:assets';
import aboutHero from '~/assets/images/projects/tranquill-city/about-hero.webp';

interface Props {
  /** The page's single H1, from the entry's `heroTitle`. */
  title: string;
  /** The one-paragraph lede, from the entry's `heroIntro`. */
  intro: string;
  eyebrow: string;
  note: { label: string; title: string; body: string };
}

const { title, intro, eyebrow, note } = Astro.props;
---

<section class="bg-surface-invert text-on-invert">
  <div class="relative">
    <Picture
      src={aboutHero}
      alt="Illustrative golden-hour view of the planned Tranquill City entrance, with the lit canopy over the driveway, the illuminated sign wall and villas along the street beyond"
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      loading="eager"
      class="aspect-[16/9] min-h-[24rem] w-full object-cover md:min-h-[30rem]"
    />
    <div class="about-scrim absolute inset-0" aria-hidden="true"></div>

    <div
      class="absolute inset-x-0 bottom-0 mx-auto flex max-w-6xl flex-col px-6 pb-8 md:pb-12"
    >
      <p class="eyebrow eyebrow-on-invert reveal">{eyebrow}</p>

      <div class="about-hero-prose">
        <h1 class="reveal-2">{title}</h1>
        <p class="reveal-3">{intro}</p>
      </div>

      <p class="text-on-invert reveal-4 mt-6 flex max-w-[36rem] flex-wrap items-baseline gap-x-2 text-sm">
        <span class="eyebrow eyebrow-on-invert eyebrow-bare">{note.label}</span>
        <strong class="text-on-invert font-semibold">{note.title}</strong>
        <span>— {note.body}</span>
      </p>

      <a
        href="#about-story"
        class="cta cta-ghost text-on-invert hover:text-on-invert mt-8 self-start"
        aria-label="Skip to the detail"
      >
        <span class="cta-label text-sm">The detail</span>
        <span class="cta-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 5v14M5 12l7 7 7-7"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* A bottom gradient scrim keeps the copy legible against the brightest
     render step, without hiding the imagery. */
  .about-scrim {
    background: linear-gradient(
      to top,
      oklch(17% 0.028 173 / 84%) 0%,
      oklch(17% 0.028 173 / 52%) 32%,
      oklch(17% 0.028 173 / 0%) 62%
    );
  }

  .about-hero-prose h1 {
    max-width: 20ch;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* The lede is one paragraph, so it can run at the lede step the other
     heroes use rather than the article step it was inheriting from a body. */
  .about-hero-prose p {
    max-width: 36rem;
    margin-top: var(--space-3);
    color: var(--color-on-invert-secondary);
    font-size: clamp(1rem, 1.3vw, 1.05rem);
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* The copy is bottom-anchored, so on phones the frame has to stay within the
     first fold for the note to clear the fixed contact bar. */
  @media (width < 60rem) {
    .about-hero-prose h1 {
      font-size: 1.9rem;
    }
  }
</style>
