---
/**
 * InvestmentBelt
 *
 * Paper-toned band that grounds the project in the Patancheru–Sangareddy
 * industrial belt and lists our disclosure commitments as pills.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  /** Trusted, author-authored copy; may carry inline markup such as <strong>. */
  stat?: string;
  pillars?: string[];
}

const {
  eyebrow = 'A longer view',
  title = 'A corridor with space to grow.',
  intro = 'Kukatpally → Nizampet → Miyapur → Patancheru → Rudraram → Sangareddy traces the growth belt around Tranquill City.',
  stat,
  pillars = [
    /*
     * These read as promises, so they are not allowed to promise a return.
     * The array used to hold 'Strategic Locations' and 'Long-term Value
     * Creation' — appreciation claims the site makes no evidence for and, in
     * a buyer's hands, would be read as an expected return. They also
     * contradicted the blog programme, which exists to warn buyers off this
     * register: `verify-plot-hyderabad.md` publishes its checklist because
     * "an informed buyer is good for everyone" and tells publishers to
     * publish in stages, while the homepage was making a five-year
     * projection. A model summarising the page took "Value Creation" as a
     * positioning claim and restated it as a return an evaluator could
     * compare against the disclaimers.
     *
     * So every entry is now something a buyer can check in the next ten
     * minutes, and four of the six are refusals the site already states in
     * prose: the approvals carry numbers and portal links, the entry price is
     * published, the 82/78/4 inventory is stated including the mortgaged
     * parcels, the imagery is labelled as renders, and drive times and a
     * possession date are declined. The length is unchanged — the component
     * lays the pills out as a plate, and a three-item plate reads as a
     * truncated list.
     */
    'Documented Approvals',
    'Published Prices',
    'Inventory Stated Honestly',
    'Imagery Labelled as Renders',
    'No Drive-Time Estimates',
    'No Possession Date Claimed',
  ],
} = Astro.props;

/*
 * The corridor band.
 *
 * The `stat` used to be "1 lakh+ employees work in the Patancheru–Sangareddy
 * industrial belt" — no source, no year, no methodology, no government
 * publication, on a page whose own posts cite every G.O. and departmental FAQ
 * it relies on. `InvestmentBelt` renders it as plain prose, so an extractor
 * lifted it verbatim, and a model asked why Rudraram is a good place to buy
 * land would quote it and attribute it to this developer. Nothing on the site
 * or in the project's published figures supports the number, and the repo's own
 * keyword research commits to "no invented volumes".
 *
 * It is gone rather than softened, and the slot is empty rather than
 * refilled. Every figure the site can actually stand behind — 82 parcels, 78
 * saleable, 4 under HMDA Mortgage conditions, the plot range, the Rs. 50 lakh
 * entry price, RERA REA01100108192, HMDA 2103/HMDA/SWDL/2026 — is already on
 * the homepage page: twice, in the published-details plate directly above and
 * again in the home entry's first paragraph. A third copy here would be a
 * duplication, not evidence, and the only things this section has that the
 * rest of the page does not are the corridor line in `intro` and the pillars.
 * `stat` is optional on the component for exactly this case, and the corridor
 * chain carries the section on its own. Restore it only with a citation the
 * site can name.
 */
---

<section
  class="home-investment section bg-card border-border border-y"
  aria-labelledby="home-investment-belt-title"
>
  <div class="mx-auto max-w-6xl px-6">
    <header class="max-w-3xl">
      <p class="eyebrow reveal">{eyebrow}</p>
      <h2 id="home-investment-belt-title" class="display-md reveal-2">
        {title}
      </h2>
      <p class="text-muted reveal-3 mt-6 max-w-[52ch] text-lg text-pretty">{intro}</p>
    </header>

    {/*
     * The stat and the pillars share one shell. Wrapping them together rather
     * than styling each separately is what makes the band read as a single
     * machined plate: the pillars sit inside the same bezel as the prose above
     * them instead of floating as loose chips on a page-coloured field.
     */}
    <div class="home-investment-body stack reveal-4">
      <div class="shell">
        <div class="shell-core">
          {stat && <p class="investment-stat" set:html={stat} />}

          {pillars.length > 0 && (
            <ul class="investment-pillars" aria-label="What we publish and do not">
              {pillars.map((pillar) => (
                /*
                 * Each pillar is a well inside the plate — a slightly darker
                 * concave depression, not a bordered chip. The inset shadow is
                 * what sells it as pressed into the surface rather than stuck on.
                 */
                <li class="investment-pillar">{pillar}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-investment-body :global(.shell-core) {
    padding: clamp(1.75rem, 3.4vw, 3rem);
  }

  .investment-stat {
    max-width: 46rem;
    margin-bottom: var(--space-8);
    color: var(--color-default);
    font-size: 1.125rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .investment-stat :global(strong) {
    color: var(--color-heading);
    font-weight: 600;
  }

  .investment-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .investment-pillar {
    padding: 0.625rem 1.125rem;
    border-radius: var(--site-radius-full);
    background-color: var(--color-secondary);
    box-shadow:
      inset 0 1px 1px rgb(16 62 51 / 8%),
      inset 0 -1px 0 rgb(255 255 255 / 40%);
    color: var(--color-heading);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }
</style>
