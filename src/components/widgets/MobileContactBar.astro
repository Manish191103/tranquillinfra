---
/**
 * MobileContactBar
 *
 * Fixed bottom bar with the primary contact actions, shown below the
 * navigation breakpoint (`nav:`, 60rem). Actions are supplied by the caller —
 * the component carries no copy. The page body gets bottom clearance while the
 * bar is rendered (see the `is:global` style below).
 *
 * Stacking contract: the bar is `z-30`; the enquiry dialog overlay sits above
 * it, so an open form is never covered.
 *
 * The height is a fixed 3.5rem plus the safe area rather than a measurement,
 * because the body clearance must be known before layout to avoid a visible
 * jump: `env(safe-area-inset-bottom)` resolves at first paint,
 * `getBoundingClientRect` would not.
 */
import { Icon } from 'astro-icon/components';
import { contact } from '~/contact';
import {
  enquiryCtaTarget,
  PHONE_CTA_LABEL,
  SITE_VISIT_CTA_LABEL,
  WHATSAPP_CTA_LABEL,
} from '~/lib/enquiry-cta';

// Same page-aware target as the header and footer CTAs (see `enquiry-cta`).
const enquiryCta = enquiryCtaTarget(Astro.url.pathname);
const telHref = contact.phoneE164 ? `tel:${contact.phoneE164}` : undefined;
---

<nav
  class="fixed inset-x-0 bottom-0 z-30 bg-background/95 backdrop-blur-xl nav:hidden shadow-[0_-1px_0_var(--aw-color-border)]"
  aria-label="Quick contact actions"
  data-mobile-contact-bar
>
  <div class="mx-auto flex max-w-6xl items-center gap-2 px-3 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))]">
    <a
      href={enquiryCta.href}
      data-track="site_visit"
      data-dialog-trigger={enquiryCta.dialog}
      data-dialog-request-type="site_visit"
      class="bg-accent text-accent-foreground hover:bg-accent-hover flex h-11 min-w-0 flex-1 items-center justify-center rounded-full px-5 text-sm font-semibold transition-[background-color,transform] duration-base ease-quint active:scale-[0.97] active:duration-instant [box-shadow:inset_0_1px_1px_rgb(255_255_255/0.35),inset_0_0_0_1px_rgb(16_62_51/0.12)]"
    >
      {SITE_VISIT_CTA_LABEL}
    </a>
    <a
      href={telHref}
      data-track="phone"
      aria-label={PHONE_CTA_LABEL}
      class="text-default flex size-11 shrink-0 items-center justify-center rounded-full transition-[background-color,color,transform] duration-base ease-quint active:scale-[0.94] active:duration-instant [box-shadow:inset_0_0_0_1px_var(--aw-color-border)] hover:bg-secondary"
    >
      <Icon name="tabler:phone" class="h-5 w-5" />
    </a>
    <a
      href={contact.whatsapp}
      data-track="whatsapp"
      aria-label={WHATSAPP_CTA_LABEL}
      class="bg-whatsapp text-white hover:bg-whatsapp-hover flex size-11 shrink-0 items-center justify-center rounded-full transition-[background-color,color,transform] duration-base ease-quint active:scale-[0.94] active:duration-instant"
    >
      <Icon name="tabler:brand-whatsapp" class="h-5 w-5" />
    </a>
  </div>
</nav>

<style is:global>
  /* The bar's own height (0.5rem top + 2.5rem control + 0.5rem bottom + the
     safe area), published on `:root` for anything that needs to sit above the
     bar instead of behind it. */
  :root {
    --mobile-contact-bar-height: calc(3.5rem + env(safe-area-inset-bottom));
  }

  /* Clearance for the fixed bar; the bar itself is hidden from nav breakpoint
     up. No consent banner in this repo, so no banner offset interplay. */
  @media (width < 60rem) {
    body {
      padding-bottom: calc(var(--mobile-contact-bar-height) + 0.75rem);
    }
  }
</style>
