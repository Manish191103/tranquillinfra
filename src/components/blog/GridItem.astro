---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="shell lift intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
  <div class="shell-core flex h-full flex-col p-5">
    <div class="bg-background-secondary relative h-0 mb-4 overflow-hidden rounded-md pb-[56.25%]">
      {
        image &&
          (link ? (
            <a href={link}>
              <Image
                src={image}
                class="absolute inset-0 h-full w-full rounded-md object-cover"
                widths={[400, 900]}
                width={900}
                height={506}
                sizes="(max-width: 900px) 400px, 900px"
                alt={post.title}
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </a>
          ) : (
            <Image
              src={image}
              class="absolute inset-0 h-full w-full rounded-md object-cover"
              widths={[400, 900]}
              width={900}
              height={506}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          ))
      }
    </div>

    <h3 class="display-xs">
      {
        link ? (
          <a class="transition-colors duration-instant hover:text-accent-ink" href={link}>
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h3>

    <p class="text-muted mt-2 text-sm">{post.excerpt}</p>
  </div>
</article>
