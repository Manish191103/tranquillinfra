---
/**
 * EnquiryDialog
 *
 * The popup enquiry form: the `Dialog` primitive around the same submission
 * pipeline as `ContactForm` (`bindLeadForm` → Formspree → the customer mail),
 * opened from any CTA carrying `data-dialog-trigger="<id>"`.
 *
 * Every id is namespaced by `id`, so a page can hold the inline contact form and
 * the dialog at once without the two wiring each other's fields. The markup
 * stays a plain `action` + `method="POST"` form: without JavaScript the dialog
 * never appears and a trigger navigates to the contact form instead.
 */
import { PUBLIC_FORMSPREE_FORM_ID, PUBLIC_PRIVACY_POLICY_URL } from 'astro:env/client';
import Dialog from '~/components/ui/overlay/Dialog/Dialog.astro';
import Input from '~/components/ui/form/Input/Input.astro';
import Select from '~/components/ui/form/Select/Select.astro';
import Textarea from '~/components/ui/form/Textarea/Textarea.astro';
import Button from '~/components/ui/form/Button/Button.astro';
import siteConfig from '~/config/site.config';
import {
  ENQUIRY_SUCCESS_MESSAGE,
  PHONE_CTA_LABEL,
  PHONE_INPUT_PATTERN,
  PHONE_INPUT_TITLE,
  REQUEST_TYPE_OPTIONS,
  SITE_VISIT_CTA_LABEL,
  WHATSAPP_CTA_LABEL,
  type EnquiryRequestType,
} from '~/lib/enquiry-cta';

interface Props {
  /** Element id; the form, button and status line ids derive from it. */
  id?: string;
  title?: string;
  description?: string;
  /** Overrides the env-configured Formspree form (one form per surface). */
  action?: string;
  /** Formspree discriminator: which surface the lead arrived from. */
  formType?: string;
  /** Request type the select starts on; triggers can override it per click. */
  defaultRequestType?: EnquiryRequestType;
  /**
   * Arm the auto-open policy (`src/lib/enquiry-popup.ts`): the dialog opens
   * itself once the visitor has settled, scrolled or shown exit intent, unless
   * they dismissed or completed it before. Pages opt out through `PageLayout`.
   */
  autoOpen?: boolean;
  submitLabel?: string;
  successMessage?: string;
  class?: string;
}

const {
  id = 'enquiry-dialog',
  title = SITE_VISIT_CTA_LABEL,
  description = 'Pick the day you want to see the layout — we confirm the slot by phone within business hours.',
  action = `https://formspree.io/f/${PUBLIC_FORMSPREE_FORM_ID}`,
  formType = 'Enquiry dialog',
  defaultRequestType = 'site_visit',
  autoOpen = true,
  submitLabel = SITE_VISIT_CTA_LABEL,
  successMessage = ENQUIRY_SUCCESS_MESSAGE,
  class: className,
} = Astro.props;

// The failure state has to reach the team without this form: a visitor whose
// message never left the browser still has a phone.
const telHref = siteConfig.phoneE164 ? `tel:${siteConfig.phoneE164}` : undefined;
---

<Dialog id={id} title={title} description={description} size="lg" class={className}>
  <form
    id={`${id}-form`}
    action={action}
    method="POST"
    class="space-y-5"
    data-success-message={successMessage}
    data-enquiry-dialog={id}
    data-default-request-type={defaultRequestType}
    data-auto-open={autoOpen ? 'true' : 'false'}
  >
    <Input
      label="Name"
      name="name"
      type="text"
      required
      maxlength="100"
      autocomplete="name"
      data-dialog-autofocus
    />

    <div class="grid gap-5 sm:grid-cols-2">
      <Input
        label="Phone"
        name="phone"
        type="tel"
        required
        maxlength="20"
        inputmode="tel"
        pattern={PHONE_INPUT_PATTERN}
        title={PHONE_INPUT_TITLE}
        autocomplete="tel"
        hint="We call back during business hours."
      />

      <Input label="Email" name="email" type="email" required autocomplete="email" />
    </div>

    <Select
      label="I would like to"
      name="request_type"
      options={REQUEST_TYPE_OPTIONS}
      hint="Pick the brochure instead and we will only send the PDF — no date needed."
    />

    <!-- The visit date is the promise the CTA makes, so it is required for a
         site visit. The script shows, requires and clears it with the request
         type, and sets `min` to today: the pages are static, so a build-time
         "today" would freeze the earliest bookable day on the build day. -->
    <div data-visit-date-field>
      <Input
        label="Preferred visit date"
        name="visit_date"
        type="date"
        required
        hint="We confirm the slot by phone; weekends are usually the busiest."
      />
    </div>

    <Textarea
      label="Anything we should know?"
      name="message"
      maxlength="5000"
      rows={4}
      hint="Optional — plot size, budget, or a time that suits you."
    />

    <!-- Formspree reads `subject` as the notification subject; the script
         composes it from the request type (the static value covers a submission
         without JS). -->
    <input type="hidden" name="subject" value="New website enquiry" />
    <input type="hidden" name="form_type" value={formType} />

    <!-- Honeypot field for spam protection -->
    <div class="hidden" aria-hidden="true">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <p id={`${id}-message`} class="text-sm" role="status" aria-live="polite" tabindex="-1"></p>

    <!-- The status line says what went wrong; this says where to go instead. A
         rejected POST is the one failure the visitor cannot retry their way out
         of, so the two channels that do not depend on this form are one tap away. -->
    <div
      data-lead-fallback
      hidden
      class="border-destructive/40 bg-destructive/5 space-y-2 rounded-md border p-3 text-sm"
    >
      <p class="font-semibold">That did not reach us. Reach the sales desk directly:</p>
      <ul class="space-y-1">
        {telHref && siteConfig.phone && (
          <li>
            <a href={telHref} data-track="phone" class="underline underline-offset-2">
              {PHONE_CTA_LABEL}: {siteConfig.phone}
            </a>
          </li>
        )}
        {siteConfig.whatsapp && (
          <li>
            <a
              href={siteConfig.whatsapp}
              data-track="whatsapp"
              target="_blank"
              rel="noopener noreferrer"
              class="underline underline-offset-2"
            >
              {WHATSAPP_CTA_LABEL}
            </a>
          </li>
        )}
      </ul>
    </div>

    <div class="space-y-3">
      <Button type="submit" fullWidth id={`${id}-submit`}>
        {submitLabel}
      </Button>

      <p class="text-foreground-muted text-xs">
        We only use your details to answer this enquiry. See our{' '}
        <a class="underline underline-offset-2" href={PUBLIC_PRIVACY_POLICY_URL}>
          privacy policy
        </a>
        .
      </p>
    </div>
  </form>
</Dialog>

<script>
  import { openDialog } from '~/components/ui/overlay/Dialog/dialog';
  import {
    markPopupConverted,
    markPopupDismissed,
    readPopupState,
    shouldAutoOpen,
  } from '~/lib/enquiry-popup';
  import { bindLeadForm, enquirySubject } from '~/lib/leads';

  /** Today's date in the visitor's own zone, as the `min` of the date input. */
  function todayIso(): string {
    const now = new Date();
    return new Date(now.getTime() - now.getTimezoneOffset() * 60_000).toISOString().slice(0, 10);
  }

  /** The armed auto-open for the current page, if the page allows one. */
  let autoOpen: { dialog: HTMLElement; startedAt: number; done: boolean } | null = null;
  let autoOpenBound = false;

  function initEnquiryDialogForms() {
    document.querySelectorAll<HTMLFormElement>('form[data-enquiry-dialog]').forEach((form) => {
      // The binder marks the form it owns; a second pass changes nothing.
      if (form.dataset.leadFormInit === 'true') return;

      const id = form.dataset.enquiryDialog as string;
      const button = document.getElementById(`${id}-submit`) as HTMLButtonElement | null;
      const message = document.getElementById(`${id}-message`) as HTMLElement | null;
      if (!button || !message) return;

      // The default is server-rendered as a data attribute (a `<select>` value
      // cannot be), and a trigger's `data-dialog-request-type` overrides it when
      // the dialog opens.
      const select = form.querySelector<HTMLSelectElement>('select[name="request_type"]');
      if (select && form.dataset.defaultRequestType) select.value = form.dataset.defaultRequestType;

      const visitDateField = form.querySelector<HTMLElement>('[data-visit-date-field]');
      const visitDate = form.querySelector<HTMLInputElement>('input[name="visit_date"]');
      const fallback = form.querySelector<HTMLElement>('[data-lead-fallback]');

      // The date is required for a visit and irrelevant for anything else: a
      // brochure request must not be blocked on a date nobody wants to give.
      // A date already in the field wins over the control, because a visitor
      // who has picked a day has asked for a visit whatever they last selected.
      const syncVisitDate = () => {
        if (!visitDateField || !visitDate) return;
        const isVisit = select?.value === 'site_visit';
        visitDateField.hidden = !isVisit;
        visitDate.required = Boolean(isVisit);
        visitDate.min = todayIso();
        if (!isVisit) visitDate.value = '';
      };

      select?.addEventListener('change', syncVisitDate);
      visitDate?.addEventListener('input', () => {
        if (!visitDate.value || !select || select.value === 'site_visit') return;
        select.value = 'site_visit';
        syncVisitDate();
      });
      syncVisitDate();

      let submitted = false;

      bindLeadForm({
        form,
        button,
        message,
        kind: 'contact',
        submitLabel: button.textContent?.trim() || 'Send request',
        composeSubject: ({ name, requestType, visitDate: date }) =>
          enquirySubject({ name, requestType, visitDate: date }),
        // The status line is inside the dialog, so a screen reader has to be
        // taken to it; the visible text is already in view.
        onSuccess: () => {
          submitted = true;
          markPopupConverted();
          if (fallback) fallback.hidden = true;
          // `form.reset()` cleared the control: put the rendered default back
          // so a second visit to the dialog still offers the promised date.
          if (select && form.dataset.defaultRequestType) {
            select.value = form.dataset.defaultRequestType;
          }
          syncVisitDate();
          message.focus();
        },
        onFailure: () => {
          if (fallback) fallback.hidden = false;
        },
      });

      // Any close that is not a submission — from the auto-open or from a CTA —
      // buys the visitor peace: the popup will not come back on its own.
      form.closest('[data-dialog]')?.addEventListener('dialog:closed', () => {
        if (!submitted) markPopupDismissed();
      });
    });
  }

  /**
   * One delegated listener for every popup trigger on the page. It runs in the
   * capture phase: the view-transition router listens for the same clicks on
   * `document` and only skips a link it sees already cancelled, so the
   * `preventDefault` has to land before its listener runs. A trigger whose
   * dialog is not rendered (`/contact-us/` and the project pages keep the inline form)
   * is left alone, so its `href` navigates instead.
   */
  function bindDialogTriggers() {
    const scope = window as Window & { __tqDialogTriggers?: boolean };
    if (scope.__tqDialogTriggers) return;
    scope.__tqDialogTriggers = true;

    document.addEventListener(
      'click',
      (event) => {
        const trigger =
          event.target instanceof Element
            ? event.target.closest<HTMLElement>('[data-dialog-trigger]')
            : null;
        const dialogId = trigger?.dataset.dialogTrigger;
        if (!trigger || !dialogId) return;

        const dialog = document.getElementById(dialogId);
        if (!dialog) return;

        event.preventDefault();

        // The visitor found the form on their own; no need to interrupt later.
        if (autoOpen) autoOpen.done = true;

        // A trigger that declares what it is asking for (every site-visit and
        // brochure CTA does) opens the dialog on that request. The `change`
        // event is dispatched so the form re-syncs its visit-date field: a
        // brochure trigger must not land on a required date.
        const requestType = trigger.dataset.dialogRequestType;
        const select = dialog.querySelector<HTMLSelectElement>('select[name="request_type"]');
        if (requestType && select) {
          select.value = requestType;
          select.dispatchEvent(new Event('change'));
        }

        openDialog(dialogId, trigger);
      },
      { capture: true }
    );
  }

  /**
   * The auto-open rules live in `src/lib/enquiry-popup.ts`; this gathers the
   * page signals they need and opens the dialog at most once per page.
   */
  function evaluateAutoOpen(exitIntent: boolean): void {
    if (!autoOpen || autoOpen.done) return;

    const active = document.activeElement;

    const mayOpen = shouldAutoOpen({
      stored: readPopupState(),
      now: Date.now(),
      dwellSeconds: (Date.now() - autoOpen.startedAt) / 1000,
      scrollFraction:
        (window.scrollY + window.innerHeight) / Math.max(document.documentElement.scrollHeight, 1),
      exitIntent,
      // Never on top of another dialog, the consent decision, or a field the
      // visitor is typing in.
      busy:
        Boolean(document.querySelector('[data-dialog]:not(.hidden)')) ||
        Boolean(document.querySelector('#consent-banner.consent-banner--visible')) ||
        (active instanceof HTMLElement &&
          (active.isContentEditable || active.matches('input, textarea, select'))),
    });

    if (!mayOpen) return;

    autoOpen.done = true;
    openDialog(autoOpen.dialog.id);
  }

  function initAutoOpen(): void {
    const form = document.querySelector<HTMLFormElement>(
      'form[data-enquiry-dialog][data-auto-open="true"]'
    );
    const dialog = form?.closest<HTMLElement>('[data-dialog]');

    if (!dialog) {
      autoOpen = null;
      return;
    }

    // Already armed for this element: keep its dwell clock. `astro:page-load`
    // fires after the module body and can be seconds behind it on a heavy page —
    // re-arming would push the popup past the visitor's engagement.
    if (autoOpen?.dialog === dialog) return;

    // A visitor who has enquired is never interrupted with the form again.
    if (readPopupState()?.status === 'converted') {
      autoOpen = null;
      return;
    }

    autoOpen = { dialog, startedAt: Date.now(), done: false };

    if (!autoOpenBound) {
      autoOpenBound = true;
      window.addEventListener('scroll', () => evaluateAutoOpen(false), { passive: true });
      // Exit intent: the pointer left through the top edge of the window
      // (`relatedTarget === null`), not into another element on the page.
      document.addEventListener('mouseout', (event) => {
        if (event.relatedTarget || event.clientY > 0) return;
        evaluateAutoOpen(true);
      });
    }

    // A deep link or a restored scroll position may already be past the depth.
    evaluateAutoOpen(false);
  }

  bindDialogTriggers();
  initEnquiryDialogForms();
  initAutoOpen();
  document.addEventListener('astro:page-load', () => {
    initEnquiryDialogForms();
    initAutoOpen();
  });
</script>
