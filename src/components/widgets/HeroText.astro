---
import type { CallToAction } from '~/types';
import Button from '~/components/ui/Button.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  /** Small pill above the tagline. */
  badge?: string;
  content?: string;
  callToAction?: string | CallToAction;
  callToAction2?: string | CallToAction;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,
  content = await Astro.slots.render('content'),
  callToAction = await Astro.slots.render('callToAction'),
  callToAction2 = await Astro.slots.render('callToAction2'),
} = Astro.props;
---

<section class="not-prose relative md:-mt-[76px]">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">
    <div class="pointer-events-none pt-0 md:pt-[76px]"></div>
    <div class="pt-12 pb-4 md:pt-20 md:pb-6">
      <div class="mx-auto max-w-5xl text-center">
        {
          badge && (
            <span class="border-primary/30 bg-primary/10 text-primary dark:bg-primary/25 intersect-once intersect-quarter motion-safe:md:intersect:animate-fade mb-4 inline-block rounded-full border px-3 py-1 text-xs font-semibold tracking-wide uppercase motion-safe:md:opacity-0 dark:text-blue-200">
              {badge}
            </span>
          )
        }
        {
          tagline && (
            <p
              class="text-secondary intersect-once intersect-quarter motion-safe:md:intersect:animate-fade text-base font-bold tracking-wide uppercase motion-safe:md:opacity-0 dark:text-blue-200"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class="leading-tighter font-heading text-heading intersect-once intersect-quarter motion-safe:md:intersect:animate-fade mb-4 text-5xl font-bold tracking-tighter md:text-6xl motion-safe:md:opacity-0"
              set:html={title}
            />
          )
        }
        <div class="mx-auto max-w-3xl">
          {
            subtitle && (
              <p
                class="text-muted intersect-once intersect-quarter motion-safe:md:intersect:animate-fade mb-6 text-xl motion-safe:md:opacity-0 dark:text-slate-300"
                set:html={subtitle}
              />
            )
          }
          <div
            class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade m-auto flex max-w-xs flex-col flex-nowrap gap-4 sm:max-w-md sm:flex-row sm:justify-center motion-safe:md:opacity-0"
          >
            {
              callToAction && (
                <div class="flex w-full sm:w-auto">
                  {typeof callToAction === 'string' ? (
                    <Fragment set:html={callToAction} />
                  ) : (
                    <Button variant="primary" {...callToAction} />
                  )}
                </div>
              )
            }
            {
              callToAction2 && (
                <div class="flex w-full sm:w-auto">
                  {typeof callToAction2 === 'string' ? (
                    <Fragment set:html={callToAction2} />
                  ) : (
                    <Button {...callToAction2} />
                  )}
                </div>
              )
            }
          </div>
        </div>
        {content && <Fragment set:html={content} />}
      </div>
    </div>
  </div>
</section>
