---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="section flex items-center">
    <div class="mx-auto max-w-md text-center">
      <h1 class="display-md mb-8">
        <span class="sr-only">Error</span>
        <span class="text-accent-ink">404</span>
      </h1>
      <p class="display-sm">Sorry, we couldn't find this page.</p>
      <p class="text-muted mt-4 mb-8 text-lg">
        But don't worry, you can find plenty of other things on our homepage.
      </p>
      <a
        rel="noopener noreferrer"
        href={getHomePermalink()}
        class="cta cta-primary mx-auto"
      >
        <span class="cta-label">Back to homepage</span>
        <span class="cta-icon" aria-hidden="true">
          <Icon name="tabler:arrow-right" />
        </span>
      </a>
    </div>
  </section>
</Layout>
