---
import { render, getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import type { MetaData } from '~/types';

export const prerender = true;

export async function getStaticPaths() {
  // `home` renders at `/` via src/pages/index.astro and never at `/home/`.
  const pages = (await getCollection('page', ({ id }) => !['home'].includes(id))).filter(
    ({ data }) => !data.draft
  );
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, heroTitle, heroIntro, publishedAt, updatedAt } = entry.data;

const metadata: MetaData = {
  title,
  description,
  openGraph: { type: 'website' },
};
---

<Layout metadata={metadata}>
  <HeroText title={heroTitle ?? title} subtitle={heroIntro} />

  <section class="not-prose mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-muted text-sm">
      {
        updatedAt && (
          <>
            Updated{' '}
            <time datetime={new Date(updatedAt).toISOString()}>
              {new Date(updatedAt).toLocaleDateString('en-IN', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </time>
          </>
        )
      }
      {updatedAt && publishedAt && ' · '}
      {
        publishedAt && !updatedAt && (
          <time datetime={new Date(publishedAt).toISOString()}>
            {new Date(publishedAt).toLocaleDateString('en-IN', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
        )
      }
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-8 sm:px-6 md:py-12">
    <div
      class="prose prose-lg prose-headings:font-heading prose-a:text-primary dark:prose-headings:text-slate-300 prose-headings:leading-tighter prose-headings:tracking-tighter prose-img:rounded-md mx-auto"
    >
      <Content />
    </div>
  </section>
</Layout>
