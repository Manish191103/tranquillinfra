---
import type { HTMLTag } from 'astro/types';
import type { Widget } from '~/types';
import { twMerge } from 'tailwind-merge';

export interface Props extends Widget {
  containerClass?: string;
  ['as']?: HTMLTag;
}

const { id, isDark = false, containerClass = '', bg, as = 'section' } = Astro.props;

const WrapperTag = as;
---

<WrapperTag class="not-prose relative scroll-mt-[72px]" {...id ? { id } : {}}>
  <div class="pointer-events-none absolute inset-0 -z-[1]" aria-hidden="true">
    <slot name="bg">
      {
        bg ? (
          <Fragment set:html={bg} />
        ) : (
          <div class:list={['absolute inset-0', { 'bg-dark dark:bg-transparent': isDark }]} />
        )
      }
    </slot>
  </div>
  <div
    class:list={[
      twMerge(
        'text-default intersect-once intersect-quarter intersect-no-queue motion-safe:md:intersect:animate-fade relative mx-auto max-w-7xl px-4 py-12 md:px-6 md:py-16 motion-safe:md:opacity-0 lg:py-20',
        containerClass
      ),
      { dark: isDark },
    ]}
  >
    <slot />
  </div>
</WrapperTag>
