---
/**
 * Announcement bar: the forest strip above the header.
 *
 * Every message is a link with its own destination, which is why the bar does
 * not rotate them: a rotation would show one promise at a time and hide the
 * statutory line ("Verify RERA … and HMDA … yourself") from anyone who arrives
 * between steps. All messages ship as real text in the markup and render as
 * ordinary links; the strip stays one line and scrolls horizontally on a phone
 * (360px cannot fit four sentences), with the scrollbar hidden so the bar keeps
 * its measured height.
 *
 * The defaults quote the published facts from `~/contact` — the RERA and HMDA
 * numbers and the plot range are statutory, and a bar that quotes an old number
 * is worse than no bar. `messages` overrides them where a page needs its own.
 */
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';
import { contact } from '~/contact';
import { enquiryCtaTarget, type EnquiryRequestType } from '~/lib/enquiry-cta';

export interface AnnouncementMessage {
  text: string;
  href: string;
  /** Analytics hook; the tracking layer reads `data-track` when it lands. */
  track?: string;
  /** Dialog element to open instead of navigating, where the page renders one. */
  dialog?: string;
  /** What the link is asking for; the dialog opens on that request. */
  requestType?: EnquiryRequestType;
}

interface Props extends HTMLAttributes<'aside'> {
  /** Override the default announcements (computed per page path). */
  messages?: AnnouncementMessage[];
}

// Page-aware "Book a site visit" target: the dialog on pages that carry it,
// the on-page enquiry form anchor on the pages that render one instead. The
// bar is rendered once per page, so the path is available at render time.
const enquiryCta = enquiryCtaTarget(Astro.url.pathname);

const defaultMessages: AnnouncementMessage[] = [
  {
    text: 'Book a site visit at Tranquill City — pick the day that suits you.',
    href: enquiryCta.href,
    dialog: enquiryCta.dialog,
    requestType: 'site_visit',
    track: 'site_visit',
  },
  {
    text: `Villa plots of ${contact.plotSizes} in Rudraram.`,
    href: '/projects/tranquill-city/',
  },
  {
    text: `Verify RERA ${contact.approvals.rera.number} and HMDA ${contact.approvals.hmda.number} yourself.`,
    href: '/projects/tranquill-city/',
  },
  {
    text: 'Request the brochure and the latest project details.',
    href: '/projects/tranquill-city/#project-brochure',
    track: 'brochure',
  },
];

const { messages = defaultMessages, class: className, ...attrs } = Astro.props;
---

{
  messages.length > 0 && (
    <aside
      class:list={['invert-section border-border-invert border-b', className]}
      data-announcement-bar
      aria-label="Announcements"
      {...attrs}
    >
      {/*
        WCAG 2.2 target size (minimum): below `nav:` this link IS the whole
        top-of-page call to action on a phone, so each link carries a
        `min-h-6` floor — the row's `min-h-10` still governs the bar's height
        and nothing moves.
      */}
      <div class="mx-auto flex min-h-10 max-w-6xl items-center gap-3 px-6">
        <div class="announcement-strip flex min-w-0 flex-1 items-center gap-6">
          {messages.map((message) => (
            <a
              href={message.href}
              data-track={message.track}
              data-dialog-trigger={message.dialog}
              data-dialog-request-type={message.requestType}
              class="hover:text-accent-ink flex min-h-6 shrink-0 items-center gap-2 text-xs font-semibold"
            >
              <span class="bg-accent size-1.5 shrink-0 rounded-full" aria-hidden="true" />
              <span class="whitespace-nowrap">{message.text}</span>
              <Icon name="tabler:arrow-up-right" class="text-accent-ink size-3.5 shrink-0" />
            </a>
          ))}
        </div>
      </div>
    </aside>
  )
}

<style>
  /* One line that can outgrow the viewport on a phone: the strip scrolls
     horizontally instead of wrapping or squeezing four sentences into
     ellipses. The scrollbar is hidden — the arrows mark the links and the
     cut-off copy marks the overflow — and the bar keeps its 2.5rem height
     (scrollbars would otherwise pad the row by platform amount). */
  .announcement-strip {
    overflow-x: auto;
    scrollbar-width: none;
    scroll-padding-inline: 1.5rem;
  }

  .announcement-strip::-webkit-scrollbar {
    display: none;
  }
</style>
