---
/**
 * ProofBelt
 *
 * Hairline-bounded belt of project facts that scrolls horizontally through the
 * page. The belt is pure presentation — points arrive from the page so the
 * component carries no copy.
 */
import Marquee from '~/components/ui/marketing/Marquee/Marquee.astro';

interface ProofPoint {
  label: string;
  value: string;
}

interface Props {
  points: ProofPoint[];
  /** Accessible name for the rail */
  label?: string;
}

const { points, label = 'Tranquill City project details' } = Astro.props;
---

{points.length > 0 && (
  <section class="home-proof bg-card border-border border-y">
    <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
      <Marquee label={label}>
        {points.map((point) => (
          /*
           * Each fact is a shell around a core: a hairline tray with the paper
           * plate seated inside it, so the belt reads as a row of machined
           * objects rather than a row of bordered chips. The value is set in
           * the display face at the `xs` step — the one place on the homepage
           * where a number should feel engraved rather than typed.
           */
          <div class="border-border bg-background border-y px-6 py-4 whitespace-nowrap">
            <span class="text-foreground-muted font-mono text-[0.7rem] font-medium tracking-[0.14em] uppercase">
              {point.label}
            </span>
            <strong class="display-xs text-foreground ml-4 inline-block align-middle font-medium">
              {point.value}
            </strong>
          </div>
        ))}
      </Marquee>
    </div>
  </section>
)}
