---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';

import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;
---

<section class="section mx-auto max-w-3xl px-4 sm:px-6">
  <article>
    <header
      class="intersect-once intersect-quarter motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0"
    >
      <div class="text-muted flex flex-col justify-between sm:flex-row sm:items-center">
        <p>
          <Icon name="tabler:clock" class="-mt-0.5 inline-block h-4 w-4" />
          <time datetime={post.publishDate.toISOString()} class="inline-block"
            >{getFormattedDate(post.publishDate)}</time
          >
          {
            post.updateDate && post.updateDate.getTime() !== post.publishDate.getTime() && (
              <>
                {' '}
                ·{' '}
                <span class="inline-block">
                  Updated{' '}
                  <time datetime={post.updateDate.toISOString()}>
                    {getFormattedDate(post.updateDate)}
                  </time>
                </span>
              </>
            )
          }
          {
            post.author && (
              <>
                {' '}
                ·{' '}
                <Icon name="tabler:user" class="-mt-0.5 inline-block h-4 w-4" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a
                  class="inline-block transition-colors hover:text-accent-ink"
                  href={getPermalink(post.category.slug, 'category')}
                >
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      <h1 class="display-lg mt-4">{post.title}</h1>
      <p class="text-muted mt-4 text-lg text-pretty">{post.excerpt}</p>

      {
        post.image ? (
          <Image
            src={post.image}
            class="bg-background-secondary mt-10 max-w-full rounded-md"
            widths={[400, 900]}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.imageAlt || ''}
            width={900}
            height={506}
            format="webp"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="mt-10">
            <div class="border-border border-t" />
          </div>
        )
      }
    </header>
    <!--
      * Prose measure.
      *
      * `ch` is the advance of `0`, and in Manrope that glyph is ~35% wider than
      * the average glyph in running text — so `65ch` is not 65 characters per
      * line, it is close to 89. Measured 2026-09-30 on
      * `/blog/verify-plot-hyderabad/` at 768px and above: the column rendered
      * 650px wide against an average glyph advance of 7.323px, i.e. ~88.8
      * characters per line, ~18% past the top of the 60–75 band that long-form
      * reading is tuned to. The consequence is worst exactly where it hurts
      * most: a phone, and a verification checklist where a mis-scanned line is
      * a missed step. `33rem` lands the measure at ~72 characters per line at
      * every width from 390px up, and the `ch` term is kept so a narrower font
      * substitution still shortens the column rather than letting it grow.
      *
      * The typography plugin owns the element styles; only the container
      * (measure), display family on headings and token links are bridged here.
      -->
    <div
      class="prose prose-headings:font-display prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-headings:scroll-mt-[80px] prose-a:text-primary prose-img:rounded-md prose-li:my-0 mx-auto mt-10 max-w-[min(65ch,33rem)]"
    >
      <slot />
    </div>
    <div class="border-border mt-8 flex flex-col justify-between border-t pt-8 sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="text-muted mt-5 align-middle sm:mt-1" />
    </div>
  </article>
</section>
