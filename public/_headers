# Security headers for every static-asset response. The Cloudflare asset server
# applies this file to prerendered pages, the 404 page, feeds and images;
# responses the Worker renders (the on-demand API routes) get the same set from
# src/middleware.ts. `/*` is the documented catch-all path
# pattern — `#` is the only comment marker — and its headers are indented.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=(), interest-cohort=(), usb=(), serial=(), hid=(), accelerometer=(), gyroscope=(), magnetometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # `connect-src` names every host the browser pipeline talks to: the Formspree
  # AJAX POST, the GA4/gtag collection endpoints (GA4 beacons can land on
  # regional `region1.google-analytics.com`, hence the wildcards), Meta's
  # pixel relay target, and the GitHub REST API the self-hosted Decap CMS
  # admin (/decapcms/) calls from the browser. There is deliberately no
  # `script-src`/`style-src`: the inline GA bootstrap and the view-transition
  # runtime are inline, and a hash-pinned policy would break on every rebuild
  # until ClientRouter is dropped. Mirrored by hand in src/middleware.ts.
  Content-Security-Policy: base-uri 'self'; connect-src 'self' https://formspree.io https://api.github.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com; object-src 'none'; form-action 'self' https://formspree.io; frame-ancestors 'none'

# Caching baseline comes from the Workers asset server itself: every unhashed
# response is served `Cache-Control: public, max-age=0, must-revalidate` with an
# ETag — including HTML, the feeds and any generated OG PNGs, which are all
# rebuilt in place at every deploy — and content-hashed `/_astro/*` is served
# immutable. The rules below only add the exceptions to that baseline.
# `_headers` appends same-named values from matching rules instead of
# overriding, so never restate a header on `/*` that a narrower rule also sets.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable