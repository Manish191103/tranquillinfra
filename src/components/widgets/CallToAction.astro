---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
  /** `card` (boxed, centred) or `banner` (full-width band on the primary colour). */
  layout?: 'card' | 'banner';
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  actions = await Astro.slots.render('actions'),
  layout = 'card',

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''}`}
  bg={bg}
>
  <div
    class:list={[
      'text-center',
      layout === 'banner'
        ? 'bg-primary mx-auto rounded-2xl px-6 py-12 text-white md:py-16'
        : 'mx-auto max-w-3xl rounded-md p-6 shadow-xl dark:border dark:border-slate-600 dark:shadow-none',
    ]}
  >
    <Headline
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        title: `text-4xl md:text-4xl font-bold tracking-tighter mb-4 font-heading ${layout === 'banner' ? 'text-white' : ''}`,
        subtitle:
          layout === 'banner' ? 'text-xl text-white' : 'text-xl text-muted dark:text-slate-400',
        ...((classes?.headline as Record<string, string>) ?? {}),
      }}
    />
    {
      actions && (
        <div class="m-auto mt-6 flex max-w-xs flex-col flex-nowrap gap-4 sm:max-w-md sm:flex-row sm:justify-center">
          {Array.isArray(actions) ? (
            actions.map((action) => (
              <div class="flex w-full sm:w-auto">
                <Button
                  {...(action || {})}
                  class:list={[
                    'w-full whitespace-nowrap sm:mb-0',
                    layout === 'banner' && action?.variant === 'primary'
                      ? 'text-primary hover:text-primary dark:text-primary border-white bg-white hover:border-white/90 hover:bg-white/90 dark:border-white dark:bg-white'
                      : layout === 'banner'
                        ? 'border-white/70 text-white hover:border-white hover:bg-white/10 hover:text-white dark:border-white/70 dark:text-white'
                        : '',
                  ]}
                />
              </div>
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>
