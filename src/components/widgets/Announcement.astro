---
// Thin bar above the header. Everything is a prop so a site can change the
// message without touching the component; the defaults reproduce the demo.
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
  showStars?: boolean;
}

const {
  badge = 'NEW',
  text = 'Astro v7 is now available! »',
  href = 'https://astro.build/blog/astro-7/',
  showStars = true,
} = Astro.props;
---

<div
  class="relative hidden gap-1 overflow-hidden bg-slate-900 px-3 py-2 text-sm text-ellipsis whitespace-nowrap text-slate-300 lg:flex dark:border-b dark:border-slate-800 dark:bg-transparent dark:text-slate-400"
>
  {
    badge && (
      <span class="mr-0.5 inline-block bg-white/20 px-1 py-0.5 text-xs font-semibold text-slate-100 rtl:mr-0 rtl:ml-0.5 dark:bg-slate-700 dark:text-slate-300">
        {badge}
      </span>
    )
  }
  {
    text &&
      (href ? (
        <a
          href={href}
          class="font-medium text-slate-300 hover:underline dark:text-slate-400"
          set:html={text}
        />
      ) : (
        <span class="font-medium text-slate-300 dark:text-slate-400" set:html={text} />
      ))
  }
  {
    showStars && (
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto inline-block h-[1.25rem] w-[5.6rem] bg-[url(https://img.shields.io/github/stars/arthelokyo/astrowind.svg?style=social&label=Stars&maxAge=86400)] bg-contain bg-right bg-no-repeat ltr:ml-auto rtl:mr-auto"
        title="If you like AstroWind, give us a star."
        href="https://github.com/arthelokyo/astrowind"
      >
        <span class="sr-only">GitHub stars</span>
      </a>
    )
  }
</div>
