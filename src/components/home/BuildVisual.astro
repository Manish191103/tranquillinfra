---
/**
 * BuildVisual
 *
 * The figure that stands in for a ScrollBuildStory beat's paragraph: a plot
 * grid, the road widths, the land-use split, feature tiles or the approval
 * seals. The beat keeps its paragraph as screen-reader text, so the visual is
 * `aria-hidden` and carries no fact the paragraph does not.
 *
 * Motion is gated on `[data-build-init]` (the story's controller has run) and
 * plays when the beat turns `.is-active`; without either the figure is drawn
 * in its final state.
 */
import ApprovalSeals from '~/components/ui/primitives/ApprovalSeals.astro';
import Icon from '~/components/ui/primitives/Icon/Icon.astro';

export type BuildVisualSpec =
  | {
      kind: 'plots';
      total: number;
      saleable: number;
      stats: { value: string; label: string }[];
    }
  | {
      kind: 'roads';
      roads: { label: string; feet: number }[];
      notes: { icon: string; label: string }[];
    }
  | {
      kind: 'landuse';
      shares: { label: string; percent: number; tone: string }[];
      stats: { value: string; label: string }[];
    }
  | { kind: 'tiles'; tiles: { icon: string; label: string; note: string }[] }
  | { kind: 'approvals'; price: string; priceNote: string }
  | {
      kind: 'growth';
      metrics: { chart: 'line' | 'bars' | 'route' | 'ring'; value: string; label: string }[];
    }
  | {
      kind: 'invest';
      price: string;
      priceNote: string;
      total: number;
      saleable: number;
      loan: string[];
    };

interface Props {
  spec: BuildVisualSpec;
}

const { spec } = Astro.props;
const maxFeet = spec.kind === 'roads' ? Math.max(...spec.roads.map((road) => road.feet)) : 1;
---

<div class:list={['bv', `bv-${spec.kind}`]} aria-hidden="true">
  {
    spec.kind === 'plots' && (
      <>
        <div class="bv-plot-grid">
          {Array.from({ length: spec.total }, (_, i) => (
            <span
              class:list={['bv-plot', i >= spec.saleable && 'bv-plot-held']}
              style={`--i:${i}`}
            />
          ))}
        </div>
        <div class="bv-legend">
          <span>
            <i class="bv-key bv-key-sale" />
            {spec.saleable} for sale
          </span>
          <span>
            <i class="bv-key bv-key-held" />
            {spec.total - spec.saleable} held under HMDA Mortgage
          </span>
        </div>
        <dl class="bv-stats">
          {spec.stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </>
    )
  }

  {
    spec.kind === 'roads' && (
      <>
        <div class="bv-roads">
          {spec.roads.map((road, i) => (
            <div class="bv-road-row">
              <span class="bv-road" style={`--w:${(road.feet / maxFeet) * 100}%;--i:${i}`}>
                <span class="bv-road-line" />
              </span>
              <span class="bv-road-label">{road.label}</span>
            </div>
          ))}
        </div>
        <ul class="bv-notes">
          {spec.notes.map((note) => (
            <li>
              <Icon name={note.icon} size="sm" />
              {note.label}
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    spec.kind === 'landuse' && (
      <>
        <div class="bv-bar">
          {spec.shares.map((share, i) => (
            <span class="bv-bar-seg" style={`--p:${share.percent};--tone:${share.tone};--i:${i}`} />
          ))}
        </div>
        <ul class="bv-bar-legend">
          {spec.shares.slice(0, 4).map((share) => (
            <li>
              <i class="bv-key" style={`background:${share.tone}`} />
              <span>{share.label}</span>
              <b>{share.percent}%</b>
            </li>
          ))}
        </ul>
        <dl class="bv-stats">
          {spec.stats.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </>
    )
  }

  {
    spec.kind === 'tiles' && (
      <ul class="bv-tiles">
        {spec.tiles.map((tile, i) => (
          <li class="bv-tile" style={`--i:${i}`}>
            <span class="bv-tile-icon">
              <Icon name={tile.icon} size="lg" />
            </span>
            <span class="bv-tile-label">{tile.label}</span>
            <span class="bv-tile-note">{tile.note}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    spec.kind === 'approvals' && (
      <>
        <ApprovalSeals />
        <p class="bv-price">
          <span class="bv-price-value">{spec.price}</span>
          <span class="bv-price-note">{spec.priceNote}</span>
        </p>
      </>
    )
  }

  {
    spec.kind === 'growth' && (
      <ul class="bv-metrics">
        {spec.metrics.map((metric, i) => (
          <li class:list={['bv-metric', `bv-metric-${metric.chart}`]} style={`--i:${i}`}>
            <svg class="bv-chart" viewBox="0 0 120 56" preserveAspectRatio="xMidYMid meet">
              {metric.chart === 'line' && (
                <>
                  <path class="bv-area" d="M4 50 L4 40 L40 34 L76 28 L116 10 L116 50 Z" />
                  <path class="bv-draw" pathLength="1" d="M4 40 L40 34 L76 28 L116 10" />
                  <circle class="bv-dot" cx="116" cy="10" r="4" />
                </>
              )}
              {metric.chart === 'bars' && (
                <>
                  <rect class="bv-col bv-col-dim" x="22" y="22" width="30" height="30" rx="4" />
                  <rect class="bv-col" x="68" y="13" width="30" height="39" rx="4" />
                  <text x="37" y="18" class="bv-chart-t">
                    H1 '25
                  </text>
                  <text x="83" y="9" class="bv-chart-t">
                    H1 '26
                  </text>
                </>
              )}
              {metric.chart === 'route' && (
                <>
                  <path class="bv-track" d="M8 32 H112" />
                  <path class="bv-draw" pathLength="1" d="M8 32 H88" />
                  <circle class="bv-stop" cx="8" cy="32" r="4.5" />
                  <circle class="bv-stop" cx="88" cy="32" r="4.5" />
                  <circle class="bv-site" cx="108" cy="32" r="5.5" />
                  <text x="8" y="50" class="bv-chart-t" text-anchor="start">
                    Miyapur
                  </text>
                  <text x="88" y="50" class="bv-chart-t">
                    Patancheru
                  </text>
                  <text x="108" y="20" class="bv-chart-t bv-chart-site">
                    Site
                  </text>
                </>
              )}
              {metric.chart === 'ring' && (
                <>
                  <path class="bv-track" d="M14 52 A46 42 0 0 1 106 52" />
                  <path class="bv-draw" pathLength="1" d="M14 52 A46 42 0 0 1 60 10" />
                  <circle class="bv-site" cx="60" cy="40" r="5.5" />
                  <text x="60" y="54" class="bv-chart-t">
                    City
                  </text>
                </>
              )}
            </svg>
            <b>{metric.value}</b>
            <span>{metric.label}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    spec.kind === 'invest' && (
      <>
        <p class="bv-price bv-price-top">
          <span class="bv-price-value">{spec.price}</span>
          <span class="bv-price-note">{spec.priceNote}</span>
        </p>
        <div class="bv-stock">
          <span class="bv-stock-fill" style={`--w:${(spec.saleable / spec.total) * 100}%`} />
        </div>
        <p class="bv-stock-note">
          <b>{spec.saleable}</b> of {spec.total} plots for sale
        </p>
        <ul class="bv-loan">
          {spec.loan.map((line) => (
            <li>
              <Icon name="check-circle" size="sm" />
              {line}
            </li>
          ))}
        </ul>
        <div class="bv-seals">
          <ApprovalSeals compact />
        </div>
      </>
    )
  }
</div>

<style>
  .bv {
    width: min(30rem, 100%);
    padding: 1.1rem 1.2rem;
    border: 1px solid rgb(255 255 255 / 14%);
    border-radius: 1.25rem;
    background: rgb(8 12 10 / 58%);
    backdrop-filter: blur(10px);
    color: var(--color-foreground);
  }

  /* Plots */
  .bv-plot-grid {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 4px;
  }

  .bv-plot {
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--accent);
  }

  .bv-plot-held {
    border: 1.5px solid rgb(255 255 255 / 55%);
    background: transparent;
  }

  .bv-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-top: 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .bv-legend span,
  .bv-bar-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bv-key {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
  }

  .bv-key-sale {
    background: var(--accent);
  }

  .bv-key-held {
    border: 1.5px solid rgb(255 255 255 / 60%);
  }

  .bv-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .bv-stats dt {
    color: rgb(255 255 255 / 66%);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bv-stats dd {
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.1;
  }

  /* Roads */
  .bv-roads {
    display: grid;
    gap: 0.8rem;
  }

  .bv-road-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
  }

  .bv-road {
    position: relative;
    display: block;
    width: var(--w);
    height: 1.6rem;
    border-block: 2px solid #d9d2c2;
    border-radius: 3px;
    background: #2f3330;
    transform-origin: left center;
  }

  .bv-road-line {
    position: absolute;
    top: 50%;
    right: 6%;
    left: 6%;
    border-top: 2px dashed var(--accent);
  }

  .bv-road-label {
    font-family: var(--font-display);
    font-size: 1.15rem;
    white-space: nowrap;
  }

  .bv-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem 0.9rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .bv-notes li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bv-notes :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }

  /* Land use */
  .bv-bar {
    display: flex;
    overflow: hidden;
    height: 1.5rem;
    gap: 2px;
    border-radius: 0.5rem;
  }

  .bv-bar-seg {
    flex: var(--p) 0 0;
    min-width: 3px;
    background: var(--tone);
    transform-origin: left center;
  }

  .bv-bar-legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 0.9rem;
    margin-top: 0.85rem;
    font-size: 0.8rem;
  }

  .bv-bar-legend b {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  /* Tiles */
  /* Fill the panel: inside a shrink-to-fit parent the three columns collapsed
     to their minimum and the labels ran into each other. */
  .bv-tiles {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 0.6rem;
  }

  .bv-tile {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.9rem 0.8rem;
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 7%);
    overflow-wrap: break-word;
  }

  .bv-tile-icon {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.3rem;
    place-items: center;
    border-radius: 0.75rem;
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .bv-tile-label {
    font-weight: 700;
    line-height: 1.2;
  }

  .bv-tile-note {
    color: rgb(255 255 255 / 66%);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  /* Approvals */
  .bv-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .bv-price-value {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
  }

  .bv-price-note {
    color: rgb(255 255 255 / 72%);
    font-size: 0.85rem;
  }

  /* Growth */
  .bv-metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .bv-metric {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.8rem 0.85rem;
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 7%);
  }

  .bv-chart {
    width: 100%;
    height: 3.2rem;
    overflow: visible;
  }

  .bv-area {
    fill: color-mix(in oklch, var(--accent) 22%, transparent);
  }

  .bv-draw {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bv-track {
    fill: none;
    stroke: rgb(255 255 255 / 18%);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .bv-dot {
    fill: var(--accent);
  }

  .bv-col {
    fill: var(--accent);
  }

  .bv-col-dim {
    fill: rgb(255 255 255 / 28%);
  }

  .bv-stop {
    fill: #101512;
    stroke: var(--accent);
    stroke-width: 2.5;
  }

  .bv-site {
    fill: #b0157e;
    stroke: #fff;
    stroke-width: 2;
  }

  .bv-chart-t {
    fill: rgb(255 255 255 / 75%);
    font-size: 8.5px;
    font-weight: 700;
    text-anchor: middle;
  }

  .bv-chart-site {
    fill: #f2b8dd;
  }

  .bv-metric b {
    margin-top: 0.25rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .bv-metric span {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* Invest */
  .bv-price-top {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .bv-stock {
    height: 0.6rem;
    margin-top: 0.9rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 14%);
  }

  .bv-stock-fill {
    display: block;
    width: var(--w);
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transform-origin: left center;
  }

  .bv-stock-note {
    margin-top: 0.45rem;
    color: rgb(255 255 255 / 72%);
    font-size: 0.8rem;
  }

  .bv-stock-note b {
    color: var(--color-foreground);
  }

  .bv-loan {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .bv-loan li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bv-loan :global(svg) {
    flex-shrink: 0;
    color: var(--accent);
  }

  .bv-seals {
    margin-top: 0.9rem;
  }

  /* Motion: build the figure when its beat becomes the active stage. */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-build-init]) .bv-plot,
    :global([data-build-init]) .bv-tile,
    :global([data-build-init]) .bv-metric {
      opacity: 0;
      transform: scale(0.6);
      transition:
        opacity 300ms ease,
        transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    :global([data-build-init]) .bv-plot {
      transition-delay: calc(var(--i) * 9ms);
    }

    :global([data-build-init]) .bv-tile,
    :global([data-build-init]) .bv-metric {
      transform: translateY(0.75rem);
      transition-delay: calc(var(--i) * 110ms);
    }

    :global([data-build-init]) .bv-road,
    :global([data-build-init]) .bv-bar-seg,
    :global([data-build-init]) .bv-stock-fill {
      transform: scaleX(0);
      transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i) * 120ms);
    }

    :global(.build-beat.is-active) .bv-plot,
    :global(.build-beat.is-active) .bv-tile,
    :global(.build-beat.is-active) .bv-metric {
      opacity: 1;
      transform: none;
    }

    :global([data-build-init]) .bv-draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1100ms cubic-bezier(0.65, 0, 0.35, 1);
      transition-delay: calc(var(--i) * 140ms + 200ms);
    }

    :global([data-build-init]) .bv-col {
      transform: scaleY(0);
      transform-box: fill-box;
      transform-origin: bottom;
      transition: transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i) * 140ms + 200ms);
    }

    :global(.build-beat.is-active) .bv-draw {
      stroke-dashoffset: 0;
    }

    :global(.build-beat.is-active) .bv-col {
      transform: none;
    }

    :global(.build-beat.is-active) .bv-road,
    :global(.build-beat.is-active) .bv-bar-seg,
    :global(.build-beat.is-active) .bv-stock-fill {
      transform: none;
    }
  }

  @media (max-width: 42rem) {
    .bv {
      padding: 0.9rem;
    }

    .bv-plot-grid {
      gap: 3px;
    }

    .bv-tiles {
      grid-template-columns: minmax(0, 1fr);
    }

    .bv-tile {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
      padding: 0.6rem 0.75rem;
    }

    .bv-tile-icon {
      margin-bottom: 0;
    }

    .bv-tile-note {
      display: none;
    }

    .bv-metric {
      padding: 0.6rem 0.7rem;
    }

    .bv-metric b {
      font-size: 1.4rem;
    }
  }
</style>
