---
// The brand palette lives here, as `--aw-*` custom properties that
// src/assets/styles/tailwind.css maps into Tailwind's theme (`bg-primary`,
// `text-heading`, `text-muted`, …) and src/assets/styles/shadcn.css re-exports
// under the shadcn names (`bg-background`, `text-foreground`, …).
//
// Change a value here and every widget, plus any shadcn-style component added
// later, re-themes with it — which is why a colour is never written literally
// in a component. Each value carries the primitive it came from and the
// contrast ratio it measures against the surface it actually sits on: the
// accent is a light gold, legible on forest and invisible on sand, so text on
// a light surface uses `--aw-color-accent-ink` instead (gold stepped down,
// 4.65:1 on the page background).
//
// The raw OKLCH ramps (`--brand-*`, `--sage-*`, `--sand-*`, `--gold-*`,
// `--clay-*`) are the primitives the `--aw-*` values anchor on, ported from
// the predecessor site's tokens/primitives.css. Only the steps that feed an
// `--aw-*` value or a component class are kept.
//
// The `--site-*` / `--shell-*` / `--hairline*` / `--space-*` tokens below are
// the ported system layer (tokens/semantic.css, typography.css, spacing.css):
// type scale, motion curves, radii, shadows, double-bezel surfaces, hairlines
// and section rhythm. Component classes in tailwind.css read them.
//
// Fonts come from Astro's native Fonts API (see `fonts` in astro.config.ts and
// <Font /> in Layout.astro), exposed as `--font-manrope`, `--font-fraunces`
// and `--font-jetbrains-mono`.
//

---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-manrope);
    --aw-font-serif: var(--font-fraunces);
    --aw-font-mono: var(--font-jetbrains-mono);
    --aw-font-heading: var(--font-fraunces);

    /* ---------------------------------------------------------------------
       Primitives — brand ramps, ported from tokens/primitives.css
       --------------------------------------------------------------------- */

    /* Forest green (hue 173): 700 is the deep green used for the header,
       footer and primary surfaces; 950 is the hero scrim. */
    --brand-500: oklch(42.61% 0.0699 171.6);
    --brand-600: oklch(38% 0.062 173);
    --brand-700: oklch(32.93% 0.0532 173.9);
    --brand-800: oklch(28% 0.045 173);
    --brand-950: oklch(17% 0.028 173);

    /* Sage — muted green-gray (hue 152). Light steps for tinted panels and
       footer text on forest, 700 for quiet foregrounds on sand. */
    --sage-200: oklch(91.79% 0.0161 152);
    --sage-300: oklch(85.5% 0.022 152);
    --sage-400: oklch(76.74% 0.0278 152);
    --sage-700: oklch(41% 0.027 152);

    /* Sand — warm neutral (hue 92): paper, page sand, hairline. */
    --sand-50: oklch(98.82% 0.0069 92);
    --sand-100: oklch(95.5% 0.0124 92);
    --sand-200: oklch(92.5% 0.0135 92);
    --sand-300: oklch(89.35% 0.0137 92);
    --sand-400: oklch(80% 0.014 92);

    /* Gold — brand accent (a surface colour, not a text colour on light). */
    --gold-500: oklch(85.62% 0.1266 88);
    --gold-600: oklch(78% 0.13 88);

    /* Clay — warm secondary accent for focus and hover states. */
    --clay-500: oklch(50.29% 0.1141 40);

    /* WhatsApp vendor green, darkened for contrast: the official #25d366
       fill measures 1.98:1 against the white glyph it carries; these steps
       measure 5.4:1 (fill) and 8.1:1 (hover). */
    --whatsapp: #0d7a41;
    --whatsapp-hover: #0b5c38;

    --success: oklch(72.3% 0.19 145);
    --error: oklch(62.8% 0.22 25);

    /* ---------------------------------------------------------------------
       Brand values (the `--aw-*` interface)
       --------------------------------------------------------------------- */
    --aw-color-primary: var(--brand-700); /* forest-dark actions */
    --aw-color-primary-hover: var(--brand-500);
    --aw-color-secondary: var(--brand-500);
    --aw-color-accent: var(--gold-500); /* a surface colour */
    --aw-color-accent-hover: var(--gold-600);
    --aw-color-accent-ink: oklch(52% 0.11 72); /* gold for text on sand, 4.65:1 */

    --aw-color-text-heading: var(--brand-800); /* 12.6:1 on sand */
    --aw-color-text-default: var(--brand-700); /*  8.5:1 on sand */
    --aw-color-text-muted: var(--sage-700); /*  7.6:1 on sand */
    --aw-color-bg-page: var(--sand-100);
    --aw-color-bg-page-dark: var(--brand-950);

    --aw-color-border: var(--sand-300); /* hairline */
    --aw-color-border-strong: var(--sand-400);
    --aw-color-card: var(--sand-50); /* paper */
    --aw-color-ring: var(--clay-500); /* clay focus ring */

    --aw-color-whatsapp: var(--whatsapp);
    --aw-color-whatsapp-hover: var(--whatsapp-hover);
    --aw-color-success: var(--success);

    /* Inverted (forest) surfaces — see `.invert-section` in tailwind.css. */
    --aw-color-surface-invert: var(--brand-700);
    --aw-color-surface-invert-secondary: var(--brand-600);
    --aw-color-surface-invert-tertiary: var(--brand-500);
    --aw-color-on-invert: var(--sand-50); /* 11.5:1 on brand-700 */
    --aw-color-on-invert-secondary: var(--sage-200); /*  9.4:1 on brand-700 */
    --aw-color-on-invert-muted: var(--sage-400); /*  5.8:1 on brand-700, AA */
    --aw-color-border-invert: color-mix(in srgb, var(--sage-200) 24%, transparent);
    --aw-color-border-invert-strong: color-mix(in srgb, var(--sage-200) 40%, transparent);

    ::selection {
      background-color: oklch(85.62% 0.1266 88);
      color: oklch(28% 0.045 173);
    }

    /* ---------------------------------------------------------------------
       Type — ported from tokens/typography.css + semantic.css
       --------------------------------------------------------------------- */
    --site-heading-weight: 500;
    --site-heading-tracking: -0.02em;
    --site-body-leading: 1.65;

    /* Display optical-size defaults; the `.display-*` steps override per size. */
    --site-display-opsz: 48;
    --site-display-tracking: -0.03em;
    --site-display-leading: 1.04;

    /* The six display steps: fluid size + the Fraunces optical cut it wants. */
    --text-display-xs: clamp(1.5rem, 1.35rem + 0.75vw, 1.875rem); /* opsz 20 */
    --text-display-sm: clamp(1.875rem, 1.65rem + 1.125vw, 2.375rem); /* opsz 28 */
    --text-display-md: clamp(2.25rem, 1.9rem + 1.75vw, 3rem); /* opsz 36 */
    --text-display-lg: clamp(2.75rem, 2.2rem + 2.75vw, 4rem); /* opsz 48 */
    --text-display-xl: clamp(3.25rem, 2.4rem + 4.25vw, 5.5rem); /* opsz 72 */
    --text-display-2xl: clamp(3.75rem, 2.4rem + 6.75vw, 7.5rem); /* opsz 144 */

    /* ---------------------------------------------------------------------
       Motion — four curves, each doing a specific job (semantic.css)
       --------------------------------------------------------------------- */
    --site-duration-instant: 120ms;
    --site-duration-fast: 220ms;
    --site-duration-base: 380ms;
    --site-duration-slow: 620ms;
    --site-duration-lazy: 900ms;

    --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1); /* decelerating arrival */
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1); /* overlays, dialogs, menu */
    --ease-spring: cubic-bezier(0.32, 0.72, 0, 1); /* presses */
    --ease-in-out-quint: cubic-bezier(0.83, 0, 0.17, 1); /* state swaps */

    --site-transition: var(--site-duration-base) var(--ease-out-quart);
    --site-transition-spring: var(--site-duration-fast) var(--ease-spring);
    --site-transition-state: var(--site-duration-base) var(--ease-in-out-quint);

    /* ---------------------------------------------------------------------
       Shadows — brand-tinted, two parts: contact + ambient (semantic.css)
       --------------------------------------------------------------------- */
    --site-shadow-sm: 0 1px 2px rgb(16 62 51 / 6%);
    --site-shadow-md: 0 1px 2px rgb(16 62 51 / 4%), 0 4px 12px -2px rgb(16 62 51 / 6%);
    --site-shadow-lg: 0 1px 3px rgb(16 62 51 / 4%), 0 16px 32px -8px rgb(16 62 51 / 10%);
    --site-shadow-xl: 0 2px 4px rgb(16 62 51 / 3%), 0 32px 64px -12px rgb(16 62 51 / 14%);

    /* The lift: hover for anything that reads as a physical control. */
    --site-lift: 0 28px 56px -20px rgb(16 62 51 / 22%);
    --site-lift-lift: -2px;

    /* ---------------------------------------------------------------------
       Radii — generous, near-square; shell/core differ by the shell padding
       so double-bezel corners stay concentric (semantic.css)
       --------------------------------------------------------------------- */
    --site-radius-sm: 0.3rem;
    --site-radius-md: 1rem;
    --site-radius-lg: 1.5rem;
    --site-radius-xl: 2rem;
    --site-radius-shell: 2.5rem;
    --site-radius-core: 2rem;
    --site-radius-full: 9999px;

    /* ---------------------------------------------------------------------
       Double-bezel surfaces — a card is a machined plate in a tray (semantic.css)
       --------------------------------------------------------------------- */
    --shell-padding: 0.375rem;
    --shell-surface: rgb(16 62 51 / 4%);
    --shell-edge: inset 0 0 0 1px rgb(16 62 51 / 7%);
    --core-highlight: inset 0 1px 1px rgb(255 255 255 / 55%);

    --shell-surface-invert: rgb(253 251 246 / 8%);
    --shell-edge-invert: inset 0 0 0 1px rgb(253 251 246 / 12%);
    --core-highlight-invert: inset 0 1px 1px rgb(0 0 0 / 18%);

    /* Hairlines — 1px rule at low alpha with a matching inset highlight. */
    --hairline: inset 0 0 0 1px rgb(16 62 51 / 9%);
    --hairline-strong: inset 0 0 0 1px rgb(16 62 51 / 16%);
    --hairline-invert: inset 0 0 0 1px rgb(253 251 246 / 16%);

    /* ---------------------------------------------------------------------
       Spacing — 4px base + section rhythm (spacing.css)
       --------------------------------------------------------------------- */
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;
    --space-24: 6rem;
    --space-32: 8rem;
    --space-40: 10rem;

    --space-section-header: clamp(var(--space-8), 5vw, var(--space-16));
    --space-stack-md: var(--space-4);
    --space-stack-lg: var(--space-8);

    /* Sections breathe 5–10rem; the tightened mobile end keeps phones out of
       a corridor of empty bands. */
    --space-section-lg: clamp(var(--space-20), 9vw, var(--space-40));
    --space-section-xl: clamp(var(--space-24), 12vw, var(--space-40));

    /* Stagger for sequenced entrances: 60ms apart reads as one gesture. */
    --space-stagger: 60ms;

    --space-safe-bottom: env(safe-area-inset-bottom, 0px);
  }
</style>
