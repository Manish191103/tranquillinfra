---
/**
 * ProcessSection
 *
 * How an enquiry actually runs, on the inverted surface: the numbered steps in
 * reading order beside a card linking to the verification guide. Copy and links
 * arrive from the page.
 */
import Icon from '~/components/ui/primitives/Icon/Icon.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  steps: Array<{ number: string; title: string; body: string }>;
  guide: { eyebrow: string; title: string; body: string; href: string; linkLabel: string };
}

const { eyebrow, title, intro, steps, guide } = Astro.props;
---

<section class="bg-surface-invert text-on-invert" aria-labelledby="about-process-title">
  <div class="section mx-auto max-w-6xl px-6">
    <div class="max-w-[46rem]">
      <p class="eyebrow eyebrow-on-invert">{eyebrow}</p>
      <h2 id="about-process-title" class="display-md text-on-invert">
        {title}
      </h2>
      <p class="text-on-invert-secondary mt-4 text-pretty">{intro}</p>
    </div>

    <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:gap-14">
      <ol class="space-y-12">
        {steps.map((step) => (
          <li class="border-border-invert reveal border-t pt-6">
            <span
              class="text-accent-ink font-mono text-[0.72rem] font-medium tracking-[0.16em] tabular-nums"
              aria-hidden="true"
            >
              {step.number}
            </span>
            <h3 class="display-xs text-on-invert">{step.title}</h3>
            <p class="text-on-invert-secondary mt-3 text-sm leading-relaxed">{step.body}</p>
          </li>
        ))}
      </ol>

      {/*
        A paper plate on a forest field. Because the core is light, every
        descendant uses the LIGHT-surface foreground ramp — the previous
        `text-on-invert` here put paper-coloured body copy on a cream plate,
        which measured 1.1:1 and was effectively invisible.
      */}
      <aside class="shell reveal-from-right">
        <div class="shell-core h-full p-6 md:p-8">
          <p class="eyebrow">{guide.eyebrow}</p>
          <h3 class="display-sm text-foreground">{guide.title}</h3>
          <p class="text-foreground-muted mt-4 text-sm leading-relaxed text-pretty">{guide.body}</p>
          <a class="cta cta-ghost text-accent-ink mt-8" href={guide.href}>
            <span class="cta-label">{guide.linkLabel}</span>
            <span class="cta-icon" aria-hidden="true">
              <Icon name="arrow-right" size="sm" />
            </span>
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>
