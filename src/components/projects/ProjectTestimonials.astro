---
/**
 * ProjectTestimonials
 *
 * Buyer voices: self-hosted video clips and written quotes in one rail. Video
 * cards are links to the MP4 (the no-JS path); `testimonial-player.ts` upgrades
 * the click into the shared Dialog player. Copy arrives from the content entry,
 * the component stays presentation-only.
 *
 * Text overlays: the name, context and quote sit on the poster over a bottom
 * scrim (a `figcaption`, so they stay real text), and the dialog repeats the
 * name and context as a decorative plate over the frames; the speech itself
 * travels as `<track>` captions and the transcript.
 *
 * The rail is also the showcase: the card at the rail's leading edge is active
 * and plays its muted inline preview while the others rest on their posters.
 * `./testimonial-rail.ts` owns that state together with the prev/next buttons,
 * the segment jumps, the counter and the per-card pause toggle; opening a card
 * plays the full clip with sound in the dialog.
 *
 * The section is rendered by the page only when the entry has testimonials, so
 * nothing here ships before an item exists (consent is the plan's publish gate).
 */
import { getImage, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '~/components/patterns/SectionHeading.astro';
import Dialog from '~/components/ui/overlay/Dialog/Dialog.astro';
import Icon from '~/components/ui/primitives/Icon/Icon.astro';

interface TestimonialItem {
  id: string;
  /**
   * Text and consent fields arrive with the team's consented copy; an item
   * that only carries media is valid and renders as poster + player.
   */
  name?: string;
  context?: string;
  quote?: string;
  consentRecordedAt?: Date;
  consentRef?: string;
  photo?: { image: ImageMetadata; alt: string };
  video?: {
    src: string;
    poster: ImageMetadata;
    posterAlt: string;
    duration: string;
    orientation: 'portrait' | 'landscape';
    captions?: Array<{ src: string; lang: string; label: string }>;
    transcript?: string;
  };
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  note: string;
  items: TestimonialItem[];
}

const { eyebrow, title, intro, note, items } = Astro.props;

const isRail = items.length > 1;

/** Never upscale a poster past its own width when building the srcset. */
function posterWidths(width: number): number[] {
  const candidates = [480, 720, 960].filter((candidate) => candidate <= width);
  return candidates.length > 0 ? candidates : [width];
}

/** Zero-padded counter, e.g. `01 / 04`. */
const pad = (value: number): string => String(value).padStart(2, '0');

/** Accessible name for the card: the whole poster opens the clip. */
function watchLabel(item: TestimonialItem, index: number): string {
  if (!item.name) return `Watch buyer testimonial video ${index + 1} of ${items.length}`;
  return `Watch video testimonial: ${item.name}${item.context ? `, ${item.context}` : ''}`;
}

/**
 * Dialog heading. The dialog needs a label even before a name is supplied, and
 * four dialogs all titled "Buyer testimonial" were four indistinguishable
 * windows: each one is wired `aria-labelledby`, so all four were injected into
 * the project page's heading outline as identical `role="heading" aria-level="2"`
 * entries against a page that has 15 real headings.
 *
 * Until the team supplies names, consent-linked contexts and quotes, the only
 * thing that distinguishes one clip from another is which clip it is. So the
 * fallback counts. Nothing is invented: the number is derived from the item's
 * own position in the rail, and a named item still wins outright.
 */
function dialogTitle(item: TestimonialItem, index: number): string {
  if (item.name) return item.context ? `${item.name} — ${item.context}` : item.name;
  return `Buyer account ${index + 1} of ${items.length}`;
}

const dialogIds = items.map((item) => `testimonial-${item.id}`);

// One rendition for the dialog's `poster` attribute; the cards keep <Picture>.
const dialogPosters = await Promise.all(
  items.map((item) =>
    item.video
      ? getImage({
          src: item.video.poster,
          width: Math.min(960, item.video.poster.width),
          format: 'webp',
        }).then((image) => image.src)
      : Promise.resolve(undefined)
  )
);
---

<section
  id="project-testimonials"
  class="section mx-auto max-w-6xl px-6"
  aria-labelledby="project-testimonials-title"
>
  <SectionHeading eyebrow={eyebrow} title={title} intro={intro} id="project-testimonials-title" />

  <div data-testimonial-showcase>
    <ul
      class:list={[
        'mt-10 flex gap-6 pb-2',
        isRail ? 'testimonial-rail snap-x snap-mandatory overflow-x-auto' : 'justify-center',
      ]}
      tabindex={isRail ? 0 : undefined}
      role={isRail ? 'group' : undefined}
      aria-label={isRail ? 'Buyer testimonials' : undefined}
      data-testimonial-rail
    >
      {items.map((item, index) => {
        const dialogId = dialogIds[index];

        return (
          <li
            class:list={[
              'testimonial-card group',
              isRail ? 'w-[78%] shrink-0 snap-start sm:w-[48%] lg:w-[30%]' : 'w-full max-w-[22rem]',
            ]}
            data-testimonial-card
            data-testimonial-name={item.name}
          >
            <figure class="relative">
              {item.video ? (
                <>
                  <div class="testimonial-media border-border has-[a:focus-visible]:ring-ring has-[a:focus-visible]:ring-offset-2 relative isolate overflow-hidden rounded-md border has-[a:focus-visible]:ring-2">
                    <Picture
                      src={item.video.poster}
                      alt={item.video.posterAlt}
                      widths={posterWidths(item.video.poster.width)}
                      sizes="(min-width: 1024px) 22rem, (min-width: 640px) 48vw, 78vw"
                      fallbackFormat="webp"
                      formats={['avif', 'webp']}
                      class:list={[
                        'w-full object-cover',
                        item.video.orientation === 'portrait' ? 'aspect-[9/16]' : 'aspect-video',
                      ]}
                    />
                    {/* Muted preview, played by ./testimonial-rail.ts; the poster stays
                      visible until the first frame is on screen. */}
                    <video
                      class="testimonial-video pointer-events-none absolute inset-0 size-full object-cover opacity-0"
                      muted
                      playsinline
                      preload="none"
                      data-testimonial-inline
                      aria-hidden="true"
                    >
                      <source src={item.video.src} type="video/mp4" />
                    </video>
                    <span
                      class="bg-foreground/15 group-hover:bg-foreground/25 absolute inset-0 transition-colors"
                      aria-hidden="true"
                    />
                    {/* Overlay scrim: carries the name, context and quote on the poster. */}
                    {(item.name || item.context || item.quote) && (
                      <span
                        class="from-foreground/95 via-foreground/70 pointer-events-none absolute inset-x-0 bottom-0 h-[55%] bg-gradient-to-t to-transparent"
                        aria-hidden="true"
                      />
                    )}
                    <a
                      href={item.video.src}
                      class="absolute inset-0 rounded-md focus-visible:outline-none"
                      data-testimonial-trigger={dialogId}
                      aria-label={watchLabel(item, index)}
                    />
                    <span
                      class="testimonial-badge bg-accent text-accent-foreground pointer-events-none absolute top-1/2 left-1/2 grid size-14 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full shadow-lg group-hover:scale-105"
                      aria-hidden="true"
                    >
                      <Icon name="play" size="md" />
                    </span>
                    <span class="bg-foreground/85 text-background pointer-events-none absolute top-3 right-3 rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums">
                      {item.video.duration}
                    </span>
                    <button
                      type="button"
                      class="testimonial-toggle bg-foreground/70 text-background hover:bg-foreground/85 focus-visible:ring-ring focus-visible:ring-offset-2 absolute top-3 left-3 grid size-9 cursor-pointer place-items-center rounded-full backdrop-blur-sm focus-visible:ring-2 focus-visible:outline-none"
                      data-testimonial-toggle
                      aria-label="Play the video preview"
                      aria-pressed="false"
                    >
                      <span data-icon="play">
                        <Icon name="play" size="sm" />
                      </span>
                      <span data-icon="pause">
                        <Icon name="pause" size="sm" />
                      </span>
                    </button>
                  </div>
                  {(item.name || item.context || item.quote) && (
                    <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 p-5">
                      {item.name && <p class="display-xs text-background">{item.name}</p>}
                      {item.context && (
                        <p class="text-background/80 mt-0.5 text-sm">{item.context}</p>
                      )}
                      {item.quote && (
                        <blockquote class="text-background/90 mt-2 line-clamp-3 text-sm text-pretty">
                          {'“'}
                          {item.quote}
                          {'”'}
                        </blockquote>
                      )}
                    </figcaption>
                  )}
                </>
              ) : (
                <>
                  {item.photo && (
                    <Picture
                      src={item.photo.image}
                      alt={item.photo.alt}
                      widths={posterWidths(item.photo.image.width)}
                      sizes="3.5rem"
                      fallbackFormat="webp"
                      formats={['avif', 'webp']}
                      class="border-border size-14 rounded-full border object-cover"
                    />
                  )}

                  {(item.name || item.context) && (
                    <figcaption class="mt-4">
                      {item.name && <p class="display-xs">{item.name}</p>}
                      {item.context && <p class="text-foreground-subtle text-sm">{item.context}</p>}
                    </figcaption>
                  )}

                  {item.quote && (
                    <blockquote class="text-foreground-secondary mt-3 text-sm text-pretty">
                      {'“'}
                      {item.quote}
                      {'”'}
                    </blockquote>
                  )}
                </>
              )}
            </figure>
          </li>
        );
      })}
    </ul>

    {isRail && (
      <>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="border-border bg-card text-foreground-secondary hover:border-accent hover:bg-accent hover:text-accent-foreground focus-visible:ring-ring disabled:cursor-not-allowed grid size-10 cursor-pointer place-items-center rounded-full border transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:opacity-40"
              data-testimonial-prev
              aria-label="Show the previous testimonial"
            >
              <Icon name="chevron-left" size="sm" />
            </button>
            <button
              type="button"
              class="border-border bg-card text-foreground-secondary hover:border-accent hover:bg-accent hover:text-accent-foreground focus-visible:ring-ring disabled:cursor-not-allowed grid size-10 cursor-pointer place-items-center rounded-full border transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none disabled:opacity-40"
              data-testimonial-next
              aria-label="Show the next testimonial"
            >
              <Icon name="chevron-right" size="sm" />
            </button>
          </div>

          <div class="flex min-w-[7rem] flex-1 items-center gap-1.5">
            {items.map((item, index) => (
              <button
                type="button"
                class="testimonial-segment bg-foreground/25 hover:bg-accent focus-visible:ring-ring flex-1 cursor-pointer rounded-full transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
                data-testimonial-segment={index}
                aria-label={`Show ${item.name ? `${item.name}'s testimonial` : `testimonial ${index + 1}`} of ${items.length}`}
              />
            ))}
          </div>

          <p
            class="text-foreground-subtle text-xs font-semibold tabular-nums"
            data-testimonial-counter
          >
            {pad(1)} / {pad(items.length)}
          </p>
        </div>

        <p class="text-foreground-subtle mt-3 text-xs">
          Scroll the row, use the arrows, or open a card to watch the full clip with sound.
        </p>

        <p class="sr-only" data-testimonial-status aria-live="polite">
          {`Showing testimonial 1 of ${items.length}${items[0]?.name ? `: ${items[0].name}` : ''}`}
        </p>
      </>
    )}
  </div>

  <p class="text-foreground-subtle mt-8 max-w-[54rem] text-sm">{note}</p>

  {items.map((item, index) =>
    item.video ? (
      <Dialog
        id={dialogIds[index]}
        title={dialogTitle(item, index)}
        size={item.video.orientation === 'portrait' ? 'sm' : 'lg'}
      >
        <div class="relative">
          <video
            class="mx-auto block max-h-[70vh] w-full rounded-md bg-black"
            controls
            playsinline
            preload="none"
            poster={dialogPosters[index]}
            width={item.video.orientation === 'portrait' ? 720 : 1280}
            height={item.video.orientation === 'portrait' ? 1280 : 720}
            data-testimonial-video
          >
            <source src={item.video.src} type="video/mp4" />
            {(item.video.captions ?? []).map((track, trackIndex) => (
              <track
                kind="captions"
                src={track.src}
                srclang={track.lang}
                label={track.label}
                default={trackIndex === 0}
              />
            ))}
            {/*
              The fallback text is inside <video>, so it is only read by a
              browser that cannot play the clip — but it is still text in the
              document, and it used to promise a transcript unconditionally.
              None of these four clips carries one: the entry supplies no
              `transcript` (and the release register that would let the team
              write one is not in the repo), so the page was advertising
              something it could not deliver. Gated on the same field the
              transcript block below is gated on, so the two can never disagree.
            */}
            Your browser cannot play this video.{' '}
            <a href={item.video.src}>Open the clip in a new view</a>
            {item.video.transcript ? ' or read the transcript below.' : '.'}
          </video>

          {/* Player overlay: the same name/context the dialog heading carries, over the frames. */}
          {(item.name || item.context) && (
            <div
              class="pointer-events-none absolute inset-x-4 bottom-14 flex justify-center"
              aria-hidden="true"
            >
              <p class="bg-foreground/80 text-background max-w-full truncate rounded-full px-4 py-1.5 text-sm backdrop-blur-sm">
                {dialogTitle(item, index)}
              </p>
            </div>
          )}
        </div>

        {item.quote && (
          <blockquote class="text-foreground-secondary mt-4 text-sm text-pretty">
            {'“'}
            {item.quote}
            {'”'}
          </blockquote>
        )}

        {item.video.transcript && (
          <details class="border-border mt-5 border-t pt-4">
            <summary class="text-foreground-muted hover:text-foreground cursor-pointer text-sm font-semibold">
              Read the transcript
            </summary>
            <p class="text-foreground-muted mt-3 text-sm whitespace-pre-line">
              {item.video.transcript}
            </p>
          </details>
        )}
      </Dialog>
    ) : null
  )}
</section>

<script>
  import { initTestimonialPlayers } from './testimonial-player';
  import { initTestimonialRails } from './testimonial-rail';

  const mountTestimonials = () => {
    initTestimonialPlayers();
    initTestimonialRails();
  };

  mountTestimonials();
  document.addEventListener('astro:page-load', mountTestimonials);
</script>

<style>
  /* The rail is a native scroll container: hide the scrollbar, keep the snap. */
  .testimonial-rail {
    scrollbar-width: none;
  }

  .testimonial-rail::-webkit-scrollbar {
    display: none;
  }

  .testimonial-rail:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
  }

  /* Active card: its muted preview plays, so the poster dims on the others and
     the badge steps aside once the first frame is on screen. */
  .testimonial-media,
  .testimonial-video,
  .testimonial-badge,
  .testimonial-toggle {
    transition:
      opacity 320ms ease,
      visibility 320ms ease,
      transform var(--site-duration-base) var(--ease-out-expo);
  }

  .testimonial-card[data-testimonial-active='false'] .testimonial-media {
    opacity: 0.86;
  }

  .testimonial-card[data-testimonial-playing='true'] .testimonial-video {
    opacity: 1;
  }

  .testimonial-card[data-testimonial-playing='true'] .testimonial-badge {
    opacity: 0;
  }

  /* The per-card pause control is the WCAG 2.2.2 mechanism for the preview;
     its glyph follows aria-pressed and the active card's sits at full strength. */
  .testimonial-toggle {
    opacity: 0.72;
  }

  .testimonial-card[data-testimonial-active='true'] .testimonial-toggle {
    opacity: 1;
  }

  .testimonial-toggle [data-icon] {
    display: none;
  }

  .testimonial-toggle[aria-pressed='false'] [data-icon='play'],
  .testimonial-toggle[aria-pressed='true'] [data-icon='pause'] {
    display: contents;
  }

  /* WCAG 2.2 target size: the visible bar stays 0.375rem, the button box grows
     through padding, and background-clip keeps the padding invisible. */
  .testimonial-segment {
    height: 1.75rem;
    padding-block: 0.6875rem;
    background-clip: content-box;
  }

  /* `background-color`, not the shorthand — `background` would reset the
     content-box clip back to border-box and fatten the active bar. */
  .testimonial-segment[aria-current='true'] {
    background-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-media,
    .testimonial-video,
    .testimonial-badge,
    .testimonial-toggle {
      transition: none;
    }
  }
</style>
