---
/**
 * ProjectSpotlight
 *
 * Two-column feature: an offset-framed project image beside the copy that links
 * into the project story.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import walkway from '~/assets/images/projects/tranquill-city/walkway.webp';
import { Icon } from 'astro-icon/components';

interface Props {
  image?: ImageMetadata;
  eyebrow: string;
  title: string;
  body: string;
  href: string;
  linkLabel: string;
  /** Illustrative framing for the imagery; overrides the neutral default. */
  alt?: string;
  /**
   * Analytics hook. A project link is a navigation, not a lead, so it reports
   * as a `project_view` engagement and never as a Meta Lead.
   */
  track?: string;
}

const {
  image = walkway,
  eyebrow = 'Our projects',
  title = 'A place shaped for what comes next.',
  body = 'Tranquill City is a premium villa plot development in Rudraram near Patancheru, Hyderabad, planned as a gated community with internal roads, parks, and round-the-clock security.',
  href = '/projects/tranquill-city/',
  linkLabel = 'See the project story',
  alt = 'Illustrative golden-hour view of a landscaped walking path inside the planned layout, with glass-fronted villas, a timber seating deck, benches and planting, and two residents walking in the distance',
  track = 'project_view',
} = Astro.props;
---

<section class="home-project section mx-auto px-6" aria-labelledby="home-project-spotlight-title">
  {/*
   * The image is seated inside a shell like every other plate on the site, and
   * the offset rule behind it is inset rather than bordered. The effect is the
   * same idea as the hero's overlapping panel at a smaller scale: the media and
   * its frame read as one object with depth, not as a picture sitting on a page.
   */}
  <figure class="project-image shell reveal-from-left">
    <div class="shell-core">
      <Picture
        src={image}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[640, 960, 1280, 1536]}
        sizes="(min-width: 72rem) 30rem, (max-width: 58rem) calc(100vw - 3rem), 40vw"
        alt={alt}
        loading="lazy"
      />
    </div>
  </figure>

  <div class="project-copy">
    <p class="eyebrow reveal">{eyebrow}</p>
    <h2 id="home-project-spotlight-title" class="display-md reveal-2">
      {title}
    </h2>
    <p class="project-body reveal-3">{body}</p>
    <a class="cta cta-primary reveal-4 mt-10" href={href} data-track={track}>
      <span class="cta-label">{linkLabel}</span>
      <span class="cta-icon" aria-hidden="true">
        <Icon name="tabler:arrow-up-right" class="link-arrow-icon size-4" />
      </span>
    </a>
  </div>
</section>

<style>
  .home-project {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 9rem);
  }

  .project-image {
    position: relative;
    margin: 0;
  }

  /*
   * The offset rule behind the plate. An inset box-shadow rather than a
   * `border`, so it has no layout box and no doubled corner radius — it reads
   * as a second machined edge peeking out from behind the first.
   */
  .project-image::before {
    position: absolute;
    z-index: -1;
    width: 68%;
    height: 68%;
    right: -1.25rem;
    bottom: -1.25rem;
    border-radius: var(--site-radius-core);
    box-shadow: var(--hairline);
    content: '';
  }

  .project-image :global(picture) {
    display: block;
  }

  .project-image :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1.12;
    min-height: 26rem;
    max-height: 39rem;
    border-radius: var(--site-radius-core);
    object-fit: cover;
  }

  .project-copy h2 {
    max-width: 12ch;
    margin-top: var(--space-6);
  }

  .project-body {
    max-width: 46ch;
    margin-top: var(--space-6);
    color: var(--color-muted);
    font-size: 1.125rem;
    text-wrap: pretty;
  }

  /*
   * The arrow travels diagonally and scales very slightly on hover — the same
   * well physics as every other CTA, so the whole site moves its arrows the
   * same way.
   */
  .project-copy :global(.cta-icon svg),
  .project-copy :global(.link-arrow-icon) {
    transition: transform var(--site-duration-fast) var(--ease-out-quart);
  }

  .project-copy .cta:hover :global(svg) {
    transform: translate(0.125rem, -0.125rem) scale(1.08);
  }

  @media (max-width: 58rem) {
    .home-project {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
    }

    .project-image::before {
      display: none;
    }

    .project-image :global(img) {
      min-height: 18rem;
    }
  }
</style>
