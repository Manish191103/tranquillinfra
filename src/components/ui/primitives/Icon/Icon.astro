---
/**
 * Icon component using Lucide icons (inline SVGs)
 * https://lucide.dev - same icons Vercel uses
 */
import { cn } from '~/lib/cn';

interface Props {
  name: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
  /**
   * Stroke weight. Omit it and each size gets the weight that stays optically
   * even at that scale — a hairline at 24px reads as precise, but the same
   * weight at 12px disappears into an antialiasing smudge.
   */
  strokeWidth?: number;
}

/**
 * Per-size stroke weights. A stroked icon's apparent weight is stroke-width
 * divided by rendered size, so a single constant cannot look right across a
 * 12px inline glyph and a 32px feature mark: 1.25 reads as a hairline at 24px
 * and as a faint smudge at 12px. These hold apparent weight roughly constant
 * while keeping the delicate, precise line quality throughout.
 */
const strokeBySize: Record<NonNullable<Props['size']>, number> = {
  xs: 1.75,
  sm: 1.5,
  md: 1.25,
  lg: 1.25,
  xl: 1.25,
};

const { name, size = 'md', class: className, strokeWidth } = Astro.props;

const sizes = {
  xs: 'w-3 h-3',
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
  xl: 'w-8 h-8',
};

const resolvedStrokeWidth = strokeWidth ?? strokeBySize[size];

