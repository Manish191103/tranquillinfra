---
/**
 * MissionVision
 *
 * The mission and vision statements side by side, the first flagged as the
 * primary statement. Copy arrives from the entry.
 */
interface Card {
  label: string;
  title: string;
  body: string;
  featured?: boolean;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro: string;
  cards: Card[];
}

const { id, eyebrow, title, intro, cards } = Astro.props;
---

<section class="bg-page" aria-labelledby={`${id}-title`}>
  <div class="section mx-auto max-w-6xl px-6">
    <header class="max-w-3xl">
      <p class="eyebrow reveal">{eyebrow}</p>
      <h2 id={`${id}-title`} class="display-md reveal-2 mt-6">
        {title}
      </h2>
      <p class="text-muted reveal-3 mt-6 max-w-[52ch] text-lg text-pretty">{intro}</p>
    </header>

    <div class="stack grid gap-[var(--shell-padding)] md:grid-cols-2">
      {cards.map((card) => (
        /*
         * The featured card is a deeper shell rather than a left accent bar.
         * A 4px border on one edge is the single most template-ish thing a card
         * can do; a wider bezel with a warmer core says "this is the primary
         * statement" without drawing a stripe down the left of it.
         */
        <article class:list={['shell', card.featured && 'shell-featured']}>
          <div class="shell-core h-full p-6 md:p-8">
            <p class="eyebrow">{card.label}</p>
            <h3 class="display-sm text-heading mt-6">{card.title}</h3>
            <p class="text-muted mt-4 text-pretty">{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
