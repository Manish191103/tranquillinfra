---
/**
 * ContactHero
 *
 * Full-viewport opener for the contact page, rendered through the shared
 * ImageHero shell: the illustrative planted walkway — the frame the homepage's
 * project spotlight also runs — fills the viewport,
 * with the page's only H1 and the primary contact actions anchored to the
 * bottom of the frame. Breadcrumbs arrive in the `breadcrumbs` slot so the page
 * keeps owning the trail, and the cue jumps to the details section from the
 * first fold. Still-only: the aerial clip moved to the project hero in the
 * 2026-09-16 swap (docs/hero-swap-plan.md); the shell's `video` capability and
 * ../layout/image-hero-video.ts stay in place for it.
 */
import ImageHero from '~/components/layout/ImageHero.astro';
import type { ImageMetadata } from 'astro';
import Button from '~/components/ui/form/Button/Button.astro';
import Icon from '~/components/ui/primitives/Icon/Icon.astro';

export interface ContactHeroAction {
  label: string;
  href: string;
  icon: string;
  /** `accent` is the filled call action, `whatsapp` the vendor-green message action */
  variant?: 'accent' | 'whatsapp' | 'quiet';
  /** Analytics hook; the tracking layer reads `data-track` when it lands. */
  track?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  note: string;
  hero: {
    image: ImageMetadata;
    alt: string;
    caption: string;
  };
  actions: ContactHeroAction[];
  /** In-page anchor the scroll cue jumps to */
  detailsHref?: string;
}

const {
  eyebrow,
  title,
  intro,
  note,
  hero,
  actions,
  detailsHref = '#contact-details',
} = Astro.props;

const actionVariants = { accent: 'primary', whatsapp: 'whatsapp', quiet: 'ghost' } as const;

const actionClasses: Record<NonNullable<ContactHeroAction['variant']>, string> = {
  accent: 'bg-accent text-accent-foreground hover:bg-accent-hover',
  whatsapp: '',
  quiet: 'border border-on-invert/40 text-on-invert hover:bg-on-invert/10 hover:text-on-invert',
};
---

<ImageHero
  image={hero.image}
  alt={hero.alt}
  caption={hero.caption}
  labelId="contact-hero-title"
  cueHref={detailsHref}
  cueLabel="Skip to contact details"
  widths={[640, 960, 1280, 1672]}
>
  <slot name="breadcrumbs" slot="breadcrumbs" />

  <p class="eyebrow">{eyebrow}</p>
  <h1 id="contact-hero-title" class="display-xl text-on-invert">
    {title}
  </h1>
  <p class="text-on-invert-secondary mt-5 max-w-[36rem] text-lg text-pretty">{intro}</p>
  <p class="text-on-invert mt-4 max-w-[36rem] text-sm text-pretty">{note}</p>

  {actions.length > 0 && (
    <ul class="mt-8 flex flex-wrap items-center gap-3">
      {actions.map((action) => (
        <li>
          <Button
            href={action.href}
            variant={actionVariants[action.variant ?? 'quiet']}
            size="lg"
            data-track={action.track}
            class={actionClasses[action.variant ?? 'quiet']}
          >
            <Icon name={action.icon} size="sm" />
            {action.label}
          </Button>
        </li>
      ))}
    </ul>
  )}
</ImageHero>
