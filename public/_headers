# Security headers for every static-asset response. The Cloudflare asset server
# applies this file to prerendered pages, the 404 page, feeds and images;
# responses the Worker renders (the on-demand API routes) get the same set from
# src/middleware.ts. `/*` is the documented catch-all path
# pattern — `#` is the only comment marker — and its headers are indented.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=(), interest-cohort=(), usb=(), serial=(), hid=(), accelerometer=(), gyroscope=(), magnetometer=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # `connect-src` names every host the browser pipeline talks to: the Formspree
  # AJAX POST, the GA4/gtag collection endpoints (GA4 beacons can land on
  # regional `region1.google-analytics.com`, hence the wildcards), and Meta's
  # pixel relay target. There is deliberately no `script-src`/`style-src`: the
  # inline GA bootstrap and the view-transition runtime are inline, and a
  # hash-pinned policy would break on every rebuild until ClientRouter is
  # dropped. Mirrored by hand in src/middleware.ts.
  Content-Security-Policy: base-uri 'self'; connect-src 'self' https://formspree.io https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com; object-src 'none'; form-action 'self' https://formspree.io; frame-ancestors 'none'

# Caching baseline comes from the Workers asset server itself: every unhashed
# response is served `Cache-Control: public, max-age=0, must-revalidate` with an
# ETag — including HTML, the feeds and any generated OG PNGs, which are all
# rebuilt in place at every deploy — and content-hashed `/_astro/*` is served
# immutable. The rules below only add the exceptions to that baseline.
# `_headers` appends same-named values from matching rules instead of
# overriding, so never restate a header on `/*` that a narrower rule also sets.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

# The brochure PDF (~13 MB, linked from the footer, the announcement bar and the
# enquiry form). A day of caching keeps repeat clicks off the edge without
# pinning a file the team may replace.
/brochure/*
  Cache-Control: public, max-age=86400

# Prerendered pages are rebuilt in place at every deploy, which is why the
# baseline keeps them at max-age=0 — that also forces a revalidation round trip
# on every navigation (field TTFB p75 was 1.3 s, mobile, 2026-09). A one-minute
# TTL lets browsers and the edge reuse a fresh copy inside the accepted staleness
# window, and stale-while-revalidate hides the revalidation afterwards; past the
# minute the ETag revalidation brings a deploy's edits live. Route patterns only
# — every asset class has its own rule above, and the feeds/manifest/OG images
# stay on the baseline because they are rebuilt at every deploy.
/
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=86400
/about-us/
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=86400
/contact-us/
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=86400
/privacy-policy/
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=86400
/blog/*
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=86400
/projects/*
  Cache-Control: public, max-age=60, s-maxage=60, stale-while-revalidate=86400

# The workers.dev hostname and version previews serve the same pages as the
# custom domain. Keep them out of search results so the legacy WordPress site
# and the new one never compete as duplicates.
https://tranquillinfra.tranquillinfradigital.workers.dev/*
  X-Robots-Tag: noindex

# Version and alias previews are '<prefix>-tranquillinfra.<sub>.workers.dev';
# a host placeholder cannot cross the dot, so ':prefix' covers that whole label.
https://:prefix.tranquillinfradigital.workers.dev/*
  X-Robots-Tag: noindex