---
/**
 * PastProjects
 *
 * A flowing banner of the projects the team worked on before Tranquill City
 * (list supplied by the client, 2026-10-27). Deliberately light on words: a
 * short line and the names on badges, moving on the shared Marquee (pause
 * control, reduced-motion stop, hover pause).
 *
 * No logos: the client has not supplied marks for these projects, so each
 * badge carries a neutral emblem rather than an invented one.
 */
import Marquee from '~/components/ui/marketing/Marquee/Marquee.astro';
import Icon from '~/components/ui/primitives/Icon/Icon.astro';

interface Props {
  id?: string;
  surface?: 'paper' | 'invert';
}

const { id = 'past-projects', surface = 'invert' } = Astro.props;

const pastProjects = [
  'E City',
  'Bloom City',
  'Sunrise Green City',
  'Nandan Vanam',
  'SSD Gardens',
  'Emerald City',
  'Sampada Valley',
];

const icons = ['skyscraper', 'plant', 'home', 'trees', 'fence', 'map-pin', 'layout-grid'];
---

<section
  id={id}
  class:list={['pp', surface === 'invert' ? 'pp-invert invert-section' : 'pp-paper']}
  aria-labelledby={`${id}-title`}
>
  <div class="pp-head mx-auto max-w-6xl px-6">
    <p class="eyebrow">Our track record</p>
    <h2 id={`${id}-title`} class="pp-title">
      <span class="pp-count">{pastProjects.length}</span> projects before Tranquill City
    </h2>
  </div>

  <div class="pp-rail">
    <Marquee label="Projects our team has worked on" speedSeconds={38} pauseLabel="Pause projects">
      <ul class="pp-list">
        {
          pastProjects.map((name, i) => (
            <li class="pp-badge">
              <span class="pp-emblem">
                <Icon name={icons[i % icons.length]!} size="md" />
              </span>
              <span class="pp-name">{name}</span>
            </li>
          ))
        }
      </ul>
    </Marquee>
  </div>
</section>

<style>
  .pp {
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .pp-invert {
    background:
      radial-gradient(
        80% 120% at 50% 0%,
        color-mix(in oklch, var(--accent) 16%, transparent),
        transparent 60%
      ),
      var(--surface-invert);
    color: var(--on-invert);
  }

  .pp-paper {
    background: var(--color-background-secondary);
  }

  .pp-head {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
  }

  .pp-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.1;
    text-wrap: balance;
  }

  .pp-count {
    color: var(--accent);
  }

  .pp-rail {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .pp-rail :global([data-marquee]:hover .marquee-track) {
    animation-play-state: paused;
  }

  .pp-list {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 0.5rem 0.75rem;
  }

  .pp-badge {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.6rem 0.85rem 0.85rem;
    border: 1px solid rgb(170 214 160 / 30%);
    border-radius: 999px;
    background: color-mix(in oklch, var(--on-invert) 6%, transparent);
    transition:
      transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1),
      background-color 250ms ease,
      border-color 250ms ease;
  }

  .pp-paper .pp-badge {
    background: var(--color-card);
    border-color: var(--color-border);
  }

  .pp-badge:hover {
    transform: translateY(-4px) scale(1.04);
    border-color: rgb(190 228 180 / 70%);
    background: rgb(150 200 140 / 16%);
  }

  .pp-emblem {
    display: grid;
    width: 2.9rem;
    height: 2.9rem;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 28%);
    border-radius: 999px;
    /* Glass green: a light, translucent green disc with a white icon */
    background: linear-gradient(145deg, rgb(170 214 160 / 45%), rgb(110 170 110 / 22%));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 35%),
      0 4px 14px -6px rgb(0 0 0 / 40%);
    backdrop-filter: blur(6px);
    color: #fff;
  }

  .pp-paper .pp-emblem {
    background: linear-gradient(145deg, #d8ebd0, #b9d7ab);
    color: #1f3d2e;
  }

  .pp-name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    white-space: nowrap;
  }

  .pp :global([data-marquee-toggle]) {
    margin-right: 1.5rem;
  }

  .pp-invert :global([data-marquee-toggle]) {
    color: var(--on-invert-secondary);
  }

  @media (max-width: 42rem) {
    .pp-badge {
      padding: 0.6rem 1.15rem 0.6rem 0.6rem;
    }

    .pp-emblem {
      width: 2.4rem;
      height: 2.4rem;
    }
  }
</style>
