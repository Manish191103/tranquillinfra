---
/**
 * Hero
 *
 * Homepage opener: the aerial render clip of the layout (the same reel the
 * project page opens on) behind the page's H1, the primary actions and a strip
 * of the project's headline figures.
 *
 * Desktop sets the copy over the clip's left half with no scrim, so the plots
 * stay visible across the whole frame; a text shadow holds the white type.
 * A phone shows the clip as its own band and sets the copy below it on the forest surface, so no text sits on
 * the moving image at that width.
 *
 * The still under the clip is the LCP element and the whole hero until the clip
 * plays. Playback is ../layout/image-hero-video.ts (`data-image-hero`): it waits
 * for window `load`, honours reduced motion and data saver, pauses off-screen,
 * and drives the play/pause toggle.
 */
import CityLogo from '~/components/ui/primitives/CityLogo.astro';
import { Picture } from 'astro:assets';
import ApprovalSeals from '~/components/ui/primitives/ApprovalSeals.astro';
import type { ImageMetadata } from 'astro';
import Button from '~/components/ui/form/Button/Button.astro';
import Icon from '~/components/ui/primitives/Icon/Icon.astro';
import { leadingPosterPictureProps } from '~/components/ui/overlay/Carousel/posters';

import type { EnquiryRequestType } from '~/lib/enquiry-cta';

interface HeroAction {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'link';
  /** Analytics hook; the tracking layer reads `data-track` when it lands. */
  track?: string;
  /**
   * Dialog element to open instead of navigating — the `href` stays the no-JS
   * and no-dialog fallback (same contract as `HomeCta`).
   */
  dialog?: string;
  /**
   * What the action is asking for. Defaults to a site visit, because that is
   * the promise the dialog makes; a brochure trigger has to say so.
   */
  requestType?: EnquiryRequestType;
}

export interface HeroFact {
  value: string;
  unit?: string;
  label: string;
}

interface Props {
  /** Still under the clip; also the LCP preload target. */
  poster: ImageMetadata;
  alt: string;
  video: { src: string; mobileSrc?: string };
  /** Small label over the media: says whether the clip is footage or a render. */
  mediaNote: string;
  /**
   * Optional second clip of the same fly-over, rendered as the finished
   * development. Adds an After / Today switch that opens on After; the two
   * clips share one camera move, so the switch cross-fades at the same
   * timestamp. `poster` should then be the after clip's first frame.
   */
  afterVideo?: { src: string; mobileSrc?: string; note: string };
  /** The page's H1. */
  title: string;
  /** Second line of the H1, in the accent colour. */
  titleAccent?: string;
  intro: string;
  eyebrow: string;
  /** Show the RERA and HMDA seals above the H1. */
  seals?: boolean;
  actions: HeroAction[];
  facts: HeroFact[];
}

const { poster, alt, video, mediaNote, afterVideo, title, titleAccent, intro, eyebrow, seals, actions, facts } =
  Astro.props;
---

<section
  class="home-hero bg-background"
  data-image-hero
  data-hero-view={afterVideo ? 'after' : undefined}
  aria-labelledby="home-hero-title"
>
  <div class="hero-stage invert-section">
    <div class="hero-media">
      <Picture {...leadingPosterPictureProps} class="hero-poster" src={poster} alt={alt} priority />
      <video
        class="hero-video"
        data-hero-video
        muted
        playsinline
        loop
        preload="none"
        disablepictureinpicture
        aria-hidden="true"
      >
        {
          video.mobileSrc && (
            <source src={video.mobileSrc} media="(max-width: 42rem)" type="video/mp4" />
          )
        }
        <source src={video.src} type="video/mp4" />
      </video>
      {
        afterVideo && (
          <video
            class="hero-video hero-video-after"
            data-hero-video-after
            muted
            playsinline
            loop
            preload="none"
            disablepictureinpicture
            aria-hidden="true"
          >
            {afterVideo.mobileSrc && (
              <source src={afterVideo.mobileSrc} media="(max-width: 42rem)" type="video/mp4" />
            )}
            <source src={afterVideo.src} type="video/mp4" />
          </video>
        )
      }
      <div class="hero-scrim" aria-hidden="true"></div>

      <div class="hero-media-bar">
        {
          afterVideo && (
            <div class="hero-view-switch" role="group" aria-label="Choose the view">
              <button type="button" data-hero-view="after" aria-pressed="true">
                After<span class="hero-view-long"> development</span>
              </button>
              <button type="button" data-hero-view="today" aria-pressed="false">
                <span class="hero-view-long">Site </span>Today
              </button>
            </div>
          )
        }
        <span
          class="hero-media-note"
          data-hero-media-note
          data-note-today={mediaNote}
          data-note-after={afterVideo?.note}
          aria-live="polite">{afterVideo?.note ?? mediaNote}</span
        >
        <button
          type="button"
          class="hero-round"
          data-hero-video-toggle
          aria-pressed="false"
          aria-label="Play background video"
        >
          <span class="hero-toggle-play">
            <Icon name="play" size="sm" />
          </span>
          <span class="hero-toggle-pause">
            <Icon name="pause" size="sm" />
          </span>
        </button>
      </div>
    </div>

    <div class="hero-content">
      <div class="hero-copy">
        <div class="hero-brand">
          <CityLogo tone="light" height="3.6rem" />
          <p class="hero-eyebrow">{eyebrow}</p>
        </div>
        {seals && <ApprovalSeals class="hero-seals" compact />}
        <h1 id="home-hero-title">
          {title}
          {titleAccent && <span class="hero-title-accent">{titleAccent}</span>}
        </h1>
        <p class="hero-intro">{intro}</p>

        {
          actions.length > 0 && (
            <div class="hero-actions">
              {actions.map((action) => {
                const isTextLink = action.variant === 'link';
                return (
                  <Button
                    href={action.href}
                    variant={isTextLink ? 'ctaOnInvert' : 'ctaPrimary'}
                    data-track={action.track}
                    data-dialog-trigger={action.dialog}
                    data-dialog-request-type={
                      action.dialog ? (action.requestType ?? 'site_visit') : undefined
                    }
                    class="cta"
                  >
                    <span class="cta-label">{action.label}</span>
                    <span class="cta-icon" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M7 17L17 7M7 7h10v10" />
                      </svg>
                    </span>
                  </Button>
                );
              })}
            </div>
          )
        }
      </div>

      <dl class="hero-facts">
        {
          facts.map((fact) => (
            <div class="hero-fact">
              <dt>{fact.label}</dt>
              <dd>
                <span data-count>{fact.value}</span>
                {fact.unit && <span class="hero-fact-unit">{fact.unit}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<script>
  import { initImageHeroVideos } from '../layout/image-hero-video';
  import { initHeroViewSwitch } from './hero-view-switch';
  import { initHeroEndCard } from './hero-end-card';

  initImageHeroVideos();
  initHeroViewSwitch();
  initHeroEndCard();
  document.addEventListener('astro:page-load', initImageHeroVideos);
  document.addEventListener('astro:after-swap', initImageHeroVideos);
  document.addEventListener('astro:page-load', initHeroViewSwitch);
  document.addEventListener('astro:after-swap', initHeroViewSwitch);
  document.addEventListener('astro:page-load', initHeroEndCard);
  document.addEventListener('astro:after-swap', initHeroEndCard);
</script>

<style>
  .home-hero {
    padding: clamp(0.75rem, 1.4vw, 1.25rem);
  }

  .hero-stage {
    --hero-ink: rgb(6 20 13);
    position: relative;
    display: grid;
    overflow: hidden;
    min-height: clamp(34rem, calc(100svh - 10.5rem), 52rem);
    border-radius: var(--radius-shell);
    background: var(--hero-ink);
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media :global(picture),
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hidden until the clip is actually playing: the still under it is the
     poster, and a refused or blocked play() leaves this layer invisible. */
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--site-duration-base) var(--ease-in-out-quint);
  }

  .home-hero[data-video-state='playing'] .hero-video {
    opacity: 1;
  }

  /* The after clip sits over the footage and only shows once it is chosen
     and actually playing, so a slow load keeps the footage on screen. */
  .home-hero .hero-video-after,
  .home-hero[data-video-state='playing'] .hero-video-after {
    opacity: 0;
  }

  .home-hero[data-hero-view='after'][data-after-state] .hero-video-after {
    opacity: 1;
  }

  .hero-view-switch {
    display: flex;
    padding: 0.2rem;
    border-radius: var(--radius-full);
    background: rgb(6 20 13 / 62%);
  }

  .hero-view-switch button {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-full);
    color: var(--on-invert);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--site-duration-base) var(--ease-in-out-quint);
  }

  .hero-view-switch button {
    white-space: nowrap;
  }

  .hero-view-switch button[aria-pressed='true'] {
    background: var(--on-invert);
    color: rgb(6 20 13);
  }

  .hero-view-switch button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /*
   * Bottom-up for the figures strip only: the plots fill the whole frame, so
   * the copy column carries no scrim and holds contrast with a text shadow
   * (.hero-copy) instead.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(6 20 13 / 92%) 0%, rgb(6 20 13 / 0%) 34%);
  }

  .hero-media-bar {
    position: absolute;
    top: clamp(1rem, 2.4vw, 1.75rem);
    right: clamp(1rem, 2.4vw, 1.75rem);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-media-note {
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-full);
    background: rgb(6 20 13 / 62%);
    color: var(--on-invert);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-round {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-invert-strong);
    border-radius: var(--radius-full);
    background: rgb(6 20 13 / 62%);
    color: var(--on-invert);
    transition: background-color var(--site-duration-fast) var(--ease-in-out-quint);
  }

  .hero-round:hover {
    background: rgb(6 20 13 / 85%);
  }

  /* No controller (JavaScript off) means nothing to play: no dead control. */
  .home-hero:not([data-hero-video-init='true']) [data-hero-video-toggle] {
    display: none;
  }

  .hero-toggle-pause,
  .hero-round[aria-pressed='true'] .hero-toggle-play {
    display: none;
  }

  .hero-round[aria-pressed='true'] .hero-toggle-pause {
    display: inline-flex;
  }

  /* The copy layer spans the whole stage above the media, so it lets clicks
     through to the media bar (pause, view switch) everywhere but its own
     children. */
  .hero-content {
    pointer-events: none;
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding: clamp(4rem, 8vh, 6rem) clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero-content > :global(*) {
    pointer-events: auto;
  }

  /* The copy panel is clear while the fly-over plays, with a text shadow
     holding the white type, and turns into a frosted card when the logo end
     card comes up (hero-end-card.ts sets data-end-card). It also stays raised
     whenever the clip is not playing, so the still always has a legible card.
     The negative margin keeps the text on the figures strip's left edge. */
  .hero-copy {
    max-width: calc(38rem + 3rem);
    margin-left: -1.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.5rem;
    background: rgb(6 20 13 / 0%);
    -webkit-backdrop-filter: blur(0) saturate(100%);
    backdrop-filter: blur(0) saturate(100%);
    color: var(--on-invert);
    text-shadow:
      0 1px 2px rgb(6 20 13 / 85%),
      0 2px 18px rgb(6 20 13 / 70%);
    transition:
      background-color 0.8s var(--ease-in-out-quint),
      backdrop-filter 0.8s var(--ease-in-out-quint),
      -webkit-backdrop-filter 0.8s var(--ease-in-out-quint);
  }

  .home-hero[data-end-card] .hero-copy,
  .home-hero:not([data-video-state='playing']) .hero-copy {
    background: rgb(6 20 13 / 52%);
    -webkit-backdrop-filter: blur(8px) saturate(115%);
    backdrop-filter: blur(8px) saturate(115%);
  }

  .hero-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .hero-brand :global(.city-logo) {
    padding-right: 0.9rem;
    border-right: 1px solid rgb(255 255 255 / 22%);
  }

  .hero-eyebrow {
    color: var(--on-invert);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-copy :global(.hero-seals) {
    margin-top: 1.1rem;
  }

  h1 {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.2vw, 3.75rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: 'opsz' 72;
    text-wrap: balance;
  }

  .hero-title-accent {
    display: block;
    color: var(--accent);
  }

  .hero-intro {
    max-width: 32rem;
    margin-top: 1.25rem;
    color: var(--on-invert);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-facts {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: 1px solid var(--border-invert-strong);
  }

  .hero-fact {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem 0 0;
  }

  .hero-fact + .hero-fact {
    padding-left: 1.25rem;
    border-left: 1px solid var(--border-invert);
  }

  .hero-fact dt {
    color: var(--on-invert-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-fact dd {
    color: var(--on-invert);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .hero-fact dd .hero-fact-unit {
    margin-left: 0.3rem;
    color: var(--accent);
    font-family: var(--site-font-sans, inherit);
    font-size: 0.45em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 64rem) {
    .hero-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 1.25rem;
    }

    .hero-fact:nth-child(4) {
      padding-left: 0;
      border-left: 0;
    }
  }

  /*
   * Phone: the clip is its own band above the copy, and the copy sits on the
   * plain forest ink — nothing is read over the moving image at this width.
   */
  @media (max-width: 48rem) {
    .hero-view-long {
      display: none;
    }

    /* Full width on a phone so the switch, the label and the pause button
       fit on one row inside the clip. */
    .hero-media-bar {
      top: 0.75rem;
      right: 0.75rem;
      left: 0.75rem;
      justify-content: space-between;
      gap: 0.4rem;
    }

    .hero-media-note {
      padding: 0.4rem 0.6rem;
      font-size: 0.62rem;
      white-space: nowrap;
    }

    .hero-view-switch button {
      padding: 0.35rem 0.65rem;
    }

    /* The copy sits below the clip on the forest surface here. */
    .hero-copy,
    .home-hero[data-end-card] .hero-copy,
    .home-hero:not([data-video-state='playing']) .hero-copy {
      margin-left: 0;
      padding: 0;
      border-radius: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .home-hero {
      padding: 0.75rem;
    }

    .hero-stage {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .hero-media {
      position: relative;
      inset: auto;
      aspect-ratio: 4 / 3;
    }

    .hero-media :global(img),
    .hero-video {
      object-position: 62% center;
    }

    .hero-scrim {
      background: linear-gradient(0deg, var(--hero-ink) 0%, rgb(6 20 13 / 0%) 30%);
    }

    .hero-content {
      gap: 1.75rem;
      padding: 0.5rem 1.25rem 1.5rem;
    }

    h1 {
      font-size: clamp(2.1rem, 9vw, 2.7rem);
    }

    .hero-actions {
      margin-top: 1.5rem;
    }

    .hero-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-fact,
    .hero-fact + .hero-fact,
    .hero-fact:nth-child(4) {
      padding: 1rem 0 0;
      border-left: 0;
    }

    .hero-fact:nth-child(even) {
      padding-left: 1rem;
      border-left: 1px solid var(--border-invert);
    }

    .hero-fact:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video,
    .hero-copy {
      transition: none;
    }
  }
</style>
