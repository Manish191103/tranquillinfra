---
/**
 * ProjectStory
 *
 * The opening prose beside the renders of the planned layout. Two columns at
 * desktop — the disclosure-heavy body copy on a fixed reading measure, the
 * renders stacked in the second column — and one column below that, where the
 * order is simply copy then pictures.
 *
 * Why the gallery is a stack and not a rail: this entry publishes two images,
 * and a horizontal scroll-snap rail needs a third card before it has any
 * affordance to offer. With two, `w-[58%]` per card plus the gap is 116% of
 * the column, so the rail was permanently scrolled, the second card was sliced
 * by the column edge with the scrollbar hidden, and the grid row was as tall as
 * the prose beside it — which stretched every card into a plate with ~770px of
 * empty tray under a 242px image. A rail is the right pattern for six
 * testimonial clips (see ProjectTestimonials) and the wrong one for two
 * renders; a stack is correct for any count from one up, and only starts to
 * want a rail past about four.
 *
 * The body copy renders through the shared <Prose> rather than a second,
 * component-local set of paragraph rules. Those local rules styled `p` but not
 * `a`, so with the global `a { color: inherit; text-decoration: none }` every
 * one of this section's nine inline links — the reference plan, the plot
 * verification guide, the HMDA explainer, the site visit — read as ordinary
 * body text. <Prose> is what makes a link look like a link, and it is already
 * the wrapper for every other Markdown body on the site.
 *
 * The disclosure note sits with the images it is about. It states that the
 * gallery renders are not photographs of completed construction, which is a
 * claim about these pictures; parked after the section it arrived ~1000px
 * below them, on the far side of the whole prose column.
 *
 * Cards after the first are inset toward the column edge rather than sharing
 * one left edge and one width. Two cards stacked flush reads as a component
 * that ran out of content; the stagger is the only asymmetry in the section
 * and it costs one class.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Prose from '~/components/patterns/Prose.astro';
import SectionHeading from '~/components/patterns/SectionHeading.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  note: string;
  images: Array<{ image: ImageMetadata; alt: string; caption: string }>;
  Content: AstroComponentFactory;
}

const { eyebrow, title, intro, note, images, Content } = Astro.props;

/*
 * The container is capped at 72rem with 1.5rem gutters and split in two, so the
 * gallery column never paints wider than ~524px however wide the viewport gets.
 * Stating that in px rather than in vw stops a 4K screen from pulling the 1280
 * candidate for a 524px slot.
 */
const IMAGE_SIZES = '(min-width: 1024px) 524px, (min-width: 640px) 90vw, 92vw';
---

<section class="section mx-auto max-w-6xl px-6" aria-labelledby="project-story-title">
  <SectionHeading eyebrow={eyebrow} title={title} intro={intro} id="project-story-title" />

  {/*
    `items-start` is load-bearing, not a nicety: without it the row takes the
    prose column's height and the cards below stretch into it, which is where
    the dead tray space came from.

    Equal columns, not 0.8/1.2. The copy is five paragraphs of disclosure prose
    — it is the substance of the section, not a caption for the pictures — and
    at 0.8fr it measured 419px, about 52 characters a line. Half the container
    is ~524px, roughly 65 characters, which is the width this body copy is
    meant to be read at.
  */}
  <div class="mt-10 grid items-start gap-10 lg:mt-14 lg:grid-cols-2 lg:gap-14">
    <Prose class="project-story max-w-[34rem]">
      <Content />
    </Prose>

    <div data-story-gallery class="flex flex-col gap-8 lg:gap-10">
      {images.map((item, index) => (
        <figure
          class:list={['shell lift', index > 0 ? 'reveal-2 lg:ml-auto lg:w-[88%]' : 'reveal']}
        >
          <div class="shell-core overflow-hidden">
            {/*
             * 3:2, not 16:9. Both sources are 16:9, so this crops about a sixth
             * of the width off the sides — which is what brings the stacked
             * column up to roughly the height of the prose beside it. 4:3
             * would balance the columns better still and cost too much: the
             * aerial carries its landmark pins across the top of the frame,
             * and a 4:3 crop of a 16:9 image cuts the outer two.
             */}
            <Picture
              src={item.image}
              alt={item.alt}
              widths={[480, 640, 960, 1280]}
              sizes={IMAGE_SIZES}
              fallbackFormat="webp"
              formats={['avif', 'webp']}
              class="aspect-[3/2] w-full object-cover"
            />
          </div>
          <figcaption class="text-foreground-subtle mt-3 px-1 text-sm text-pretty">
            {item.caption}
          </figcaption>
        </figure>
      ))}

      <p class="text-foreground-subtle reveal-3 max-w-[34rem] text-sm text-pretty">{note}</p>
    </div>
  </div>
</section>
