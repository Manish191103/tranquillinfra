---
/**
 * Homepage
 *
 * Order (2026-10-27): the aerial-reel hero with the headline figures, the
 * full-screen highlights scroll (layout, roads, parks, security, approvals),
 * the pinned location map, the plot explorer with buyer testimonials right
 * after it, land use and features, loans and fit, then the closing CTA. The
 * published position (layout, numbers, approvals) now lives on the project
 * page.
 * All copy lives here or in `src/content/pages/home.md`; the section
 * components stay presentation-only.
 *
 * The hero plays the project reel (`/media/projects/project-hero.mp4`, an
 * illustrative render) over its matching still; the five home-hero renders
 * now carry the highlights scroll instead of a carousel.
 */
import { getEntry } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import Hero from '~/components/home/Hero.astro';
import ScrollBuildStory from '~/components/home/ScrollBuildStory.astro';
import LocationStory from '~/components/home/LocationStory.astro';
import PastProjects from '~/components/home/PastProjects.astro';
import ProjectHighlights from '~/components/projects/ProjectHighlights.astro';
import SitePlanExplorer from '~/components/projects/SitePlanExplorer.astro';
import LoanAndFit, { type FitPoint } from '~/components/home/LoanAndFit.astro';
import ProjectTestimonials from '~/components/projects/ProjectTestimonials.astro';

import { buildPosterPreload } from '~/components/ui/overlay/Carousel/posters';
import type { BuildFrame } from '~/components/home/ScrollBuildStory.astro';
import type { HeroFact } from '~/components/home/Hero.astro';
import projectConfig from '~/config/project.config';
import { landUse } from '~/config/highlights.config';

import heroEntrance from '~/assets/images/projects/tranquill-city/home-hero/entrance.webp';
import heroGreenSpaces from '~/assets/images/projects/tranquill-city/home-hero/green-spaces.webp';
import heroAmenities from '~/assets/images/projects/tranquill-city/home-hero/amenities.webp';
import heroCommunityWalk from '~/assets/images/projects/tranquill-city/home-hero/community-walk.webp';
import belongFrame from '~/assets/images/projects/tranquill-city/build-sequence/05-belong.webp';
import heroPoster from '~/assets/images/projects/tranquill-city/project-hero-poster.webp';

const home = await getEntry('pages', 'home');
if (!home) {
  throw new Error('Missing required pages entry "home".');
}

// The hero heading is frontmatter: the hero panel renders the page's single H1
// and the body section below continues from it, so there is one heading to edit
// and exactly one H1 in the document.
const homeBodyTitle = home.data.heroTitle;
if (!homeBodyTitle) {
  throw new Error('The "home" pages entry needs a level-one heading for the hero.');
}

const heroAlt =
  'Illustrative aerial render of the planned Tranquill City layout at golden hour, its boundary outlined in gold beside the highway interchange, with the city skyline on the horizon';

// The hero still is the page's LCP element; the head preload starts its fetch
// before the parser reaches the hero markup.
const lcpPreload = await buildPosterPreload({
  id: 'home-hero',
  title: '',
  caption: '',
  alt: heroAlt,
  poster: heroPoster,
});

/** The figures strip under the hero copy, read from project.config.ts. */
const heroFacts: HeroFact[] = [
  { value: String(projectConfig.siteArea.acre), unit: 'acres', label: 'Layout area' },
  {
    value: String(projectConfig.availability.total),
    unit: 'plots',
    label: `${projectConfig.availability.saleable} for sale`,
  },
  { value: '150–300', unit: 'sq.yd', label: 'Villa plot sizes' },
  { value: `₹${projectConfig.price.from / 100000}`, unit: 'lakh', label: 'Starting price' },
  { value: "40' & 33'", label: 'CC internal roads' },
];

const { rera, hmda } = projectConfig.approvals;

/**
 * The highlights scroll: one full-screen frame per highlight, the frames
 * cross-fading as the copy scrolls past. Every figure is from the HMDA
 * scrutiny plan or the brochure (highlights.config.ts). Location has its own
 * scroll below (LocationStory), so it is not repeated here, and the labelled
 * aerial frame stays out: its baked-in labels collided with the readout.
 */
const priceFrom = `₹${projectConfig.price.from / 100000} lakh`;
const buildSequence: BuildFrame[] = [
  {
    image: belongFrame,
    imageAlt: 'Illustrative concept image of the layout with homes and planted streets in place',
    label: 'Layout',
    title: '4.8 acres. 82 villa plots.',
    detail: `A ${projectConfig.siteArea.sqM.toLocaleString('en-IN')} sq.m HMDA layout of plots from 150 to 300 sq.yd. ${projectConfig.availability.saleable} plots are for sale; ${projectConfig.availability.mortgageHeld} are held under HMDA Mortgage until the layout conditions are met.`,
    visual: {
      kind: 'plots',
      total: projectConfig.availability.total,
      saleable: projectConfig.availability.saleable,
      stats: [
        { value: `${projectConfig.siteArea.acre} acres`, label: 'Layout' },
        { value: '19,410 sq.m', label: 'Site area' },
        { value: '150–300', label: 'Sq.yd per plot' },
      ],
    },
  },
  {
    image: heroGreenSpaces,
    imageAlt:
      'Illustrative golden-hour view along a planted villa street inside the planned layout, with a tree-lined avenue, low boundary walls and a car parked under a villa carport',
    label: 'Roads',
    title: "40' and 33' CC roads.",
    detail:
      "Cement-concrete internal roads with avenue plantation, underground drainage and water connection points. The site fronts an existing 18 m road on the east and a 40' road on the north.",
    visual: {
      kind: 'roads',
      roads: [
        { label: "40' CC road", feet: 40 },
        { label: "33' CC road", feet: 33 },
      ],
      notes: [
        { icon: 'compass', label: '18 m road on the east' },
        { icon: 'road', label: "40' road on the north" },
        { icon: 'cloud-rain', label: 'Underground drainage' },
        { icon: 'trees', label: 'Avenue plantation' },
      ],
    },
  },
  {
    image: heroAmenities,
    imageAlt:
      "Illustrative view of a planned children's play area inside the layout in daylight, with a multi-play tower and spiral slide, spring riders, a swing frame and a coloured play surface among planting and lawns",
    label: 'Parks',
    title: 'Two parks and a play area.',
    detail:
      "Parks of 1,040.50 and 762.49 sq.yd, a children's play area, a jogging and cycle track with sit-outs, and 588.54 sq.yd reserved for social infrastructure.",
    visual: {
      kind: 'landuse',
      // The plotted share reads as paper on the dark frame, not the brand forest.
      shares: landUse.map(({ label, percent, tone }, i) => ({
        label,
        percent,
        tone: i === 0 ? '#e9e3d3' : tone,
      })),
      stats: [
        { value: '1,040.50', label: 'Park 1, sq.yd' },
        { value: '762.49', label: 'Park 2, sq.yd' },
        { value: '588.54', label: 'Social infra, sq.yd' },
      ],
    },
  },
  {
    image: heroEntrance,
    imageAlt:
      'Illustrative dusk view of the planned Tranquill City entrance arch, with the Tranquill City name and emblem on its stone pillar and a car arriving under the lit canopy',
    label: 'Security',
    title: 'Semi-gated, behind an entrance arch.',
    detail:
      'A compound wall around the layout, an entrance arch at the gate and security round the clock.',
    visual: {
      kind: 'tiles',
      tiles: [
        { icon: 'layers', label: 'Compound wall', note: 'Around the whole layout' },
        { icon: 'building-bank', label: 'Entrance arch', note: 'One gated way in' },
        { icon: 'shield-check', label: '24/7 security', note: 'Round the clock' },
      ],
    },
  },
  {
    image: heroCommunityWalk,
    imageAlt:
      'Illustrative view along a landscaped walkway inside the planned layout, with a timber pergola and benches where residents sit, planting beds with bollard lights, and two residents walking towards the camera',
    label: 'Approvals',
    title: `RERA registered, HMDA approved. From ${priceFrom}.`,
    detail: `RERA ${rera.number} · HMDA ${hmda.number}. Both numbers are printed on the brochure; see the plots on a site visit.`,
    visual: {
      kind: 'approvals',
      price: priceFrom,
      priceNote: 'Starting price per plot',
    },
  },
];

const project = await getEntry('projects', 'tranquill-city');

/**
 * Who the project suits. Each point links to the guide that backs it, which
 * keeps the buyer guides linked from the homepage now that the library
 * section is gone (the footer carries the full guide list).
 */
const fitPoints: FitPoint[] = [
  {
    icon: 'home',
    title: 'Want to build your own villa',
    body: 'Plots from 150 to 300 sq.yd on a planned layout, for an independent home to your own plan.',
    link: {
      href: '/blog/building-permission-plot-telangana/',
      label: 'Building permission on a plot',
    },
  },
  {
    icon: 'certificate',
    title: 'Want approvals you can check',
    body: `RERA ${projectConfig.approvals.rera.number} and HMDA ${projectConfig.approvals.hmda.number}, printed on the brochure and the layout plan.`,
    link: { href: '/blog/hmda-or-dtcp-plot-approval-telangana/', label: 'HMDA or DTCP approval' },
  },
  {
    icon: 'factory',
    title: 'Work in the Patancheru and Sangareddy belt',
    body: 'Off NH-65 near Rudraram, with BHEL, Isnapur, Pashamylaram and IIT Hyderabad around the site.',
    link: {
      href: '/blog/rudraram-patancheru-corridor/',
      label: 'Rudraram and Patancheru corridor guide',
    },
  },
  {
    icon: 'trees',
    title: 'Want open space for family',
    body: "Two parks, a children's play area, a jogging and cycle track, a compound wall and 24/7 security.",
    link: { href: '/blog/verify-plot-hyderabad/', label: 'How to verify a plot before you buy' },
  },
];
---

<PageLayout title={home.data.title} description={home.data.description} lcpPreload={lcpPreload}>
  <Hero
    poster={heroPoster}
    alt={heroAlt}
    video={{
      src: '/media/projects/project-hero.mp4',
      mobileSrc: '/media/projects/project-hero-mobile.mp4',
    }}
    mediaNote="Illustrative aerial render"
    title={homeBodyTitle}
    titleAccent="near Rudraram & Patancheru"
    intro={home.data.heroIntro ?? home.data.description}
    eyebrow="Tranquill City · Hyderabad West"
    seals
    facts={heroFacts}
    actions={[
      {
        label: 'Book a site visit',
        href: '/contact-us/',
        variant: 'primary',
        track: 'site_visit',
        dialog: 'enquiry-dialog',
      },
      {
        label: 'Get the brochure',
        href: '/contact-us/',
        variant: 'link',
        track: 'brochure',
        dialog: 'enquiry-dialog',
        requestType: 'brochure',
      },
    ]}
  />

  <PastProjects />

  <ScrollBuildStory
    sequence={buildSequence}
    eyebrow="Project highlights"
    titleLead="A planned layout,"
    titleAccent="ready for your home."
    caption="Layout · roads · parks · security · approvals"
    sequenceLabel="Project highlights"
    skipLabel="Skip to approvals and price"
  />

  <LocationStory />

  <SitePlanExplorer
    eyebrow="Explore the layout"
    title="Find your plot on the layout plan."
    intro="All 82 plots from the HMDA approved layout. Tap a plot for its size and the roads it fronts, or highlight a size band."
  />

  {
    project?.data.testimonials && project.data.testimonials.items.length > 0 && (
      <ProjectTestimonials
        eyebrow="What our customers say"
        title="Buyers, in their own words."
        intro={project.data.testimonials.intro}
        note={project.data.testimonials.note}
        items={project.data.testimonials.items}
      />
    )
  }

  <ProjectHighlights
    eyebrow="Land use and features"
    title="Layout features and land use."
    intro="The area statement from the HMDA scrutiny plan, and the ten layout features listed in the brochure."
    showFigures={false}
  />

  <LoanAndFit
    eyebrow="Loans and fit"
    title="Bank loan available. Is it right for you?"
    intro="The approvals lenders look for are in place. Here is who Tranquill City suits, with a guide behind each point."
    fit={fitPoints}
  />

</PageLayout>
