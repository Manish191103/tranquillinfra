{
  // Worker name shown in the Cloudflare dashboard. Static assets and the
  // ASSETS binding are generated by @astrojs/cloudflare at build time.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tranquillinfra",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_als"],

  // Single-environment production Worker: nothing here consumes preview URLs
  // (`wrangler versions upload` smoke checks go through `wrangler dev` locally
  // instead), so leave them off rather than exposing reachable draft bundles.
  "preview_urls": false,

  // Workers Logs: the console.error/warn calls in the API routes and the
  // measurement guards are the site's only production telemetry, so the log
  // push has to be on for them to be visible outside a live tail.
  "observability": { "enabled": true },

  // Serve the prerendered `404.html` for unmatched routes. Without this the
  // asset server answers an unknown path with an empty 404 — the branded page
  // built by src/pages/404.astro never reaches a visitor. The adapter generates
  // the `assets` block itself at build time and merges this key into it.
  "assets": { "not_found_handling": "404-page" },

  // Public configuration as code (Cloudflare's source-of-truth model). The
  // Astro adapter loads this block into the build's process env, so anything
  // read through `astro:env` is inlined into the bundles — and the same names
  // are runtime bindings for `astro:env/server` lookups.
  //
  // Sensitive values (the Resend key, the Meta Conversions API token) stay
  // Worker secrets and are never listed here: `wrangler secret put <NAME>`.
  // Their names are deliberately NOT declared under `secrets.required` either —
  // that key is deploy-blocking, and this site's design degrades gracefully
  // instead (a missing mail secret logs a 502, a missing CAPI token leaves the
  // pixel working alone). Local overrides go in `.dev.vars`, which beats this
  // block.
  "vars": {
    // Live lead-pipeline config, read at build time through `import.meta.env`:
    // the Google Ads conversion (src/lib/analytics.ts), the Meta pixel and its
    // accepted-sales CAPI sender (src/lib/meta-conversions.ts) and the
    // Formspree endpoint (src/components/patterns/EnquiryDialog.astro and the
    // other lead surfaces). Each id is optional per tag: with one absent that
    // tag never loads.
    "PUBLIC_GA_MEASUREMENT_ID": "G-SK7K0WHJPK",
    "PUBLIC_GOOGLE_ADS_ID": "AW-18447056516",
    "PUBLIC_GOOGLE_ADS_CONVERSION_LABEL": "as-bCLOjg4cdEIT9ntxE",
    "PUBLIC_META_PIXEL_ID": "1062180862820086",

    // Forms and site
    "PUBLIC_FORMSPREE_FORM_ID": "mdekdyar",
    "PUBLIC_PRIVACY_POLICY_URL": "/privacy-policy/",
    "SITE_URL": "https://www.tranquillinfra.com",

    // Customer mail (public contact details, not credentials). The Resend key
    // and the Meta CAPI token are Worker secrets (`wrangler secret put`), read
    // through the `astro:env` schema in astro.config.ts — never listed here.
    "CONTACT_TO_EMAIL": "tranquillinfradigital@gmail.com",
    "RESEND_FROM_EMAIL": "Tranquill Infra Projects <hello@tranquillinfra.com>",

    // Optional: browser-exposed Maps key (restrict it by HTTP referrer in the
    // Google Cloud console) and search-console verification codes.
    // "PUBLIC_GOOGLE_MAPS_API_KEY": "",
    // "GOOGLE_SITE_VERIFICATION": "",
    // "BING_SITE_VERIFICATION": "",
  },

  // The lead API route (/api/customer-mail) sets
  // `prerender = false`: the build emits a Worker plus dist/server/wrangler.json
  // with an ASSETS binding, and that route gets the security headers from
  // src/middleware.ts (Cloudflare does not apply `_headers` to Worker
  // responses). The `ratelimits` block below is REQUIRED in every environment:
  // wrangler does not inherit it into named environments, and `isRateLimited`
  // throws on the missing binding rather than shipping unthrottled.
  // Five submissions a minute is well above human use and well below anything
  // that could exhaust the Resend send quota or Meta's server events.
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
