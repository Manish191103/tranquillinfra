---
/**
 * LocationMap
 *
 * The location map redrawn from the brochure's location-map page: NH-65 and
 * NH-161, the proposed Regional Ring Road, the Outer Ring Road with Exits 2
 * and 3, every landmark the brochure marks, and the site. Relative positions only, no scale and no distances, and
 * the map says so.
 *
 * Every pin carries a category (`roads`, `work`, `learn`). Set `focus` (or the
 * `data-focus` attribute at runtime, as LocationStory does while it scrolls)
 * and the map lights that category's pins and roads and dims the rest; `all`
 * shows the map plain.
 *
 * Under a pointer each place opens up: the dot grows and turns gold, a ring
 * ripples out from it, the label scales up, and the other pins recede.
 */
import { getImage } from 'astro:assets';
import cityLogo from '~/assets/brand/tranquill-city-logo.png';

interface Props {
  id: string;
  focus?: 'all' | 'site' | 'roads' | 'work' | 'learn';
  class?: string;
}

const { id, focus = 'all', class: className } = Astro.props;

// The Tranquill City emblem on the site tag.
const logo = await getImage({ src: cityLogo, height: 160, format: 'png' });

type Category = 'roads' | 'work' | 'learn' | 'place';
type Kind =
  | 'city'
  | 'school'
  | 'university'
  | 'hospital'
  | 'industry'
  | 'office'
  | 'bank'
  | 'temple'
  | 'food'
  | 'bus'
  | 'exit'
  | 'sports'
  | 'research';

/** 24 × 24 line glyphs, drawn white inside each marker. */
const glyphs: Record<Kind, string> = {
  city: 'M3 21h18M5 21V8l6-3v16M11 21V10l8 3v8M8 10v.01M8 13v.01M8 16v.01M14 15v.01M14 18v.01M17 15v.01M17 18v.01',
  school: 'M22 10 12 5 2 10l10 5 10-5zM6 12v5c3 3 9 3 12 0v-5M22 10v6',
  university: 'M2 10 12 4l10 6zM4 21h16M6 10v8M10 10v8M14 10v8M18 10v8M3 21v-3h18v3',
  hospital: 'M4 4h16v16H4zM12 8v8M8 12h8',
  industry: 'M2 20h20V9l-6 4V9l-6 4V4H4v16zM7 16h2M12 16h2M17 16h2',
  office: 'M3 7h18v13H3zM8 7V4h8v3M3 13h18M11 13v2h2v-2',
  bank: 'M3 21h18M3 10h18M5 6l7-3l7 3M4 10v11m16-11v11M8 14v3m4-3v3m4-3v3',
  temple: 'M12 2l3 5H9zM7 7h10l2 3H5zM6 10v11M18 10v11M4 21h16M10 21v-5h4v5',
  food: 'M7 2v9M4 2v5a3 3 0 0 0 6 0V2M7 11v11M17 2c-2 2-3 5-3 8h3v12',
  bus: 'M5 4h14v13H5zM5 11h14M8 21v-4M16 21v-4M8 14h.01M16 14h.01',
  exit: 'M12 3v18M5 6h12l2 2-2 2H5zM19 13H7l-2 2 2 2h12z',
  sports: 'M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0zM17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3',
  research: 'M5 21c0-9 5-15 15-16-1 10-7 15-15 16zM5 21l8-8',
};

type Pin = {
  x: number;
  y: number;
  /** What the place is, which picks its marker icon */
  kind: Kind;
  /** `|` breaks the label onto a second line */
  label: string;
  cat: Category;
  /** Label side; `below` centres it under the dot */
  side?: 'left' | 'right' | 'below' | 'above';
};

// Dots and labels placed as on the brochure's location-map page (relative,
// not to scale), nudged where a label would otherwise run over a road or
// another label. Long names inside the ring roads break onto two lines.
const pins: Pin[] = [
  { kind: 'city', x: 404, y: 173, label: 'Sadashivpet', side: 'left', cat: 'place' },
  { kind: 'city', x: 494, y: 173, label: 'Nandikandi', cat: 'place' },
  { kind: 'city', x: 494, y: 236, label: 'Peddapur', cat: 'place' },
  { kind: 'school', x: 320, y: 440, label: "Rao's School", side: 'below', cat: 'learn' },
  { kind: 'university', x: 490, y: 490, label: 'IIT Hyderabad', cat: 'learn' },
  { kind: 'industry', x: 270, y: 640, label: 'Ordnance Factory', side: 'left', cat: 'work' },
  { kind: 'city', x: 720, y: 617, label: 'Ismailkhanpet', cat: 'place' },
  { kind: 'food', x: 500, y: 650, label: 'Parivar Dhaba', cat: 'place' },
  { kind: 'temple', x: 500, y: 676, label: 'Ganesh Gadda Temple', cat: 'place' },
  { kind: 'city', x: 96, y: 767, label: 'Shankarpally', side: 'above', cat: 'place' },
  { kind: 'industry', x: 178, y: 792, label: 'Aurobindo Pharma', side: 'below', cat: 'work' },
  { kind: 'university', x: 414, y: 729, label: 'GITAM|University', side: 'left', cat: 'learn' },
  { kind: 'industry', x: 500, y: 744, label: 'Toshiba', cat: 'work' },
  { kind: 'hospital', x: 500, y: 789, label: 'Maheshwara Medical College', cat: 'learn' },
  { kind: 'industry', x: 176, y: 860, label: 'Pashamylaram TSIIC SEZ', side: 'below', cat: 'work' },
  { kind: 'city', x: 370, y: 845, label: 'Isnapur', side: 'left', cat: 'work' },
  { kind: 'hospital', x: 678, y: 890, label: 'Medical Park', cat: 'work' },
  { kind: 'school', x: 150, y: 975, label: 'Gaudium School', side: 'above', cat: 'learn' },
  { kind: 'school', x: 416, y: 1004, label: 'Candidus|School', side: 'left', cat: 'learn' },
  { kind: 'bus', x: 412, y: 1050, label: 'Patancheru|Bus Stand', side: 'left', cat: 'roads' },
  { kind: 'research', x: 412, y: 1098, label: 'ICRISAT', side: 'left', cat: 'work' },
  { kind: 'industry', x: 400, y: 1140, label: 'BHEL', side: 'left', cat: 'work' },
  { kind: 'city', x: 499, y: 1050, label: 'Beeramguda', cat: 'place' },
  { kind: 'city', x: 504, y: 1103, label: 'Lingampally', cat: 'roads' },
  { kind: 'exit', x: 88, y: 1101, label: 'Kollur Exit 2', side: 'below', cat: 'roads' },
  { kind: 'city', x: 565, y: 1182, label: 'Madinaguda', cat: 'roads' },
  { kind: 'city', x: 684, y: 1256, label: 'Miyapur', cat: 'roads' },
  { kind: 'university', x: 325, y: 1196, label: 'ISB', side: 'left', cat: 'learn' },
  { kind: 'sports', x: 468, y: 1212, label: 'Gopi Chand|Academy', side: 'below', cat: 'learn' },
  { kind: 'office', x: 294, y: 1236, label: 'Microsoft Q City', side: 'left', cat: 'work' },
  { kind: 'bank', x: 259, y: 1279, label: 'ICICI', side: 'left', cat: 'work' },
  { kind: 'bank', x: 395, y: 1300, label: 'IDBI', cat: 'work' },
  { kind: 'office', x: 350, y: 1335, label: 'Infosys', cat: 'work' },
];

const kindNames: Record<Kind, string> = {
  city: 'Town',
  school: 'School',
  university: 'University',
  hospital: 'Medical',
  industry: 'Industry',
  office: 'Offices',
  bank: 'Bank',
  temple: 'Temple',
  food: 'Food',
  bus: 'Bus stand',
  exit: 'ORR exit',
  sports: 'Sports',
  research: 'Research',
};

const catNames: Record<Category, string> = {
  roads: 'Getting around',
  work: 'Jobs nearby',
  learn: 'Schools and colleges',
  place: 'Nearby',
};

// The map's summary, shown as the site's popup card (and read out as the
// map's accessible name).
const summary: { glyph: string; text: string }[] = [
  { glyph: 'M5 21 9 3M19 21 15 3M12 5v2M12 11v2M12 17v2', text: 'Off the Mumbai Highway (NH-65)' },
  {
    glyph: 'M5 21 9 3M19 21 15 3M12 5v2M12 11v2M12 17v2',
    text: 'Beside the Nanded Highway (NH-161)',
  },
  { glyph: glyphs.university, text: 'Near IIT Hyderabad' },
  {
    glyph: 'M3 12a9 9 0 0 1 18 0M7 12a5 5 0 0 1 10 0M12 12v8',
    text: 'Between the proposed Regional Ring Road and the Outer Ring Road',
  },
  { glyph: glyphs.exit, text: 'Reached from ORR Exit 3' },
];
const summaryLabel =
  'Location map: Tranquill City off the Mumbai Highway (NH-65) beside the Nanded Highway (NH-161) and IIT Hyderabad, between the proposed Regional Ring Road and the Outer Ring Road at Exit 3';

const labelAt = (pin: Pin) => {
  if (pin.side === 'below') return { x: pin.x, y: pin.y + 36, anchor: 'middle' };
  if (pin.side === 'above') return { x: pin.x, y: pin.y - 22, anchor: 'middle' };
  // Two-line labels beside a dot are centred on it.
  const lift = (pin.label.split('|').length - 1) * 11;
  if (pin.side === 'left') return { x: pin.x - 22, y: pin.y + 6 - lift, anchor: 'end' };
  return { x: pin.x + 22, y: pin.y + 6 - lift, anchor: 'start' };
};

// The highway and the two ring roads, shared by the road and its glow.
const highway = 'M452 140 L452 1130';
const rrr = 'M207 540 A245 245 0 0 1 697 540';
const orr = 'M190 1140 A262 225 0 0 1 714 1140';
---

<div class="lm" data-lm>
  <svg
    viewBox="0 120 940 1240"
    class:list={['location-map h-auto w-full', className]}
    data-location-map
    data-focus={focus}
    role="img"
    aria-label={summaryLabel}
  >
    <rect x="0" y="120" width="940" height="1240" class="map-bg" rx="24"></rect>

    {/* Regional Ring Road */}
    <path id={`${id}-rrr`} d={rrr} class="road road-ring"></path>
    <path d={rrr} class="road-dash"></path>
    <path d={rrr} class="road-glow"></path>
    <text class="road-label"
      ><textPath href={`#${id}-rrr`} startOffset="20%" text-anchor="middle"
        >REGIONAL RING ROAD</textPath
      ></text
    >
    <text class="road-label"
      ><textPath href={`#${id}-rrr`} startOffset="80%" text-anchor="middle"
        >REGIONAL RING ROAD</textPath
      ></text
    >

    {/* Outer Ring Road, with the Kollur Exit 2 crossing */}
    <path id={`${id}-orr`} d={orr} class="road road-ring"></path>
    <path d={orr} class="road-dash"></path>
    <path d={orr} class="road-glow"></path>
    <text class="road-label"
      ><textPath href={`#${id}-orr`} startOffset="31%" text-anchor="middle"
        >OUTER RING ROAD</textPath
      ></text
    >
    <text class="road-label"
      ><textPath href={`#${id}-orr`} startOffset="76%" text-anchor="middle"
        >OUTER RING ROAD</textPath
      ></text
    >
    <path d="M95 1025 L315 1135" class="road road-side"></path>

    {/* Local roads off the highway */}
    <path d="M452 532 L745 532" class="road road-local"></path>
    <text x="600" y="539" class="road-label road-label-sm" text-anchor="middle">NANDED HIGHWAY</text
    >
    <path d="M452 615 L710 615" class="road road-local"></path>
    <path d="M452 707 L710 707" class="road road-local"></path>
    <path d="M452 645 L205 742" class="road road-local"></path>
    <path d="M430 835 L290 768" class="road road-local"></path>

    {/* Mumbai Highway and the city-side branches */}
    <path d="M452 1130 L290 1340" class="road road-main"></path>
    <path d="M452 1130 L650 1295" class="road road-main"></path>
    <path d={highway} class="road road-main"></path>
    <path d={highway} class="road-dash"></path>
    <path d={highway} class="road-glow"></path>
    <text x="455" y="710" class="road-label" text-anchor="middle" transform="rotate(-90 455 710)"
      >MUMBAI HIGHWAY · NH-65</text
    >
    <text x="410" y="420" class="small-label" text-anchor="middle" transform="rotate(-90 410 420)"
      >SANGAREDDY</text
    >

    {/* Junctions */}
    <circle cx="452" cy="295" r="46" class="junction"></circle>
    <circle cx="452" cy="522" r="24" class="junction"></circle>
    <text x="452" y="518" class="junction-label junction-label-sm" text-anchor="middle">NH</text>
    <text x="452" y="534" class="junction-label junction-label-sm" text-anchor="middle">161</text>
    <circle cx="452" cy="918" r="36" class="junction"></circle>
    <text x="452" y="912" class="junction-label" text-anchor="middle">Exit</text>
    <text x="452" y="934" class="junction-label" text-anchor="middle">No 3</text>
    <circle cx="202" cy="1083" r="34" class="junction"></circle>
    <circle cx="452" cy="1130" r="36" class="junction"></circle>

    {
      pins.map((pin) => {
        const label = labelAt(pin);
        return (
          <g
            class="pin-g"
            data-cat={pin.cat}
            data-name={pin.label.replace('|', ' ')}
            data-kind={kindNames[pin.kind]}
            data-group={catNames[pin.cat]}
            data-glyph={glyphs[pin.kind]}
          >
            {/* Invisible hit area, so the hover catches the label as well as the dot */}
            <circle cx={pin.x} cy={pin.y} r="26" class="pin-hit" fill="transparent" />
            <circle cx={pin.x} cy={pin.y} r="13" class="pin-ring" fill="none" />
            <g class="pin-mark">
              <circle cx={pin.x} cy={pin.y} r="13" class="pin" />
              <svg
                x={pin.x - 8}
                y={pin.y - 8}
                width="16"
                height="16"
                viewBox="0 0 24 24"
                class="pin-glyph"
              >
                <path
                  d={glyphs[pin.kind]}
                  fill="none"
                  stroke="#fff"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </g>
            <text x={label.x} y={label.y} text-anchor={label.anchor} class="pin-label">
              {pin.label.split('|').map((line, i) => (
                <tspan x={label.x} dy={i === 0 ? 0 : 22}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        );
      })
    }

    {/* The site */}
    <g class="site" data-lm-site>
      <rect x="500" y="546" width="262" height="50" rx="12" class="site-halo"></rect>
      <rect x="500" y="546" width="262" height="50" rx="12" class="site-tag"></rect>
      {/* Emblem only: the artwork's top 64%, cropped by the nested viewport */}
      <svg x="506" y="549" width="62" height="44" viewBox="0 0 283 200">
        <image href={logo.src} width="283" height="313" class="site-logo" />
      </svg>
      <text x="666" y="579" text-anchor="middle" class="site-text">TRANQUILL CITY</text>
    </g>
    <text x="30" y="1345" class="note">Schematic · not to scale</text>
  </svg>

  {/* Popup card: the site summary, or the place under the pointer / finger */}
  <div class="lm-pop" data-lm-pop aria-hidden="true">
    <div class="lm-card" data-lm-card="site">
      <p class="lm-head">
        <span class="lm-badge lm-badge-site"><img src={logo.src} alt="" /></span>
        <span>
          <strong>Tranquill City</strong>
          <small>Mamidipally, near Rudraram</small>
        </span>
      </p>
      <ul class="lm-list">
        {
          summary.map((row) => (
            <li>
              <svg viewBox="0 0 24 24" class="lm-ico">
                <path d={row.glyph} />
              </svg>
              {row.text}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="lm-card" data-lm-card="pin" hidden>
      <p class="lm-head">
        <span class="lm-badge">
          <svg viewBox="0 0 24 24" class="lm-ico lm-ico-white"><path data-lm-glyph d=""></path></svg
          >
        </span>
        <span>
          <strong data-lm-name></strong>
          <small data-lm-kind></small>
        </span>
      </p>
      <p class="lm-group" data-lm-group></p>
    </div>
  </div>
</div>

<script>
  const init = (root: HTMLElement) => {
    const svg = root.querySelector<SVGSVGElement>('[data-location-map]');
    const pop = root.querySelector<HTMLElement>('[data-lm-pop]');
    const site = root.querySelector<SVGGElement>('[data-lm-site]');
    const siteCard = root.querySelector<HTMLElement>('[data-lm-card="site"]');
    const pinCard = root.querySelector<HTMLElement>('[data-lm-card="pin"]');
    if (!svg || !pop || !site || !siteCard || !pinCard) return;
    const pins = [...root.querySelectorAll<SVGGElement>('.pin-g')];
    let current: Element | null = null;

    // Above the target, or below it when there is no room; kept inside the map.
    const place = (target: Element) => {
      const box = root.getBoundingClientRect();
      const r = target.getBoundingClientRect();
      const gap = 10;
      const w = pop.offsetWidth;
      const h = pop.offsetHeight;
      const cx = r.left - box.left + r.width / 2;
      const left = Math.min(Math.max(cx - w / 2, 8), Math.max(8, box.width - w - 8));
      let top = r.top - box.top - h - gap;
      const below = top < 8;
      if (below) top = r.bottom - box.top + gap;
      pop.style.left = `${left}px`;
      pop.style.top = `${Math.min(top, Math.max(8, box.height - h - 8))}px`;
      pop.dataset.side = below ? 'below' : 'above';
      pop.style.setProperty('--arrow', `${Math.min(Math.max(cx - left, 16), w - 16)}px`);
    };

    const show = (target: Element) => {
      current = target;
      const isPin = target !== site;
      siteCard.hidden = isPin;
      pinCard.hidden = !isPin;
      if (isPin) {
        const d = (target as SVGGElement).dataset;
        pinCard.querySelector('[data-lm-glyph]')?.setAttribute('d', d.glyph ?? '');
        pinCard.querySelector('[data-lm-name]')!.textContent = d.name ?? '';
        pinCard.querySelector('[data-lm-kind]')!.textContent = d.kind ?? '';
        pinCard.querySelector('[data-lm-group]')!.textContent = d.group ?? '';
      }
      pop.classList.add('is-open');
      place(target);
    };

    const hide = () => {
      current = null;
      pop.classList.remove('is-open');
    };

    for (const el of [site, ...pins]) {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse') show(el);
      });
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse' && current === el) hide();
      });
      el.addEventListener('click', (e) => {
        e.stopPropagation();
        if (current === el && !matchMedia('(hover: hover)').matches) hide();
        else show(el);
      });
    }
    document.addEventListener('click', (e) => {
      if (current && !root.contains(e.target as Node)) hide();
    });
    window.addEventListener('resize', () => current && place(current), { passive: true });

    // Open the site summary once, when the map first comes into view.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          window.setTimeout(() => !current && show(site), 700);
        }
      },
      { threshold: 0.35 }
    );
    io.observe(svg);
  };

  document.querySelectorAll<HTMLElement>('[data-lm]').forEach(init);
</script>

<style>
  .lm {
    position: relative;
  }

  .lm-pop {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: min(18rem, calc(100% - 16px));
    padding: 0.85rem 0.95rem;
    border: 1px solid rgb(31 61 46 / 14%);
    border-radius: 14px;
    background: #fffdf7;
    box-shadow: 0 14px 34px -12px rgb(20 30 25 / 35%);
    color: #1f2a24;
    font-family: var(--site-font-sans);
    font-size: 0.8125rem;
    line-height: 1.35;
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px) scale(0.97);
    transition:
      opacity 200ms ease,
      transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .lm-pop.is-open {
    opacity: 1;
    transform: none;
  }

  .lm-pop::after {
    content: '';
    position: absolute;
    left: calc(var(--arrow, 50%) - 7px);
    bottom: -7px;
    width: 14px;
    height: 14px;
    border: inherit;
    border-width: 0 1px 1px 0;
    background: inherit;
    transform: rotate(45deg);
  }

  .lm-pop[data-side='below']::after {
    top: -7px;
    bottom: auto;
    border-width: 1px 0 0 1px;
  }

  .lm-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .lm-head strong {
    display: block;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }

  .lm-head small {
    display: block;
    color: #6b6458;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .lm-badge {
    display: grid;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 999px;
    background: #2f8a3b;
  }

  .lm-badge-site {
    background: #b0157e;
  }

  .lm-badge-site img {
    width: 1.6rem;
    height: 1.6rem;
    object-fit: cover;
    object-position: top;
    filter: brightness(0) invert(1);
  }

  .lm-ico {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: #2f8a3b;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lm-ico-white {
    stroke: #fff;
  }

  .lm-list {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.75rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgb(31 61 46 / 10%);
  }

  .lm-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-weight: 600;
  }

  .lm-group {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: #e7f0e2;
    color: #1f3d2e;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .site {
    cursor: pointer;
  }

  .location-map {
    font-family: var(--site-font-sans);
  }

  .map-bg {
    fill: #f4efe2;
  }

  .road {
    fill: none;
    stroke: #2b2b2b;
  }

  .road-ring {
    stroke-width: 54;
  }

  .road-main {
    stroke-width: 52;
  }

  .road-side {
    stroke-width: 40;
  }

  .road-local {
    stroke-width: 26;
  }

  .road-dash {
    fill: none;
    stroke: #f4efe2;
    stroke-width: 2;
    stroke-dasharray: 10 10;
    opacity: 0.7;
  }

  /* A gold centre line drawn over the main roads while they are in focus. */
  .road-glow {
