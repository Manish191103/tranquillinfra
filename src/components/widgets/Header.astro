---
/**
 * Site header: the sticky site chrome ported from the predecessor repo.
 *
 * Row: logo — desktop nav (`.nav-link` pills, active from the current path) —
 * quick-contact actions (phone, WhatsApp; hidden below `nav:` because the fixed
 * mobile contact bar carries those there) — the primary "Book a site visit"
 * CTA — and the hamburger that opens the full-screen forest panel below
 * `nav:`.
 *
 * The CTA target is computed at render time (`enquiryCtaTarget`): pages that
 * render the enquiry dialog get a dialog trigger, the project and contact pages
 * get an anchor to the on-page form instead.
 *
 * Structure note: `#header.scroll > div:first-child` in the design-system CSS
 * paints the scrolled backdrop, so the padded bar must be the header's first
 * element child.
 *
 * `actions` compatibility: the layout may still pass the navigation `actions`
 * array. The phone/WhatsApp actions come from `~/contact` here (they are the
 * same on every page), and the primary CTA is built in — so a passed action
 * whose text is the site-visit label is skipped rather than rendered twice.
 * Any other action renders as an outline CTA in front of the primary one.
 */
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import { contact } from '~/contact';
import {
  enquiryCtaTarget,
  SITE_VISIT_CTA_LABEL,
  PHONE_CTA_LABEL,
  WHATSAPP_CTA_LABEL,
} from '~/lib/enquiry-cta';
import { getHomePermalink, trimSlash } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  /** Accepted for layout compatibility; see the "actions compatibility" note. */
  actions?: Array<CallToAction>;
  /** Sticky at the top of the viewport, below the scrolling announcement bar. */
  isSticky?: boolean;
  /**
   * Accepted for layout compatibility with the stock AstroWind invocation and
   * deliberately unused: the site is light-only (no theme toggle), there is no
   * RSS feed in the header, and the chrome renders one way.
   */
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  /** Mobile panel intro block (kicker + display note). */
  menuIntro?: { kicker: string; note: string };
  /** Mobile panel contact row, rendered above the CTA plate. */
  menuContact?: { label: string; value: string; href: string; track?: string };
  /** Show active state for the current page (default: true). */
  showActiveState?: boolean;
}

const {
  id = 'header',
  links = [],
  actions = [],
  isSticky = true,
  menuIntro = { kicker: 'Tranquill Infra', note: 'Thoughtful places, built for living.' },
  menuContact = {
    label: PHONE_CTA_LABEL,
    value: contact.phone,
    href: `tel:${contact.phoneE164}`,
    track: 'phone',
  },
  showActiveState = true,
} = Astro.props;

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

// Compare paths without trailing slashes (so the active link survives the
// `trailingSlash` setting), then also light up a section link while the
// visitor is on any page inside it (`/projects/tranquill-city` on its own
// subpages), mirroring the predecessor header.
const normalized = (href?: string) =>
  typeof href === 'string' && href ? `/${trimSlash(href)}` : null;

const isActive = (href?: string) => {
  if (!showActiveState) return false;
  const path = normalized(href);
  if (!path) return false;
  return currentPath === path || currentPath.startsWith(`${path}/`);
};

// Page-aware "Book a site visit" target: the dialog on pages that carry it,
// the on-page enquiry form on the pages that render one instead.
const enquiryCta = enquiryCtaTarget(Astro.url.pathname);

// Passed-in actions minus the built-in primary CTA, if the caller still ships it.
const extraActions = actions.filter((action) => action.text !== SITE_VISIT_CTA_LABEL);

// Unique ids wire the hamburger to its panel (`aria-controls`) and let
// mobile-menu.ts find the pair without extra DOM queries.
const menuId = `mobile-menu-${Math.random().toString(36).slice(2, 9)}`;
const buttonId = `${menuId}-button`;
---

<header
  id={id}
  class:list={[
    'w-full',
    isSticky ? 'sticky top-0 z-40' : 'relative z-40',
  ]}
  data-menu-id={menuId}
  data-button-id={buttonId}
>
  <div
    class:list={[
      'mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-6 sm:gap-6',
      'border-b border-transparent',
    ]}
  >
    <a class="flex min-w-0 items-center" href={getHomePermalink()}>
      <Logo variant="light" width={132} />
    </a>

    <!-- Desktop navigation, at `nav:` (60rem) and up. -->
    <nav class="hidden items-center gap-1 nav:flex" aria-label="Main navigation">
      {
        links.map(({ text, href, ariaLabel }) => (
          <a
            href={href}
            aria-label={ariaLabel}
            class:list={[
              'nav-link relative rounded-full px-3 py-2 text-sm',
              // Colour and weight only. `transition-all` was making the nav
              // link animate its own layout box on every hover, which shows
              // up as a faint reflow flicker in the header.
              'transition-[color,opacity] duration-fast ease-quart',
              isActive(href) ? 'nav-link-active font-semibold' : 'font-medium',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {text}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <!-- Quick contact: icon-only, desktop only — the mobile contact bar
           carries call/WhatsApp below `nav:`. -->
      <div class="hidden items-center gap-1 nav:flex" role="group" aria-label="Quick contact">
        <a
          href={`tel:${contact.phoneE164}`}
          data-track="phone"
          aria-label={PHONE_CTA_LABEL}
          class="text-muted hover:bg-secondary hover:text-heading inline-flex size-10 items-center justify-center rounded-full transition-colors duration-fast ease-quart"
        >
          <Icon name="tabler:phone" class="size-5" />
        </a>
        <a
          href={contact.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
          aria-label={WHATSAPP_CTA_LABEL}
          class="bg-whatsapp text-white hover:bg-whatsapp-hover inline-flex size-10 items-center justify-center rounded-full transition-colors duration-fast ease-quart"
        >
          <Icon name="tabler:brand-whatsapp" class="size-5" />
        </a>
      </div>

      {
        extraActions.map((action) => (
          <a
            href={action.href}
            aria-label={action['aria-label'] ?? action.text}
            class="cta cta-outline whitespace-nowrap text-sm"
          >
            <span class="cta-label">{action.text}</span>
          </a>
        ))
      }

      <!-- Primary CTA. The dialog attributes carry the conversion contract:
           where the page renders the enquiry dialog this opens it pre-set to a
           site visit; elsewhere the href scrolls to the on-page form. -->
      <a
        href={enquiryCta.href}
        class="cta cta-primary whitespace-nowrap text-sm"
        data-track="site_visit"
        data-dialog-trigger={enquiryCta.dialog}
        data-dialog-request-type="site_visit"
      >
        <span class="cta-label">{SITE_VISIT_CTA_LABEL}</span>
        <span class="cta-icon">
          <Icon name="tabler:arrow-up-right" />
        </span>
      </a>

      <!-- Mobile menu toggle. A 44px target (size-11) on a phone. -->
      <button
        type="button"
        id={buttonId}
        class:list={[
          'text-muted hover:bg-secondary hover:text-heading',
          'inline-flex size-11 items-center justify-center rounded-md transition-colors nav:hidden',
        ]}
        aria-expanded="false"
        aria-controls={menuId}
        aria-label="Open navigation menu"
      >
        <span class="menu-icon">
          <Icon name="tabler:menu-2" class="size-6" />
        </span>
        <span class="close-icon hidden">
          <Icon name="tabler:x" class="size-6" />
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile menu — compact navigation only, anchored below the sticky header
       (geometry published as `--mobile-nav-top` by mobile-menu.ts). -->
  <nav
    id={menuId}
    class:list={['mobile-panel invert-section']}
    data-mobile-menu-panel
    data-open="false"
    aria-label="Mobile navigation"
    aria-hidden="true"
    inert
  >
    <div class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-[clamp(1.25rem,4vh,2.5rem)]">
      <div class="max-w-[22rem]">
        <p class="text-accent-ink mb-2.5 text-xs font-extrabold tracking-[0.18em] uppercase">
          {menuIntro.kicker}
        </p>
        <p class="display-lg text-on-invert-secondary">{menuIntro.note}</p>
      </div>

      <div class="border-border-invert grid border-t">
        {
          links.map(({ text, href, ariaLabel }) => (
            <a href={href} aria-label={ariaLabel} class="mobile-panel-link" aria-current={isActive(href) ? 'page' : undefined}>
              {text}
              <Icon name="tabler:arrow-up-right" class="text-accent-ink size-6 shrink-0" />
            </a>
          ))
        }
      </div>

      <div class="mt-auto grid gap-4">
        {
          menuContact && (
            <a
              href={menuContact.href}
              data-track={menuContact.track}
              class="text-on-invert-secondary hover:text-on-invert flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 text-xs"
            >
              <span>{menuContact.label}</span>
              <span class="text-on-invert font-bold">{menuContact.value}</span>
            </a>
          )
        }

        <a
          href={enquiryCta.href}
          data-track="site_visit"
          data-dialog-request-type="site_visit"
          data-dialog-trigger={enquiryCta.dialog}
          class="bg-accent text-accent-foreground hover:bg-accent-hover flex min-h-14 items-center justify-between gap-4 rounded-sm px-4 text-sm font-extrabold transition hover:-translate-y-0.5"
        >
          {SITE_VISIT_CTA_LABEL}
          <Icon name="tabler:arrow-up-right" class="size-4 shrink-0" />
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  import { initMobileMenu, resetMobileMenu } from './mobile-menu';

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
  document.addEventListener('astro:after-swap', initMobileMenu);
  // Close (and unlock) before the swap so the lock and `inert` never outlive
  // the page that opened the menu.
  document.addEventListener('astro:before-swap', resetMobileMenu);
</script>

<script>
  // Scroll-reactive chrome: past 60px the design-system CSS paints the
  // `#header.scroll` backdrop (blur on desktop, solid page colour on phones).
  const SCROLL_THRESHOLD = 60;

  function initScrollWatcher() {
    const el = document.getElementById('header');
    if (!el || el.dataset.scrollInit) return;
    const header = el;
    header.dataset.scrollInit = 'true';

    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;

      requestAnimationFrame(() => {
        const menu = document.getElementById(header.dataset.menuId || '');
        if (window.scrollY > SCROLL_THRESHOLD) {
          header.classList.add('scroll');
        } else {
          // Don't remove while the mobile menu is open — the forest panel
          // relies on the solid header backdrop above it.
          if (menu?.dataset.open !== 'true') {
            header.classList.remove('scroll');
          }
        }
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Set initial state (a navigation can land mid-page).
    onScroll();
  }

  initScrollWatcher();
  document.addEventListener('astro:page-load', initScrollWatcher);
  document.addEventListener('astro:after-swap', initScrollWatcher);
</script>

<style>
  /* Mobile panel — compact navigation only. Geometry anchors it below the
     sticky header; `--mobile-nav-top` is published by mobile-menu.ts. The
     `invert-section` class on the panel remaps the colour tokens to their
     on-forest counterparts (accent-ink, on-invert-secondary, …). */
  .mobile-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--mobile-nav-top, 4rem));
    height: calc(100dvh - var(--mobile-nav-top, 4rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-surface-invert);
    color: var(--color-on-invert);
    box-shadow: var(--site-shadow-xl);
    padding: clamp(1.4rem, 5vw, 2.5rem) 1.5rem max(1.25rem, env(safe-area-inset-bottom));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-0.75rem);
    transition:
      opacity 180ms ease,
      transform 220ms ease,
      visibility 0s linear 220ms;
  }

  .mobile-panel[data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .mobile-panel-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: clamp(3.7rem, 10vw, 4.75rem);
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border-invert);
    color: var(--color-on-invert);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 6vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    transition:
      color 180ms ease,
      padding-left var(--site-duration-fast) var(--ease-out-quart);
  }

  .mobile-panel-link:hover,
  .mobile-panel-link:focus-visible,
  .mobile-panel-link[aria-current='page'] {
    color: var(--aw-color-accent);
    padding-left: 0.5rem;
  }

  /* The desktop header takes over at the navigation breakpoint. */
  @media (min-width: 60rem) {
    .mobile-panel {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-panel {
      transition: none;
    }
  }
</style>
